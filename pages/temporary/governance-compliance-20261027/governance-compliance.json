{
  "schemaVersion": "6.59",
  "id": "governance-compliance",
  "layout": "dashboard",
  "dashboardToolbar": {
    "variant": "compact"
  },
  "meta": {
    "title": "行权效率",
    "description": "地区部与代表处行权效率情况明细及趋势图。展示商务/合同决策意见有效占比、紧急决策比例与申请规范率，含决策意见有效性、紧急决策比例、申请规范率三张柱线混合图。内嵌初始行为合成演示数据（占位值），不来自真实系统，不得用于业务判断。"
  },
  "filters": [
    {
      "id": "key-rep-only",
      "type": "boolean",
      "label": "仅看重点国代",
      "default": false
    },
    {
      "id": "mtime",
      "type": "timeRange",
      "display": "period",
      "precision": "month",
      "label": "数据期间",
      "required": true,
      "default": {
        "mode": "month"
      }
    },
    {
      "id": "region",
      "type": "dimension",
      "dimension": "geo-pc-code",
      "label": "区域",
      "emptyLabel": "全部区域",
      "selection": { "mode": "single" },
      "hierarchy": [
        { "id": "geo", "dimension": "geo-pc-code", "label": "全球" },
        { "id": "region-dept", "dimension": "region-dept-code", "label": "地区部" },
        { "id": "office", "dimension": "rep-office-code", "label": "代表处" }
      ],
      "defaultLevel": "geo"
    },
    {
      "id": "sdt-duration-site",
      "type": "dimension",
      "dimension": "data-site-type",
      "label": "SDT决策时长站点",
      "default": ["国内"]
    },
    {
      "id": "sdt-count-site",
      "type": "dimension",
      "dimension": "data-site-type",
      "label": "SDT决策人数站点",
      "default": ["国内"]
    },
    {
      "id": "biz-decision-site",
      "type": "dimension",
      "dimension": "data-site-type",
      "label": "商务决策站点",
      "default": ["国内"]
    },
    {
      "id": "contract-decision-site",
      "type": "dimension",
      "dimension": "data-site-type",
      "label": "合同决策站点",
      "default": ["国内"]
    }
  ],
