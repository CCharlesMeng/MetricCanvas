{
  "schemaVersion": "6.113",
  "id": "governance-compliance",
  "layout": "dashboard",
  "meta": {
    "title": "行权效率",
    "description": "地区部与代表处行权效率情况明细及趋势图。展示商务/合同决策意见有效占比、紧急决策比例与申请规范率，含决策意见有效性、紧急决策比例、申请规范率三张柱线混合图。内嵌初始行为合成演示数据（占位值），不来自真实系统，不得用于业务判断。"
  },
  "filters": [
    {
      "id": "key-rep-only",
      "type": "boolean",
      "label": "仅看重点国代",
      "default": false
    },
    {
      "id": "mtime",
      "type": "timeRange",
      "display": "period",
      "precision": "month",
      "label": "数据期间",
      "required": true,
      "default": {
        "mode": "month"
      }
    },
    {
      "id": "region",
      "type": "dimension",
      "dimension": "geo-pc-code",
      "label": "区域",
      "emptyLabel": "区域",
      "selection": {
        "mode": "single",
        "required": false
      },
      "hierarchy": [
        { "id": "geo", "dimension": "geo-pc-code", "label": "全球" },
        { "id": "region-dept", "dimension": "region-dept-code", "label": "地区部" },
        { "id": "office", "dimension": "rep-office-code", "label": "代表处" }
      ],
      "defaultLevel": "geo",
      "display": "tree",
      "treeSelection": "level",
      "searchable": true
    },
    {
      "id": "customer-category",
      "type": "dimension",
      "dimension": "customerCategory",
      "label": "客户分类",
      "display": "select",
      "emptyLabel": "客户分类",
      "selection": {
        "mode": "multiple",
        "allBehavior": "values"
      },
      "searchable": true,
      "options": [
        { "label": "卓越NA", "value": "卓越NA" },
        { "label": "战略NA", "value": "战略NA" },
        { "label": "核心NA", "value": "核心NA" }
      ]
    },
    {
      "id": "sdt-duration-site",
      "type": "dimension",
      "dimension": "data-site-type",
      "label": "SDT决策时长站点",
      "default": ["国内"]
    },
    {
      "id": "sdt-count-site",
      "type": "dimension",
      "dimension": "data-site-type",
      "label": "SDT决策人数站点",
      "default": ["国内"]
    },
    {
      "id": "biz-decision-site",
      "type": "dimension",
      "dimension": "data-site-type",
      "label": "商务决策站点",
      "default": ["国内"]
    },
    {
      "id": "contract-decision-site",
      "type": "dimension",
      "dimension": "data-site-type",
      "label": "合同决策站点",
      "default": ["国内"]
    }
  ],
  "dataSources": {
    "region-dept-norms": {
      "fields": {
        "region-dept-name": { "type": "string", "role": "dimension", "label": "区域", "queryField": "地区部" },
        "bizSdtAvgDuration": { "type": "number", "role": "measure", "label": "商务代表处SDT平均决策时长", "queryField": "商审SDT平均决策时长" },
        "bizAvgDecisionCount": { "type": "number", "role": "measure", "label": "商务代表处平均决策人数", "queryField": "商审SDT平均决策人数" },
        "bizClosureRate": { "type": "number", "role": "measure", "label": "商务代表处闭环率", "queryField": "区域商审闭环率" },
        "contractClosureRate": { "type": "number", "role": "measure", "label": "合同决策代表处闭环率", "queryField": "销售合同决策代表处闭环率" }
      },
      "source": {
        "type": "query",
        "resultScope": "complete",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": ["地区部"],
                "output_metrics": [
                  "商审SDT平均决策时长",
                  "商审SDT平均决策人数",
                  "区域商审闭环率",
                  "销售合同决策代表处闭环率"
                ],
                "filter": {
                  "dims": [],
                  "metrics": [],
                  "time": { "period": "month", "is_aggregate": true }
                },
                "order": {
                  "order_by_field": "商审SDT平均决策时长",
                  "type": "desc"
                }
              }
            ]
          },
          "filterBindings": {
            "region": {
              "target": "dimension",
              "levelQueryFields": {
                "geo": "geo_pc_code",
                "region-dept": "地区部",
                "office": "代表处"
              }
            },
            "mtime": { "target": "time" },
            "customer-category": {
              "target": "dimension",
              "queryField": "客户类型"
            }
          }
        }
      }
    },
    "rep-office-norms": {
      "fields": {
        "rep-office-name": { "type": "string", "role": "dimension", "label": "代表处", "queryField": "代表处" },
        "bizSdtAvgDuration": { "type": "number", "role": "measure", "label": "商务代表处SDT平均决策时长", "unit": "天", "queryField": "商审SDT平均决策时长" },
        "bizAvgDecisionCount": { "type": "number", "role": "measure", "label": "商务代表处平均决策人数", "unit": "人", "queryField": "商审SDT平均决策人数" },
        "bizClosureRate": { "type": "number", "role": "measure", "label": "商务代表处闭环率", "defaultFormat": "percent-1", "queryField": "区域商审闭环率" },
        "contractClosureRate": { "type": "number", "role": "measure", "label": "合同决策代表处闭环率", "defaultFormat": "percent-1", "queryField": "销售合同决策代表处闭环率" }
      },
      "source": {
        "type": "query",
        "resultScope": "complete",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": ["代表处"],
                "output_metrics": [
                  "商审SDT平均决策时长",
                  "商审SDT平均决策人数",
                  "区域商审闭环率",
                  "销售合同决策代表处闭环率"
                ],
                "filter": {
                  "dims": [],
                  "metrics": [],
                  "time": { "period": "month", "is_aggregate": true }
                },
                "order": {
                  "order_by_field": "商审SDT平均决策时长",
                  "type": "desc"
                }
              }
            ]
          },
          "filterBindings": {
            "region": {
              "target": "dimension",
              "levelQueryFields": {
                "geo": "geo_pc_code",
                "region-dept": "地区部",
                "office": "代表处"
              }
            },
            "mtime": { "target": "time" },
            "customer-category": {
              "target": "dimension",
              "queryField": "客户类型"
            }
          }
        }
      }
    },
    "decision-validity-trend": {
      "fields": {
        "rep-office": { "type": "string", "role": "dimension", "label": "代表处", "queryField": "代表处" },
        "sdt-avg-duration": { "type": "number", "role": "measure", "label": "代表处SDT平均决策时长", "unit": "天", "queryField": "商审SDT平均决策时长" }
      },
      "source": {
        "type": "query",
        "resultScope": "complete",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": ["代表处"],
                "output_metrics": [
                  "商审SDT平均决策时长"
                ],
                "filter": {
                  "dims": [],
                  "metrics": [],
                  "time": { "period": "month", "is_aggregate": true }
                },
                "order": {
                  "order_by_field": "商审SDT平均决策时长",
                  "type": "desc"
                }
              }
            ]
          },
          "filterBindings": {
            "region": {
              "target": "dimension",
              "levelQueryFields": {
                "geo": "geo_pc_code",
                "region-dept": "地区部",
                "office": "代表处"
              }
            },
            "sdt-duration-site": {
              "target": "dimension", "queryField": "国内或海外",
              "when": { "any": [
                { "filter": "region", "part": "level", "op": "eq", "value": "geo" },
                { "filter": "region", "part": "values", "op": "containsAny", "values": ["全球"] }
              ] }
            },
            "mtime": { "target": "time" },
            "customer-category": {
              "target": "dimension",
              "queryField": "客户类型"
            }
          }
        }
      }
    },
    "urgent-decision-trend": {
      "fields": {
        "rep-office": { "type": "string", "role": "dimension", "label": "代表处", "queryField": "代表处" },
        "sdt-avg-count": { "type": "number", "role": "measure", "label": "代表处SDT平均决策人数", "unit": "人", "queryField": "商审SDT平均决策人数" }
      },
      "source": {
        "type": "query",
        "resultScope": "complete",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": ["代表处"],
                "output_metrics": [
                  "商审SDT平均决策人数"
                ],
                "filter": {
                  "dims": [],
                  "metrics": [],
                  "time": { "period": "month", "is_aggregate": true }
                },
                "order": {
                  "order_by_field": "商审SDT平均决策人数",
                  "type": "desc"
                }
              }
            ]
          },
          "filterBindings": {
            "region": {
              "target": "dimension",
              "levelQueryFields": {
                "geo": "geo_pc_code",
                "region-dept": "地区部",
                "office": "代表处"
              }
            },
            "sdt-count-site": {
              "target": "dimension", "queryField": "国内或海外",
              "when": { "any": [
                { "filter": "region", "part": "level", "op": "eq", "value": "geo" },
                { "filter": "region", "part": "values", "op": "containsAny", "values": ["全球"] }
              ] }
            },
            "mtime": { "target": "time" },
            "customer-category": {
              "target": "dimension",
              "queryField": "客户类型"
            }
          }
        }
      }
    },
    "apply-norm-trend": {
      "fields": {
        "rep-office": { "type": "string", "role": "dimension", "label": "代表处", "queryField": "代表处" },
        "biz-decision-count": { "type": "number", "role": "measure", "label": "商务决策数量", "unit": "个", "queryField": "审批通过商务申请数量" },
        "biz-closure-rate": { "type": "number", "role": "measure", "label": "商务决策闭环率", "unit": "%", "defaultFormat": "percent-1", "queryField": "区域商审闭环率" }
      },
      "source": {
        "type": "query",
        "resultScope": "complete",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": ["代表处"],
                "output_metrics": [
                  "审批通过商务申请数量",
                  "区域商审闭环率"
                ],
                "filter": {
                  "dims": [],
                  "metrics": [],
                  "time": { "period": "month", "is_aggregate": true }
                },
                "order": {
                  "order_by_field": "审批通过商务申请数量",
                  "type": "desc"
                }
              }
            ]
          },
          "filterBindings": {
            "region": {
              "target": "dimension",
              "levelQueryFields": {
                "geo": "geo_pc_code",
                "region-dept": "地区部",
                "office": "代表处"
              }
            },
            "biz-decision-site": {
              "target": "dimension", "queryField": "国内或海外",
              "when": { "any": [
                { "filter": "region", "part": "level", "op": "eq", "value": "geo" },
                { "filter": "region", "part": "values", "op": "containsAny", "values": ["全球"] }
              ] }
            },
            "mtime": { "target": "time" },
            "customer-category": {
              "target": "dimension",
              "queryField": "客户类型"
            }
          }
        }
      }
    },
    "contract-decision-trend": {
      "fields": {
        "rep-office": { "type": "string", "role": "dimension", "label": "代表处", "queryField": "代表处" },
        "contract-decision-count": { "type": "number", "role": "measure", "label": "合同决策数量", "unit": "个", "queryField": "完成申请的销售合同数量" },
        "contract-closure-rate": { "type": "number", "role": "measure", "label": "合同决策闭环率", "unit": "%", "defaultFormat": "percent-1", "queryField": "销售合同决策代表处闭环率" }
      },
      "source": {
        "type": "query",
        "resultScope": "complete",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": ["代表处"],
                "output_metrics": [
                  "完成申请的销售合同数量",
                  "销售合同决策代表处闭环率"
                ],
                "filter": {
                  "dims": [],
                  "metrics": [],
                  "time": { "period": "month", "is_aggregate": true }
                },
                "order": {
                  "order_by_field": "完成申请的销售合同数量",
                  "type": "desc"
                }
              }
            ]
          },
          "filterBindings": {
            "region": {
              "target": "dimension",
              "levelQueryFields": {
                "geo": "geo_pc_code",
                "region-dept": "地区部",
                "office": "代表处"
              }
            },
            "contract-decision-site": {
              "target": "dimension", "queryField": "国内或海外",
              "when": { "any": [
                { "filter": "region", "part": "level", "op": "eq", "value": "geo" },
                { "filter": "region", "part": "values", "op": "containsAny", "values": ["全球"] }
              ] }
            },
            "mtime": { "target": "time" },
            "customer-category": {
              "target": "dimension",
              "queryField": "客户类型"
            }
          }
        }
      }
    }
  },
  "sections": [
    {
      "id": "page-header-section",
      "container": "plain",
      "components": [
        {
          "id": "page-header",
          "type": "iocHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "identity": {
              "title": "行权效率"
            },
            "filterIds": [
              "key-rep-only",
              "mtime",
              "region",
              "customer-category"
            ],
            "note": "区域与统计期间筛选驱动全页查询",
            "presentation": {
              "layout": "inline",
              "density": "normal",
              "collapse": "none"
            }
          }
        }
      ]
    },
    {
      "id": "notice",
      "container": "plain",
      "components": [
        {
          "id": "data-scope-notice",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "注：不含混合云（HCS）的数据",
            "variant": "plain"
          }
        }
      ]
    },
    {
      "id": "region-dept-norms",
      "container": "card",
      "visibleWhen": { "any": [
        { "filter": "region", "part": "level", "op": "eq", "value": "geo" },
        { "filter": "region", "part": "values", "op": "containsAny", "values": ["全球"] }
      ] },
      "components": [
        {
          "id": "region-dept-norms-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "region-dept-norms"
          },
          "props": {
            "title": "地区部行权效率情况",
            "fit": "content",
            "toolbar": {
              "export": {
                "format": "xlsx",
                "filename": "地区部行权效率情况"
              }
            },
            "pagination": {
              "mode": "local",
              "pageSize": 10,
              "numbered": true
            },
            "rowNumber": { "title": "序号", "width": 60, "fixed": "left" },
            "columns": [
              {
                "field": "region-dept-name",
                "title": "区域",
                "width": 150,
                "fixed": "left",
                "selection": {
                  "writes": {
                    "region": { "field": "region-dept-name" }
                  }
                }
              },
              {
                "field": {
                  "data": "main",
                  "field": "bizSdtAvgDuration",
                  "format": "number-1"
                },
                "title": "商务代表处SDT平均决策时长",
                "unit": "天",
                "width": 180,
                "align": "right",
                "sortable": true
              },
              {
                "field": {
                  "data": "main",
                  "field": "bizAvgDecisionCount",
                  "format": "number-0"
                },
                "title": "商务代表处平均决策人数",
                "unit": "人",
                "width": 180,
                "align": "right",
                "sortable": true
              },
              {
                "field": {
                  "data": "main",
                  "field": "bizClosureRate",
                  "format": "percent-1"
                },
                "title": "商务代表处闭环率",
                "width": 150,
                "align": "right",
                "sortable": true
              },
              {
                "field": {
                  "data": "main",
                  "field": "contractClosureRate",
                  "format": "percent-1"
                },
                "title": "合同决策代表处闭环率",
                "width": 180,
                "align": "right",
                "sortable": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": "rep-office-norms",
      "container": "card",
      "components": [
        {
          "id": "rep-office-norms-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "rep-office-norms"
          },
          "props": {
            "title": "代表处行权效率情况",
            "fit": "content",
            "toolbar": {
              "export": {
                "format": "xlsx",
                "filename": "代表处行权效率情况"
              }
            },
            "pagination": {
              "mode": "local",
              "pageSize": 10,
              "numbered": true
            },
            "rowNumber": { "title": "序号", "width": 60, "fixed": "left" },
            "columns": [
              {
                "field": "rep-office-name",
                "title": "代表处",
                "width": 150,
                "fixed": "left",
                "link": true,
                "navigate": {
                  "href": "/operationmap/manage-contract-business/rep-office-execution-efficiency",
                  "query": {
                    "period": {
                      "source": "filter",
                      "id": "mtime"
                    },
                    "rep-office-name": {
                      "source": "row",
                      "field": "rep-office-name"
                    },
                    "customer-category": {
                      "source": "filter",
                      "id": "customer-category"
                    }
                  }
                }
              },
              {
                "field": {
                  "data": "main",
                  "field": "bizSdtAvgDuration",
                  "format": "number-1"
                },
                "title": "商务代表处SDT平均决策时长",
                "unit": "天",
                "width": 180,
                "align": "right",
                "sortable": true
              },
              {
                "field": {
                  "data": "main",
                  "field": "bizAvgDecisionCount",
                  "format": "number-0"
                },
                "title": "商务代表处平均决策人数",
                "unit": "人",
                "width": 180,
                "align": "right",
                "sortable": true
              },
              {
                "field": {
                  "data": "main",
                  "field": "bizClosureRate",
                  "format": "percent-1"
                },
                "title": "商务代表处闭环率",
                "width": 150,
                "align": "right",
                "sortable": true
              },
              {
                "field": {
                  "data": "main",
                  "field": "contractClosureRate",
                  "format": "percent-1"
                },
                "title": "合同决策代表处闭环率",
                "width": 180,
                "align": "right",
                "sortable": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": "sdt-duration-chart",
      "container": "card",
      "components": [
        {
          "id": "sdt-duration-card",
          "type": "compositeCard",
          "layout": { "span": 12 },
          "props": {
            "variant": "metricGrid",
            "title": "代表处SDT平均决策时长",
            "components": [
              {
                "id": "sdt-duration-site-filter",
                "type": "filterGroup",
                "layout": { "span": 12 },
                "props": {
                  "filterId": "sdt-duration-site",
                  "display": "buttons",
                  "align": "left",
                  "options": [
                    { "label": "中国区", "value": "国内" },
                    { "label": "海外", "value": "海外" }
                  ]
                },
                "visibleWhen": { "any": [
                  { "filter": "region", "part": "level", "op": "eq", "value": "geo" },
                  { "filter": "region", "part": "values", "op": "containsAny", "values": ["全球"] }
                ] }
              },
              {
                "id": "sdt-duration-bar-chart",
                "type": "barChart",
                "layout": { "span": 12 },
                "data": { "main": "decision-validity-trend" },
                "props": {
                  "categoryField": "rep-office",
                  "dualAxis": true,
                  "series": [
                    { "field": "sdt-avg-duration", "label": "代表处SDT平均决策时长", "kind": "bar", "axis": "primary", "unit": "天" },
                    { "value": 2, "label": "基线", "kind": "line", "axis": "secondary", "unit": "天" }
                  ],
                  "categoryLabels": { "mode": "all", "rotate": -45 },
                  "echartsOption": {
                    "grid": { "bottom": 44 },
                    "legend": { "top": null, "bottom": 0, "left": "center" },
                    "series": [
                      { "barWidth": 16 },
                      {}
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
