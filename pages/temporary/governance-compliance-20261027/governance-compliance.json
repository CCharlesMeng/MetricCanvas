    "decision-validity-trend": {
      "fields": {
        "rep-office": { "type": "string", "role": "dimension", "label": "代表处", "queryField": "代表处" },
        "sdt-avg-duration": { "type": "number", "role": "measure", "label": "代表处SDT平均决策时长", "unit": "天", "queryField": "商审SDT平均决策时长" }
      },
      "source": {
        "type": "query",
        "resultScope": "complete",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": ["代表处"],
                "output_metrics": [
                  "商审SDT平均决策时长"
                ],
                "filter": {
                  "dims": [],
                  "metrics": [],
                  "time": { "period": "month", "is_aggregate": false }
                },
                "order": {}
              }
            ]
          },
          "filterBindings": {
            "region": {
              "target": "dimension",
              "levelQueryFields": {
                "geo": "geo_pc_code",
                "region-dept": "region_dept_code",
                "office": "rep_office_code"
              }
            },
            "sdt-duration-site": { "target": "dimension", "queryField": "国内或海外" },
            "mtime": { "target": "time" }
          }
        }
      }
    },
    "urgent-decision-trend": {
      "fields": {
        "rep-office": { "type": "string", "role": "dimension", "label": "代表处", "queryField": "代表处" },
