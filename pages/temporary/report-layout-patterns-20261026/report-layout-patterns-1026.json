  "sections": [
    {
      "id": "header",
      "container": "plain",
      "components": [
        {
          "id": "report-header",
          "type": "reportHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "title": "PC 报告布局组合展示",
            "subtitle": "全部为合成数据。观察对象归属、并列比较、字段分组、卡内构成和页签组织；不代表真实业务分析。",
            "asOf": {
              "label": "示例更新",
              "value": "2026-10-26"
            }
          }
        }
      ]
    },
    {
      "id": "peer-objects",
      "title": "同一对象的两个核心指标",
      "container": "card",
      "components": [
        {
          "id": "object-a",
          "type": "metricCard",
          "layout": {
            "span": 6
          },
          "data": {
            "main": "response-a",
            "compare": "volume-a"
          },
          "props": {
            "title": "城市服务组",
            "variant": "compactSummary",
            "rows": [
              {
                "label": "平均响应时长",
                "valueField": {
                  "data": "main",
                  "field": "hours",
                  "format": "number-1"
                },
                "unit": "小时",
                "changes": [
                  {
                    "label": "较上期",
                    "field": {
                      "data": "main",
                      "field": "delta",
                      "format": "number-1-signed"
                    },
                    "unit": "小时",
                    "colorRule": {
                      "mode": "sign",
                      "positive": "red",
                      "negative": "green"
                    }
                  }
                ]
              },
              {
                "label": "工单量",
                "valueField": {
                  "data": "compare",
                  "field": "tickets",
                  "format": "number-grouped"
                },
                "unit": "件",
                "changes": [
                  {
                    "label": "较上期",
                    "field": {
                      "data": "compare",
                      "field": "delta",
                      "format": "number-signed"
                    },
                    "unit": "件",
                    "tone": "neutral"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "object-b",
          "type": "metricCard",
          "layout": {
            "span": 6
          },
          "data": {
            "main": "response-b",
            "compare": "volume-b"
          },
          "props": {
            "title": "企业服务组",
            "variant": "compactSummary",
            "rows": [
              {
                "label": "平均响应时长",
                "valueField": {
                  "data": "main",
                  "field": "hours",
                  "format": "number-1"
                },
                "unit": "小时",
                "changes": [
                  {
                    "label": "较上期",
                    "field": {
                      "data": "main",
                      "field": "delta",
                      "format": "number-1-signed"
                    },
                    "unit": "小时",
                    "colorRule": {
                      "mode": "sign",
                      "positive": "red",
                      "negative": "green"
                    }
                  }
                ]
              },
              {
                "label": "工单量",
                "valueField": {
                  "data": "compare",
                  "field": "tickets",
                  "format": "number-grouped"
                },
                "unit": "件",
                "changes": [
                  {
                    "label": "较上期",
                    "field": {
                      "data": "compare",
                      "field": "delta",
                      "format": "number-signed"
                    },
                    "unit": "件",
                    "tone": "neutral"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "opposing-groups",
      "title": "增长与下降对象并列核对",
      "container": "card",
      "components": [
        {
          "id": "growth-objects",
          "type": "rankingDetailCard",
          "layout": {
            "span": 6
          },
          "data": {
            "main": "growth"
          },
          "props": {
            "title": "重点增长对象",
            "variant": "report",
            "tone": "positive",
            "nameField": "name",
            "valueField": "amount",
            "changeField": {
              "data": "main",
              "field": "change",
              "format": "percent-1"
            },
            "descriptionField": "note",
            "metricLabel": "本月收入（万元）"
          }
        },
        {
          "id": "decline-objects",
          "type": "rankingDetailCard",
          "layout": {
            "span": 6
          },
          "data": {
            "main": "decline"
          },
          "props": {
            "title": "重点下降对象",
            "variant": "report",
            "tone": "negative",
            "nameField": "name",
            "valueField": "amount",
            "changeField": {
              "data": "main",
              "field": "change",
              "format": "percent-1"
            },
            "descriptionField": "note",
            "metricLabel": "本月收入（万元）"
          }
        }
      ]
    },
    {
      "id": "grouped-detail",
      "title": "按业务阶段核对明细",
      "container": "card",
      "components": [
        {
          "id": "stage-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "stage-records"
          },
          "props": {
            "title": "批次累计时长与各阶段参与量",
            "fit": "container",
            "columns": [
              {
                "field": "name",
                "title": "作业批次",
                "width": 140
              },
              {
                "field": {
                  "data": "main",
                  "field": "total",
                  "format": "number-1"
                },
                "title": "累计时长（小时）",
                "width": 130,
                "align": "right"
              },
              {
                "kind": "group",
                "id": "inbound",
                "title": "入库复核",
                "children": [
                  {
                    "field": "in-count",
                    "title": "参与人次",
                    "width": 90,
                    "align": "right"
                  },
                  {
                    "field": {
                      "data": "main",
                      "field": "in-hours",
                      "format": "number-1"
                    },
                    "title": "时长（小时）",
                    "width": 110,
                    "align": "right"
                  }
                ]
              },
              {
                "kind": "group",
                "id": "outbound",
                "title": "出库复核",
                "children": [
                  {
                    "field": "out-count",
                    "title": "参与人次",
                    "width": 90,
                    "align": "right"
                  },
                  {
                    "field": {
                      "data": "main",
                      "field": "out-hours",
                      "format": "number-1"
                    },
                    "title": "时长（小时）",
                    "width": 110,
                    "align": "right"
                  }
                ]
              },
              {
                "kind": "group",
                "id": "returns",
                "title": "退货复核",
                "children": [
                  {
                    "field": "return-count",
                    "title": "参与人次",
                    "width": 90,
                    "align": "right"
                  },
                  {
                    "field": {
                      "data": "main",
                      "field": "return-hours",
                      "format": "number-1"
                    },
                    "title": "时长（小时）",
                    "width": 110,
                    "align": "right"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "composition",
      "title": "构成概览与精确值同处",
      "container": "plain",
      "components": [
        {
          "id": "composition-card",
          "type": "compositeCard",
          "layout": {
            "span": 12
          },
          "props": {
            "title": "三类业务工单构成（合计60件）",
            "variant": "compact",
            "components": [
              {
                "id": "composition-ring",
                "type": "pieChart",
                "layout": {
                  "span": 5
                },
                "data": {
                  "main": "categories"
                },
                "props": {
                  "title": "工单占比",
                  "variant": "compactRing",
                  "categoryField": "category",
                  "valueField": "count",
                  "ring": "60%",
                  "labelLine": false
                }
              },
              {
                "id": "composition-detail",
                "type": "categoryBreakdown",
                "layout": {
                  "span": 7
                },
                "data": {
                  "main": "categories"
                },
                "props": {
                  "title": "各类工单数量",
                  "variant": "compactList",
                  "categoryField": "category",
                  "columns": [
                    {
                      "label": "工单数（件）",
                      "field": "count"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "overview-detail",
      "title": "概览与逐月明细按需切换",
      "container": "card",
      "components": [
        {
          "id": "overview-detail-tabs",
          "type": "tabContainer",
          "layout": {
            "span": 12
          },
          "props": {
            "defaultTab": "overview",
            "contentLayout": "grid",
            "tabs": [
              {
                "id": "overview",
                "label": "概览",
                "components": [
                  {
                    "id": "history-chart",
                    "type": "lineChart",
                    "layout": {
                      "span": 12
                    },
                    "data": {
                      "main": "history"
                    },
                    "props": {
                      "title": "近三个月工单量",
                      "xField": "month",
                      "series": [
                        {
                          "field": "tickets",
                          "label": "工单数（件）"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "id": "details",
                "label": "逐月明细",
                "components": [
                  {
                    "id": "history-table",
                    "type": "table",
                    "layout": {
                      "span": 12
                    },
                    "data": {
                      "main": "history"
                    },
                    "props": {
                      "title": "同一批月份的精确值",
                      "fit": "container",
                      "columns": [
                        {
                          "field": "month",
                          "title": "月份"
                        },
                        {
                          "field": "tickets",
                          "title": "工单数（件）",
                          "align": "right"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
