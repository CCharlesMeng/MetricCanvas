{
  "schemaVersion": "3.0",
  "id": "demo",
  "meta": {
    "description": "筛选联动演示:筛选器、页内下钻、跨页下钻(跳销售明细)、URL 可分享"
  },
  "dataSources": {
    "gmv": {
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [],
                "output_metrics": [
                  "gmv"
                ],
                "filter": {
                  "time": {
                    "period": "day",
                    "is_aggregate": false,
                    "start": "2026-01-01",
                    "end": "2026-12-31"
                  },
                  "dims": [],
                  "metrics": []
                },
                "order": {}
              }
            ]
          },
          "filterBindings": {
            "f-time": {
              "target": "time"
            },
            "f-region": {
              "target": "dimension",
              "queryField": "region"
            },
            "f-channel": {
              "target": "dimension",
              "queryField": "channel"
            }
          }
        }
      },
      "fields": {
        "gmv": {
          "queryField": "gmv",
          "type": "number",
          "role": "measure",
          "label": "成交总额",
          "defaultFormat": "number-grouped"
        }
      }
    },
    "order-count": {
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [],
                "output_metrics": [
                  "order-count"
                ],
                "filter": {
                  "time": {
                    "period": "day",
                    "is_aggregate": false,
                    "start": "2026-01-01",
