                  },
                  "dims": [],
                  "metrics": []
                },
                "order": {}
              }
            ]
          },
          "filterBindings": {
            "f-time": {
              "target": "time"
            }
          }
        }
      },
      "fields": {
        "order-count": {
          "queryField": "order-count",
          "type": "number",
          "role": "measure",
          "label": "订单数（单）",
          "defaultFormat": "number-grouped"
        }
      }
    },
