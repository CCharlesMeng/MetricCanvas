              "queryField": "region"
            },
            "f-channel": {
              "target": "dimension",
              "queryField": "channel"
            }
          }
        }
      },
      "fields": {
        "mtime": {
          "queryField": "mtime",
          "type": "date",
          "role": "dimension",
          "label": "日期"
        },
        "gmv": {
          "queryField": "gmv",
          "type": "number",
          "role": "measure",
          "label": "成交总额",
