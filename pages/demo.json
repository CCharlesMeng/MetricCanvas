    },
    "channel-share": {
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "channel"
                ],
                "output_metrics": [
                  "gmv"
                ],
                "filter": {
                  "time": {
                    "period": "day",
