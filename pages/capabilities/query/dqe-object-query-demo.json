          "type": "number",
          "role": "measure",
          "label": "预算差额"
        },
        "contract": {
          "type": "number",
          "role": "measure",
          "label": "关联合同金额"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "query_type": "object",
                "object_type": "Demo/Approval Details",
                "output_fields": [
                  "审批记录ID",
                  "商务编号",
                  "特价审批通过时间",
                  "区域",
                  "审批金额",
                  "预算金额"
                ],
                "filter": {
                  "fields": [
                    {
                      "field_name": "特价审批通过时间",
                      "value_list": [
                        "2025-01-01 00:00:00"
                      ],
                      "operator": ">="
                    },
                    {
                      "field_name": "特价审批通过时间",
                      "value_list": [
                        "2025-01-31 23:59:59"
                      ],
                      "operator": "<="
                    }
                  ]
                },
                "order": {
                  "order_by_field": "审批记录ID",
                  "type": "asc"
                }
              }
            ]
          },
          "filterBindings": {
            "period": {
              "target": "time",
              "queryField": "特价审批通过时间",
              "valueFormat": "datetime"
            },
            "region": {
              "target": "dimension",
              "queryField": "区域"
            },
            "business": {
              "target": "dimension",
              "queryField": "商务编号"
            },
            "amount": {
              "target": "numberRange",
              "metric": "审批金额"
            }
          }
        },
        "resultScope": "complete"
      },
      "compute": [
        {
          "op": "delta",
          "minuend": "budget",
          "subtrahend": "amount",
          "output": "gap"
        },
        {
          "op": "joinAggregate",
          "source": "metrics",
          "keys": [
            {
              "local": "business",
              "foreign": "business"
            }
          ],
          "values": [
            {
              "field": "contract",
              "output": "contract",
              "aggregate": "unique"
            }
          ],
          "onMissing": "null"
        }
      ]
    },
    "metrics": {
      "fields": {
        "business": {
          "type": "string",
          "role": "dimension",
          "queryField": "商务编号"
        },
        "contract": {
          "type": "number",
          "role": "measure",
          "queryField": "示例合同金额"
        }
      },
      "source": {
        "type": "query",
        "resultScope": "complete",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "商务编号"
                ],
                "output_metrics": [
                  "示例合同金额"
                ],
                "filter": {
                  "dims": [],
                  "metrics": []
                },
                "order": {}
