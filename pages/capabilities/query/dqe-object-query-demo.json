  "sections": [
    {
      "id": "object",
      "components": [
        {
          "id": "object-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "records"
          },
          "props": {
            "title": "审批明细（合成数据，查询分页）",
            "rowKey": "record",
            "columns": [
              {
                "field": "record",
                "sortable": true
              },
              {
                "field": "business",
                "sortable": true,
                "selection": {
                  "writes": {
                    "business": {
                      "field": "business"
                    }
                  }
                }
              },
              {
                "field": "approved",
                "sortable": true
              },
