      },
      "source": {
        "type": "query",
        "resultScope": "complete",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "项目编号",
                  "项目名称"
                ],
                "output_metrics": [
                  "得分",
                  "金额"
                ],
                "filter": {
                  "time": {
                    "period": "month",
                    "start": "202610",
                    "end": "202610"
                  },
                  "dims": [],
                  "metrics": []
                },
                "order": {
                  "order_by_field": "金额",
                  "type": "desc"
                }
              }
            ]
          },
          "resultBindings": [
            {
              "source": "projects",
              "field": "project-id",
              "target": "dimension",
              "queryField": "项目编号",
              "maxValues": 500,
              "where": {
                "all": [
                  {
                    "field": "status",
                    "op": "eq",
                    "value": "进行中"
                  },
                  {
                    "field": "amount",
                    "op": "lte",
                    "value": 3000000
                  }
                ]
              }
            }
          ]
        }
