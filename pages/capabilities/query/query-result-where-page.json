{
  "schemaVersion": "6.20",
  "id": "query-result-where-page",
  "layout": "report",
  "meta": {
    "title": "项目资金排序与评估跟进",
    "description": "本地DQE仿真：80个项目，服务端任意列排序与分页；下游独立过滤当前查询窗口并提取编号。"
  },
  "filters": [],
  "dataSources": {
    "projects": {
      "fields": {
        "project-id": {
          "type": "string",
          "role": "dimension",
          "queryField": "项目编号",
          "nullable": true
        },
        "status": {
          "type": "string",
          "role": "dimension",
          "queryField": "状态",
          "nullable": true
        },
        "enabled": {
          "type": "boolean",
          "role": "dimension",
          "queryField": "启用",
          "nullable": true
        },
        "amount": {
          "type": "money",
          "role": "measure",
          "label": "项目金额",
          "queryField": "金额",
          "currency": "CNY",
          "unit": "元",
          "nullable": false,
          "defaultFormat": "number-grouped"
        },
        "duration": {
          "type": "number",
          "role": "measure",
          "queryField": "时长",
          "nullable": true,
          "label": "执行周期",
          "unit": "天"
        },
        "day": {
          "type": "date",
          "role": "dimension",
          "queryField": "日期",
          "nullable": true
        },
        "at": {
          "type": "datetime",
          "role": "dimension",
          "queryField": "采集时间",
          "nullable": true
        },
        "project-name": {
          "type": "string",
          "role": "dimension",
          "label": "项目名称",
          "queryField": "项目名称",
          "nullable": false
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "项目编号",
                  "项目名称",
                  "状态",
                  "启用",
                  "日期",
                  "采集时间"
                ],
                "output_metrics": [
                  "金额",
                  "时长"
                ],
                "filter": {
                  "time": {
                    "period": "month",
                    "start": "202610",
                    "end": "202610"
                  },
                  "dims": [],
                  "metrics": []
                },
                "order": {
                  "by": [
                    {
                      "field": "金额",
                      "type": "desc",
                      "priority": 1
                    }
                  ],
                  "limit": 10,
                  "offset": 0
                }
              }
            ]
          }
        }
      }
    },
    "details-high": {
      "fields": {
        "project-id": {
          "type": "string",
          "role": "dimension",
          "queryField": "项目编号",
          "nullable": true
        },
        "score": {
          "type": "number",
          "role": "measure",
          "queryField": "得分",
          "nullable": true
        },
        "project-name": {
          "type": "string",
          "role": "dimension",
          "label": "项目名称",
          "queryField": "项目名称",
          "nullable": false
        },
        "amount": {
          "type": "money",
          "role": "measure",
          "label": "项目金额",
          "queryField": "金额",
          "currency": "CNY",
          "unit": "元",
          "nullable": false,
          "defaultFormat": "number-grouped"
        }
      },
      "source": {
        "type": "query",
        "resultScope": "complete",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "项目编号",
                  "项目名称"
                ],
                "output_metrics": [
                  "得分",
                  "金额"
                ],
                "filter": {
                  "time": {
                    "period": "month",
                    "start": "202610",
                    "end": "202610"
                  },
                  "dims": [],
                  "metrics": []
                },
                "order": {
                  "order_by_field": "金额",
                  "type": "desc"
                }
              }
            ]
          },
          "resultBindings": [
            {
              "source": "projects",
              "field": "project-id",
              "target": "dimension",
              "queryField": "项目编号",
              "maxValues": 500,
              "where": {
                "all": [
                  {
                    "field": "status",
                    "op": "eq",
                    "value": "进行中"
                  },
                  {
                    "field": "amount",
                    "op": "gt",
                    "value": 3000000
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "details-low": {
      "fields": {
        "project-id": {
          "type": "string",
