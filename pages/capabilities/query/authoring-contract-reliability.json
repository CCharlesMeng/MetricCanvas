          "type": "string",
          "role": "dimension"
        },
        "amount": {
          "type": "number",
          "role": "measure"
        }
      },
      "source": {
        "type": "inline",
        "rows": [
          {
            "region": "a",
            "amount": 1
          },
          {
            "region": "b",
            "amount": 2
          }
        ]
      }
    },
    "cases": {
