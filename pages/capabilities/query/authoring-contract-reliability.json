          "role": "dimension"
        },
        "actual": {
          "type": "string",
          "role": "dimension"
        }
      },
      "source": {
        "type": "inline",
        "rows": [
          {
            "period": "year",
            "input": "0001 → 9999",
            "actual": "0001 → 9999"
          },
          {
            "period": "month",
            "input": "2026-04 → 2026-09",
            "actual": "2026-04 → 2026-09"
          },
          {
            "period": "day",
            "input": "2024-02-29 → 2024-03-01",
            "actual": "2024-02-29 → 2024-03-01"
          },
          {
