          },
          {
            "period": "year",
            "input": "2026-04 → 2026-09",
            "actual": "TIME_VALUE_PRECISION_INVALID"
          },
          {
            "period": "day",
            "input": "2026-04 → 2026-09",
            "actual": "TIME_VALUE_PRECISION_INVALID"
          },
          {
            "period": "month",
            "input": "2026-04 → 20260930",
            "actual": "TIME_VALUE_PRECISION_INVALID"
          },
          {
