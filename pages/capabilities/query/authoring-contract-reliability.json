    "invalid-time": {
      "fields": {
        "amount": {
          "type": "number",
          "role": "measure",
          "queryField": "amount"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_metrics": [
                  "amount"
                ],
                "output_dims": [],
                "filter": {
                  "time": {
                    "period": "month",
                    "start": "20260401",
                    "end": "20260930"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "sections": [
    {
      "id": "header",
      "components": [
        {
          "id": "page-header",
          "type": "reportHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "title": "创作契约可靠性验收",
            "subtitle": "合成证据 · 时间精度、完整行证据与执行前拒绝"
          }
        }
      ]
    },
    {
      "id": "evidence",
      "title": "相同可信行证据：两种呈现都应显示 2",
      "components": [
        {
          "id": "plain",
          "type": "metricCard",
          "layout": {
            "span": 4
          },
          "data": {
            "main": "trusted"
          },
          "props": {
            "title": "普通指标卡",
            "rows": [
              {
                "label": "amount",
                "valueField": {
                  "data": "main",
                  "field": "amount",
                  "match": {
                    "field": "region",
                    "equals": "b"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "rich",
          "type": "metricCard",
          "layout": {
            "span": 4
          },
          "data": {
            "main": "trusted"
          },
          "props": {
            "variant": "compactSummary",
            "rows": [
              {
                "label": "amount",
                "valueField": {
                  "data": "main",
                  "field": "amount",
                  "match": {
                    "field": "region",
                    "equals": "b"
                  }
                }
              }
            ],
            "title": "汇总呈现"
          }
        }
      ]
    },
    {
      "id": "time-cases",
      "components": [
        {
          "id": "matrix",
          "type": "table",
          "data": {
            "main": "cases"
          },
          "layout": {
            "span": 12
          },
          "props": {
            "title": "实际解析结果",
            "columns": [
              {
                "field": "period",
                "title": "粒度"
              },
              {
                "field": "input",
                "title": "输入范围"
              },
              {
                "field": "actual",
                "title": "规范值或错误码"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "execution-rejection",
      "components": [
        {
          "id": "bad-time",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "invalid-time"
          },
          "props": {
            "title": "非法 month + 日精度：执行前拒绝（诊断见控制台）",
            "columns": [
              {
                "field": "amount",
                "title": "不会请求服务"
              }
            ]
          }
        }
      ]
    }
  ]
}
