{
  "schemaVersion": "6.45",
  "id": "metric-card-equation",
  "layout": "dashboard",
  "meta": {
    "title": "收入构成看板",
    "description": "白底无边框内容分区内，标题、区域筛选按钮、四张Before指标卡依次排列；筛选使用合成查询数据。"
  },
  "dataSources": {
    "demo-metrics": {
      "fields": {
        "total": {
          "type": "number",
          "role": "measure"
        },
        "product": {
          "type": "number",
          "role": "measure"
        },
        "service": {
          "type": "number",
          "role": "measure"
        },
        "other": {
          "type": "number",
          "role": "measure"
        }
      },
      "source": {
        "type": "inline",
        "rows": [
          {
            "total": 1200,
            "product": 680,
            "service": 360,
            "other": 160
          }
        ]
      }
    },
    "region-metrics": {
      "fields": {
        "total": {
          "type": "number",
          "role": "measure",
          "queryField": "metric_equation_total"
        },
        "product": {
          "type": "number",
          "role": "measure",
          "queryField": "metric_equation_product"
        },
        "service": {
          "type": "number",
          "role": "measure",
          "queryField": "metric_equation_service"
        },
        "other": {
          "type": "number",
          "role": "measure",
          "queryField": "metric_equation_other"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "filterBindings": {
            "revenue-region": {
              "target": "dimension",
              "queryField": "metric_equation_region"
            }
          },
          "body": {
            "dsl_list": [
              {
                "output_dims": [],
                "output_metrics": [
                  "metric_equation_total",
                  "metric_equation_product",
                  "metric_equation_service",
                  "metric_equation_other"
                ],
                "filter": {
                  "dims": [],
                  "metrics": []
                },
                "order": {}
              }
            ]
          }
        }
      }
    }
  },
  "sections": [
    {
      "id": "intro",
      "container": "plain",
      "components": [
        {
          "id": "intro-text",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "variant": "plain",
            "body": "收入概览 · 单位：万元 · 合成演示数据 · 白底无边框分区 · 标题下方筛选 · 独立白色小卡 · 连接文字双侧8px"
          }
        }
      ]
    },
    {
      "id": "equation",
      "title": "收入构成",
      "container": "card",
      "components": [
        {
          "id": "revenue-region-buttons",
          "type": "filterGroup",
          "layout": {
            "span": 12
          },
          "props": {
            "filterId": "revenue-region",
            "options": [
              {
                "label": "全部区域",
                "value": "all"
              },
              {
                "label": "华东",
                "value": "east"
              },
              {
                "label": "华南",
                "value": "south"
              }
            ]
          }
        },
        {
          "id": "total-card",
          "type": "metricCard",
          "layout": {
            "span": 3
          },
          "data": {
            "main": "region-metrics"
          },
          "props": {
            "variant": "compactStack",
            "rows": [
              {
                "label": "总收入",
                "valueField": {
                  "data": "main",
                  "field": "total",
                  "format": "number-grouped"
                },
                "unit": "万元"
              }
            ]
          }
        },
        {
          "id": "product-card",
          "type": "metricCard",
          "layout": {
            "span": 3,
            "before": {
              "text": "=",
              "gap": 8
            }
          },
          "data": {
            "main": "region-metrics"
          },
          "props": {
            "variant": "compactStack",
            "rows": [
              {
                "label": "产品收入",
                "valueField": {
                  "data": "main",
                  "field": "product",
                  "format": "number-grouped"
                },
                "unit": "万元"
              }
            ]
          }
        },
        {
          "id": "service-card",
          "type": "metricCard",
          "layout": {
            "span": 3,
            "before": {
              "text": "+",
              "gap": 8
            }
          },
          "data": {
            "main": "region-metrics"
          },
          "props": {
            "variant": "compactStack",
            "rows": [
              {
                "label": "服务收入",
                "valueField": {
                  "data": "main",
                  "field": "service",
                  "format": "number-grouped"
                },
                "unit": "万元"
              }
            ]
          }
        },
        {
          "id": "other-card",
          "type": "metricCard",
          "layout": {
            "span": 3,
            "before": {
              "text": "+",
              "gap": 8
            }
          },
          "data": {
            "main": "region-metrics"
          },
          "props": {
            "variant": "compactStack",
            "rows": [
              {
                "label": "其他收入",
                "valueField": {
                  "data": "main",
                  "field": "other",
                  "format": "number-grouped"
                },
                "unit": "万元"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "word-connection",
      "title": "业务拆分",
      "container": "card",
      "components": [
        {
          "id": "word-total",
          "type": "metricCard",
          "layout": {
            "span": 3
          },
          "data": {
            "main": "demo-metrics"
          },
          "props": {
            "variant": "compactStack",
            "rows": [
              {
                "label": "总收入",
                "valueField": {
                  "data": "main",
                  "field": "total",
                  "format": "number-grouped"
                },
                "unit": "万元"
              }
            ]
          }
        },
        {
          "id": "word-product",
          "type": "metricCard",
          "layout": {
            "span": 3,
            "before": {
              "text": "其中",
              "gap": 8
            }
          },
          "data": {
            "main": "demo-metrics"
          },
          "props": {
            "variant": "compactStack",
            "rows": [
              {
                "label": "产品收入",
                "valueField": {
                  "data": "main",
                  "field": "product",
                  "format": "number-grouped"
                },
                "unit": "万元"
              }
            ]
          }
        },
        {
          "id": "word-service",
          "type": "metricCard",
          "layout": {
            "span": 3,
            "before": {
              "text": "+",
              "gap": 8
            }
          },
          "data": {
            "main": "demo-metrics"
          },
          "props": {
            "variant": "compactStack",
            "rows": [
              {
                "label": "服务收入",
                "valueField": {
                  "data": "main",
                  "field": "service",
                  "format": "number-grouped"
                },
                "unit": "万元"
              }
            ]
          }
        },
        {
          "id": "word-other",
          "type": "metricCard",
          "layout": {
            "span": 3,
            "before": {
              "text": "+",
              "gap": 8
            }
          },
          "data": {
            "main": "demo-metrics"
          },
          "props": {
            "variant": "compactStack",
            "rows": [
              {
                "label": "其他收入",
                "valueField": {
                  "data": "main",
                  "field": "other",
                  "format": "number-grouped"
                },
                "unit": "万元"
              }
            ]
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "revenue-region",
      "type": "dimension",
      "dimension": "metric_equation_region",
      "label": "区域",
      "default": [
        "all"
      ]
    }
  ]
}
