{
  "id": "mc-content-layout-demo",
  "schemaVersion": "6.77",
  "layout": "dashboard",
  "meta": {
    "title": "MC 内容包：布局与版本检查",
    "description": "由真实本地诊断生成的合成验收页；不代表真实部署。"
  },
  "dataSources": {
    "diagnostics": {
      "fields": {
        "case": {
          "type": "string",
          "role": "dimension",
          "label": "检查项"
        },
        "result": {
          "type": "string",
          "role": "dimension",
          "label": "结果"
        },
        "detail": {
          "type": "string",
          "role": "dimension",
          "label": "说明"
        }
      },
      "source": {
        "type": "inline",
        "rows": [
          {
            "case": "同源知识有界读取",
            "result": "ok",
            "detail": "table.width 保留语义与父约束；未展开引用可继续定位"
          },
          {
            "case": "完整工具参数",
            "result": "ok",
            "detail": "query_data 外层与 request 来自实际 FastMCP 注册"
          },
          {
            "case": "来源覆盖对账",
            "result": "ok",
            "detail": "217 主题 / 9 工具 / 19 组件；独立分母检查"
          },
          {
            "case": "正常编译",
            "result": "ok",
            "detail": "summary 保留；未提交的 detail 章节不会补回"
          },
          {
            "case": "用户要求地图",
            "result": "gap",
            "detail": "DECLARED_REQUIREMENT_GAP"
          },
          {
            "case": "IOC 计划场景",
            "result": "invalid",
            "detail": "TEMPLATE_NOT_EXECUTABLE"
          },
          {
            "case": "旧版 6.0 页面",
            "result": "upgrade_required",
            "detail": "原 layoutForm 文件不能直接读取；产品迁移规则允许升级"
          },
          {
            "case": "未来 999.0 页面",
            "result": "needs_review",
            "detail": "无升级规则，不改版本号放行"
          },
          {
            "case": "真实保存与 Relay",
            "result": "not_run",
            "detail": "MC 只给检查结论；此合成场景未连接真实部署"
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "header",
      "container": "plain",
      "components": [
        {
          "id": "page-header",
          "type": "reportHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "title": "MC 内容包：布局与版本检查"
          }
        }
      ]
    },
    {
      "id": "checks",
      "title": "本地确定性检查",
      "components": [
        {
          "id": "diagnostic-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "diagnostics"
          },
          "props": {
            "title": "检查结果与证据范围",
            "columns": [
              {
                "field": "case",
                "title": "检查项",
                "sortable": true
              },
              {
                "field": "result",
                "title": "结果"
              },
              {
                "field": "detail",
                "title": "说明"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "usage",
      "components": [
        {
          "id": "upgrade-flow",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "旧文件流程：整包校验 → 检查可读范围与能力下限 → 显式升级到新目录 → 核对原件与迁移报告 → Skill 决定采用。此页面不执行保存、发布或真实查询。"
          }
        }
      ]
    }
  ]
}
