{
  "schemaVersion": "6.81",
  "id": "metric-card-loading",
  "layout": "dashboard",
  "dataSources": {
    "gallery": {
      "fields": {
        "category": {
          "label": "类别",
          "type": "string",
          "role": "dimension",
          "queryField": "preview_category"
        },
        "name": {
          "label": "团队",
          "type": "string",
          "role": "dimension",
          "queryField": "preview_name"
        },
        "demo-region": {
          "label": "省份",
          "type": "string",
          "role": "dimension",
          "queryField": "preview_region"
        },
        "date": {
          "label": "日期",
          "type": "date",
          "role": "dimension",
          "queryField": "preview_date"
        },
        "description": {
          "label": "说明",
          "type": "string",
          "role": "dimension",
          "queryField": "preview_description"
        },
        "value": {
          "label": "完成量",
          "type": "number",
          "role": "measure",
          "queryField": "preview_value",
          "defaultFormat": "number"
        },
        "change": {
          "label": "较上期",
          "type": "number",
          "role": "measure",
          "queryField": "preview_change",
          "defaultFormat": "percent-1"
        },
        "progress": {
          "label": "完成率",
          "type": "number",
          "role": "measure",
          "queryField": "preview_progress",
          "defaultFormat": "percent-0"
        }
      },
      "source": {
        "type": "query",
        "resultScope": "complete",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "schema_id": "MC_LOADING_STRUCTURE_DEMO",
                "output_dims": [
                  "preview_category",
                  "preview_name",
                  "preview_region",
                  "preview_date",
                  "preview_description"
                ],
                "output_metrics": [
                  "preview_value",
                  "preview_change",
                  "preview_progress"
                ],
                "filter": {
                  "dims": [],
                  "metrics": []
                },
                "order": {}
              }
            ]
          }
        }
      }
    }
  },
  "sections": [
