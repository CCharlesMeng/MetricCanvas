  "sections": [
    {
      "id": "ordinary",
      "title": "普通 Table",
      "components": [
        {
          "id": "ordinary-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "records"
          },
          "props": {
            "title": "普通 Table",
            "rowKey": "name",
            "columns": [
              {
                "field": "name",
                "width": 180,
                "fixed": "left",
                "sortable": true,
                "title": "客户"
              },
              {
                "field": "value",
                "width": 150,
                "align": "right",
                "sortable": true,
                "filterable": {
                  "mode": "numberRange"
                },
                "title": "金额（元）"
              },
              {
                "field": "created",
                "width": 180,
                "filterable": {
                  "mode": "dateRange"
                },
                "title": "创建日期"
              },
              {
                "field": "note",
                "width": 320,
                "title": "项目说明"
              },
              {
                "field": "status",
                "width": 120,
                "fixed": "right",
                "filterable": {
                  "mode": "select"
                },
                "title": "状态"
              }
            ],
            "toolbar": {
              "search": {
                "fields": [
                  "name"
                ],
                "placeholder": "搜索客户"
              },
              "export": {
                "format": "xlsx",
                "filename": "普通 Table"
              }
            },
            "pagination": {
              "mode": "local",
              "pageSize": 5,
              "numbered": true
            }
          }
        }
      ]
    },
