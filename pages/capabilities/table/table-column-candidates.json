        {
          "id": "header-title",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "64 行合成数据 · 两张表独立筛选。\n打开「代表处」可搜索选项或加载更多；先选择代表处，再将金额下限设为 650000，可查看已选项在无匹配时的保留状态。"
          }
        }
      ]
    },
    {
      "id": "candidate-table-section",
      "container": "card",
      "components": [
        {
          "id": "candidate-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "records"
          },
          "props": {
            "title": "多列联动与候选搜索",
            "pagination": {
              "mode": "local",
              "pageSize": 5,
              "numbered": true
            },
            "toolbar": {
              "search": {
                "fields": [
                  "office"
                ],
                "placeholder": "搜索表格代表处"
              }
            },
            "columns": [
              {
                "field": "region",
                "filterable": {
                  "mode": "select"
                },
                "sortable": true
              },
              {
                "field": "office",
                "filterable": {
                  "mode": "select"
                },
                "sortable": true
              },
              {
                "field": "grade",
                "filterable": {
                  "mode": "select"
                },
                "sortable": true
              },
              {
                "field": "amount",
                "filterable": {
                  "mode": "numberRange"
                },
                "sortable": true
              }
            ],
            "fit": "container"
          }
        }
      ]
    },
