  "sections": [
    {
      "id": "header",
      "container": "plain",
      "components": [
        {
          "id": "page-header",
          "type": "reportHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "title": "表格搜索与导出示例",
            "subtitle": "顶部展示三层表头及跨行、跨列合并；下方25条客户演示记录支持独立搜索和完整匹配结果 Excel 导出。"
          }
        }
      ]
    },
    {
      "id": "three-level-headers",
      "components": [
        {
          "id": "three-level-header-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "header-demo-records"
          },
          "props": {
            "title": "三层表头示例",
            "subtitle": "静态演示数据。经营指标 → 收入／利润 → 目标／实际；区域跨三行、客户数跨两行。点击数值列可排序。",
            "fit": "container",
            "pagination": {
              "mode": "none"
            },
            "columns": [
              {
                "field": "region",
                "title": "区域",
                "fixed": "left"
              },
              {
                "kind": "group",
                "id": "operations",
                "title": "经营指标",
                "children": [
                  {
                    "kind": "group",
                    "id": "revenue",
                    "title": "收入（万元）",
                    "children": [
                      {
                        "field": {
                          "data": "main",
                          "field": "revenueTarget",
                          "format": "number-grouped"
                        },
                        "title": "目标",
                        "align": "right",
                        "sortable": true
                      },
                      {
                        "field": {
                          "data": "main",
                          "field": "revenueActual",
                          "format": "number-grouped"
                        },
                        "title": "实际",
                        "align": "right",
                        "sortable": true
                      }
                    ]
                  },
                  {
                    "kind": "group",
                    "id": "profit",
                    "title": "利润（万元）",
                    "children": [
                      {
                        "field": {
                          "data": "main",
                          "field": "profitTarget",
                          "format": "number-grouped"
                        },
                        "title": "目标",
                        "align": "right",
                        "sortable": true
                      },
                      {
                        "field": {
                          "data": "main",
                          "field": "profitActual",
                          "format": "number-grouped"
                        },
                        "title": "实际",
                        "align": "right",
                        "sortable": true
                      }
                    ]
                  },
                  {
                    "field": {
                      "data": "main",
                      "field": "customers",
                      "format": "number-grouped"
                    },
                    "title": "客户数（家）",
                    "align": "right",
                    "sortable": true
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "main",
      "components": [
        {
          "id": "records-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "records"
          },
          "props": {
            "title": "客户明细",
            "toolbar": {
              "search": {
                "fields": [
                  "name"
                ],
                "placeholder": "搜索客户"
              },
              "export": {
                "format": "xlsx",
                "filename": "客户明细"
              }
            },
            "pagination": {
              "mode": "local",
              "pageSize": 10,
              "numbered": true
            },
            "columns": [
              {
                "field": "name",
                "sortable": true
              },
              {
                "field": {
                  "data": "main",
                  "field": "value",
                  "format": "number-2"
                },
                "title": "金额（元）",
                "sortable": true
              }
            ],
            "fit": "container"
          }
        },
        {
          "id": "independent-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "records"
          },
          "props": {
            "title": "另一张独立表格",
            "toolbar": {
              "search": {
                "fields": [
                  "name"
                ],
                "placeholder": "搜索客户"
              },
              "export": {
                "format": "xlsx",
                "filename": "另一张独立表格"
              }
            },
            "pagination": {
              "mode": "local",
              "pageSize": 10,
              "numbered": true
            },
            "columns": [
              {
                "field": "name",
                "sortable": true
              },
              {
                "field": {
                  "data": "main",
                  "field": "value",
                  "format": "number-2"
                },
                "title": "金额（元）",
                "sortable": true
              }
            ],
            "fit": "container"
          }
        }
      ]
    }
  ],
  "meta": {
    "title": "表格搜索与导出示例",
    "description": "三层表头与跨行、跨列合并；每张客户表独立搜索和完整匹配结果 Excel 导出。全部使用静态演示数据。"
  }
}
