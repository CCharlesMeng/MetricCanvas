            ]
          },
          "data": {
            "main": "report-summary"
          }
        },
        {
          "id": "kpi-achievement",
          "type": "metricCard",
          "layout": {
            "span": 3
          },
          "props": {
            "variant": "primaryDetail",
            "showTrendArrows": true,
