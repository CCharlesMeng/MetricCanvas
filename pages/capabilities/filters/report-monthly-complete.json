                "scale": 2
              }
            ]
          }
        }
      ]
    },
    {
      "id": "overview",
      "title": "经营总览",
      "container": "plain",
      "components": [
        {
          "id": "kpi-revenue",
          "type": "metricCard",
          "layout": {
            "span": 3
          },
          "props": {
            "variant": "primaryDetail",
            "showTrendArrows": true,
            "rows": [
              {
                "label": "营业收入",
                "valueField": "revenue",
                "changes": [
                  {
                    "label": "环比上月",
                    "field": "revenueChange",
                    "colorRule": {
                      "mode": "sign",
                      "positive": "green",
                      "negative": "red"
                    }
                  }
                ],
                "unit": "万元"
              }
            ]
          },
          "data": {
            "main": "report-summary"
          }
        },
        {
