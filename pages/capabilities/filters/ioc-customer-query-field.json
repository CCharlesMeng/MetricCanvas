{
  "schemaVersion": "6.84",
  "id": "ioc-customer-query-field",
  "layout": "dashboard",
  "meta": {
    "title": "IOC 客户类型固定查询字段（合成数据）"
  },
  "filters": [
    {
      "id": "region",
      "type": "dimension",
      "dimension": "demo_geo",
      "label": "Region",
      "selection": {
        "mode": "single"
      },
      "display": "tree",
      "treeSelection": "level",
      "hierarchy": [
        {
          "id": "geo",
          "dimension": "demo_geo",
          "label": "全球"
        },
        {
          "id": "region-dept",
          "dimension": "demo_region",
          "label": "地区部"
        },
        {
          "id": "office",
          "dimension": "demo_office",
          "label": "代表处"
        }
      ],
      "defaultLevel": "region-dept"
    },
    {
      "id": "key-office",
      "type": "boolean",
      "label": "仅看重点国代",
      "overridesFilters": [
        "region"
      ]
    },
    {
      "id": "mtime",
      "type": "timePoint",
      "granularity": "month",
      "label": "数据月份"
    },
    {
      "id": "customer-category",
      "type": "dimension",
      "dimension": "customer-level",
      "label": "客户类型",
      "selection": {
        "mode": "multiple"
      },
      "options": [
        {
          "value": "战略",
          "label": "战略"
        },
        {
          "value": "卓越",
          "label": "卓越"
        }
      ]
    }
  ],
  "dataSources": {
    "offices": {
      "fields": {
        "office": {
          "type": "string",
          "role": "dimension",
          "queryField": "代表处"
        },
        "amount": {
          "type": "number",
          "role": "measure",
          "queryField": "金额"
        },
        "customer": {
          "type": "string",
          "role": "dimension",
          "queryField": "客户级别"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "代表处",
                  "客户级别"
                ],
                "output_metrics": [
                  "金额"
                ],
                "filter": {
                  "dims": [],
                  "metrics": []
                },
                "order": {}
              }
            ]
          },
          "filterBindings": {
            "region": {
              "target": "dimension",
              "levelQueryFields": {
                "geo": "全球编码",
                "region-dept": "地区部",
                "office": "代表处"
              }
            },
            "key-office": {
              "target": "boolean",
              "queryField": "重点国代",
              "whenTrue": [
                "true"
              ]
            },
            "customer-category": {
              "target": "dimension",
              "queryField": "客户类型"
            },
            "mtime": {
              "target": "timePoint",
              "queryField": "数据月份",
              "valueFormat": "compact"
            }
          }
        }
      }
    }
  },
  "sections": [
    {
      "id": "results",
      "components": [
        {
          "id": "ioc-header",
          "type": "iocHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "identity": {
              "title": "客户类型固定使用客户级别（合成数据）"
            },
            "filterIds": [
              "key-office",
              "mtime",
              "region",
              "customer-category"
            ]
          }
        },
        {
          "id": "office-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "offices"
          },
          "props": {
            "rowKey": "office",
            "columns": [
              {
                "title": "代表处",
                "field": {
                  "data": "main",
                  "field": "office"
                }
              },
              {
                "title": "金额",
                "field": {
                  "data": "main",
                  "field": "amount"
                }
              },
              {
                "title": "客户级别",
                "field": {
                  "data": "main",
                  "field": "customer"
                }
              }
            ],
            "toolbar": {
              "export": {
                "format": "xlsx"
              }
            }
          }
        }
      ]
    }
  ]
}
