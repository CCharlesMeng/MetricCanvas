  },
  "sections": [
    {
      "id": "header",
      "container": "plain",
      "components": [
        {
          "id": "page-header",
          "type": "reportHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "title": "表格搜索与导出示例",
            "subtitle": "25条演示记录。试着搜索“客户25”，或搜索“客户2”后导出 Excel；两张表的搜索互不影响。"
          }
        }
      ]
    },
    {
      "id": "main",
      "components": [
        {
          "id": "records-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "records"
          },
          "props": {
            "title": "客户明细",
            "toolbar": {
              "search": {
                "fields": [
                  "name"
                ],
                "placeholder": "搜索客户"
              },
              "export": {
                "format": "xlsx",
                "filename": "客户明细"
              }
            },
            "pagination": {
              "mode": "local",
              "pageSize": 10,
              "numbered": true
            },
            "columns": [
              {
                "field": "name",
                "sortable": true
              },
              {
                "field": {
                  "data": "main",
                  "field": "value",
                  "format": "number-2"
                },
                "title": "金额（元）",
                "sortable": true
              }
            ],
            "fit": "container"
          }
        },
        {
          "id": "independent-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "records"
          },
          "props": {
            "title": "另一张独立表格",
            "toolbar": {
              "search": {
                "fields": [
                  "name"
                ],
                "placeholder": "搜索客户"
              },
              "export": {
                "format": "xlsx",
                "filename": "另一张独立表格"
              }
            },
            "pagination": {
              "mode": "local",
              "pageSize": 10,
              "numbered": true
            },
            "columns": [
              {
                "field": "name",
                "sortable": true
              },
              {
                "field": {
                  "data": "main",
                  "field": "value",
                  "format": "number-2"
                },
                "title": "金额（元）",
                "sortable": true
              }
            ],
            "fit": "container"
          }
        }
      ]
    }
  ],
  "meta": {
    "title": "表格搜索与导出示例",
    "description": "25条匿名演示记录，展示每张表独立搜索和完整匹配结果Excel导出。"
  }
}
