                  "field": "net-payment-qoq",
                  "format": "percent-1"
                },
                "title": "净付费季环比",
                "sortable": true,
                "align": "right",
                "colorRule": {
                  "mode": "sign",
                  "positive": "green",
                  "negative": "green"
                },
                "visibleWhen": {
                  "filter": "period",
                  "part": "mode",
                  "op": "eq",
                  "value": "quarter"
                }
              },
              {
