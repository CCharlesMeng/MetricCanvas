{
  "schemaVersion": "6.113",
  "id": "rep-business-result-account-detail",
  "meta": {
    "title": "账号明细",
    "description": "代表处账号明细看板，按客户分类和统计期间筛选，展示账号维度的净付费金额、净付费同比、商务券金额及净商务折扣(原价)及其同比环比。"
  },
  "layout": "dashboard",
  "params": {
    "query": {
      "dimensions": [
        {
          "id": "rep-office",
          "dim_name": "代表处"
        },
        {
          "id": "customer-name",
          "dim_name": "客户名称"
        }
      ]
    }
  },
  "filters": [
    {
      "id": "customer-category",
      "type": "dimension",
      "dimension": "customerCategory",
      "label": "客户分类",
      "display": "select",
      "options": [
        {
          "label": "卓越NA",
          "value": "卓越NA"
        },
        {
          "label": "战略NA",
          "value": "战略NA"
        },
        {
          "label": "核心NA",
          "value": "核心NA"
        }
      ]
    },
    {
      "id": "period",
      "type": "timeRange",
      "display": "period",
      "precision": "month",
      "label": "统计期间",
      "required": true,
      "default": {
        "mode": "month"
      },
      "periodModes": [
        "year",
        "quarter",
        "month"
      ]
    }
  ],
