{
  "schemaVersion": "4.0",
  "id": "sales-detail",
  "meta": {
    "description": "承接演示看板的跨页下钻:从 URL 恢复筛选状态,展示区域/渠道明细"
  },
  "dataSources": {
    "gmv": {
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [],
                "output_metrics": [
                  "gmv"
                ],
                "filter": {
                  "time": {
                    "period": "day",
                    "is_aggregate": false,
                    "start": "2026-01-01",
                    "end": "2026-12-31"
                  },
                  "dims": [],
                  "metrics": []
                },
                "order": {}
              }
            ]
          },
          "filterBindings": {
            "f-time": {
              "target": "time"
            },
            "f-region": {
              "target": "dimension",
              "queryField": "region"
            },
            "f-channel": {
              "target": "dimension",
              "queryField": "channel"
            }
          }
        }
      },
      "fields": {
        "gmv": {
          "queryField": "gmv",
          "type": "number",
          "role": "measure",
          "label": "成交总额",
          "defaultFormat": "number-grouped"
        }
      }
    },
    "order-count": {
