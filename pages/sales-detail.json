  "sections": [
    {
      "id": "overview",
      "shell": "panel",
      "components": [
        {
          "id": "page-header",
          "type": "reportHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "title": "销售明细(跨页下钻目标页)",
            "subtitle": "承接演示看板的跨页下钻:从 URL 恢复筛选状态,展示区域/渠道明细"
          }
        },
        {
          "id": "gmv",
          "type": "metricCard",
          "layout": {
            "span": 3
          },
          "data": {
            "main": "gmv"
          },
          "props": {
            "title": "GMV",
            "rows": [
              {
                "label": "GMV",
                "valueField": "gmv"
              }
            ]
          }
        },
        {
          "id": "order-count",
          "type": "metricCard",
          "layout": {
            "span": 3
          },
          "data": {
            "main": "order-count"
          },
          "props": {
            "title": "订单数",
            "rows": [
              {
                "label": "订单数",
                "valueField": "order-count"
              }
            ]
          }
        },
        {
          "id": "by-region",
          "type": "barChart",
          "layout": {
            "span": 6
          },
          "data": {
            "main": "by-region"
          },
          "props": {
            "title": "GMV 按区域(横向,点击柱条页内下钻)",
            "categoryField": "region",
            "series": [
              {
                "field": "gmv"
              }
            ],
            "horizontal": true,
            "rounded": true,
            "actions": [
              {
                "on": "click",
                "writeFilter": "f-region",
                "field": "region"
              }
            ]
          }
        },
        {
          "id": "trend-dual",
          "type": "lineChart",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "trend-dual"
          },
          "props": {
            "title": "GMV 与订单数趋势(双轴)",
            "xField": "mtime",
            "series": [
              {
                "field": "gmv"
              },
              {
                "field": "order-count"
              }
            ],
            "dualAxis": true
          }
        },
        {
          "id": "by-channel",
          "type": "barChart",
          "layout": {
            "span": 6
          },
          "data": {
            "main": "by-channel"
          },
          "props": {
            "title": "GMV 按渠道(点击柱条页内下钻)",
            "categoryField": "channel",
            "series": [
              {
                "field": "gmv"
              }
            ],
            "actions": [
              {
                "on": "click",
                "writeFilter": "f-channel",
                "field": "channel"
              }
            ]
          }
        },
        {
          "id": "detail-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "detail-table"
          },
          "props": {
            "title": "销售明细(查询分页)",
            "columns": [
              {
                "field": "mtime",
                "title": "日期",
                "width": 130,
                "fixed": "left"
              },
              {
                "field": "region",
                "title": "区域",
                "width": 110
              },
              {
                "field": "channel",
                "title": "渠道",
                "width": 110
              },
              {
                "field": "gmv",
                "title": "GMV",
                "width": 130,
                "fixed": "right"
              }
            ],
            "pagination": {
              "mode": "query"
            }
          }
        }
