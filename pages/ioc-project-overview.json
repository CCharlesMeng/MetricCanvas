{
  "schemaVersion": "5.3",
  "id": "ioc-project-overview",
  "layoutForm": "dashboard",
  "meta": {
    "title": "全球/区域作战地图",
    "description": "IOC 作战地图概览页。主数据源全部是 inline，数据行与分类金额均为合成演示数据，不来自真实系统，不得用于业务判断。五个 IOC 维度候选只用于本地 DQE Sim 联调；立项率、分析会召开率、赢单率与复盘率由受控 ratio 算子按 0–100 刻度计算，管道支撑率仍是预计算字段。六个未知区域编码保留 TBD-*；GraphQL、真实编码、认证与权限到位后另行对接。"
  },
  "filters": [
    {
      "id": "mtime",
      "type": "timePoint",
      "granularity": "month",
      "label": "数据月份",
      "default": "2026-04",
      "visible": false
    },
    {
      "id": "key-office",
      "type": "boolean",
      "label": "仅看重点国代"
    },
    {
      "id": "as-of-date",
      "type": "timePoint",
      "granularity": "date",
      "label": "日期",
      "default": "2026-03-26"
    },
    {
      "id": "region",
      "type": "dimension",
    "dimension": "geo-pc-code",
    "label": "区域",
    "emptyLabel": "区域",
    "hierarchyPicker": "hidden",
    "hierarchy": [
        {
          "id": "geo",
          "dimension": "geo-pc-code",
          "label": "全球"
        },
        {
          "id": "region-dept",
          "dimension": "region-dept-code",
          "label": "地区部"
        },
        {
          "id": "office",
          "dimension": "rep-office-code",
          "label": "代表处"
        }
      ],
      "defaultLevel": "geo"
    },
    {
      "id": "project-level",
      "type": "dimension",
      "dimension": "project-initiation-level",
      "label": "项目等级",
      "emptyLabel": "全部项目等级"
    },
    {
      "id": "industry-type",
      "type": "dimension",
      "dimension": "cloud-class",
      "label": "产业",
      "emptyLabel": "全部产业"
    }
  ],
