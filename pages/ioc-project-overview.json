      "compute": [
        {
          "op": "ratio",
          "numerator": "initiated-cnt",
          "denominator": "should-initiate-cnt",
          "output": "project-initiation-rate",
          "onZeroDenominator": "null",
          "scale": 100
        },
        {
          "op": "ratio",
          "numerator": "actual-analysis-meeting-cnt",
          "denominator": "planned-analysis-meeting-cnt",
          "output": "analysis-meeting-rate",
          "onZeroDenominator": "null",
          "scale": 100
        },
        {
          "op": "ratio",
          "numerator": "won-opportunity-cnt",
          "denominator": "resulted-opportunity-cnt",
          "output": "win-rate",
          "onZeroDenominator": "null",
          "scale": 100
        },
        {
          "op": "ratio",
          "numerator": "reviewed-cnt",
          "denominator": "should-review-cnt",
          "output": "review-rate",
          "onZeroDenominator": "null",
          "scale": 100
        }
      ]
