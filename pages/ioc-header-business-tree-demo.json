{
  "schemaVersion": "6.37",
  "id": "ioc-header-business-tree-demo",
  "layout": "dashboard",
  "dashboardToolbar": "hidden",
  "meta": {
    "title": "IOC B2：结构树与候选交集",
    "description": "本地DQE仿真合成验收，条件回显不是业务指标。"
  },
  "iocHeader": {
    "identity": {
      "title": "业务筛选 · 结构树与候选",
      "description": {
        "text": "本地合成验收 · 控件改变真实声明的查询条件"
      },
      "tags": [
        {
          "id": "demo",
          "text": "合成数据",
          "tone": "info"
        }
      ],
      "facts": [
        {
          "id": "period",
          "kind": "queryPeriod",
          "label": "统计期间",
          "value": {
            "filter": "period",
            "format": "period"
          }
        }
      ]
    },
    "filterIds": [
      "period",
      "region",
      "model",
      "legacy"
    ],
    "presentation": {
      "density": "compact",
      "collapse": "firstRow"
    }
  },
  "filters": [
    {
      "id": "period",
      "type": "timeRange",
      "display": "period",
      "precision": "month",
      "required": true,
      "label": "统计期间",
      "default": {
        "mode": "month",
        "value": "2026-09"
      }
    },
    {
      "id": "region",
      "type": "dimension",
      "dimension": "b2_department",
      "label": "区域结构",
      "display": "tree",
      "treeSelection": "level",
      "hierarchy": [
        {
          "id": "department",
          "dimension": "b2_department",
          "label": "地区部"
        },
        {
          "id": "office",
          "dimension": "b2_office",
          "label": "代表处"
        }
      ],
      "defaultLevel": "department",
      "default": [
        "same"
      ],
      "hint": "地区部和代表处可使用相同业务码；只选择当前层自身。"
    },
    {
      "id": "model",
      "type": "dimension",
      "dimension": "b2_model",
      "label": "模型",
      "display": "search",
      "selection": {
        "mode": "multiple"
      },
      "candidateContext": {
        "filterIds": [
          "period",
          "region"
        ],
        "reconcile": "intersection"
      },
      "default": [
        "A",
        "B"
      ],
      "hint": "变更期间后等待可信候选，只保留合法交集；空交集继续等待确认。"
    },
    {
      "id": "legacy",
      "type": "dimension",
      "dimension": "ioc-header-legacy-path",
      "label": "旧树兼容",
      "display": "tree"
    }
  ],
  "dataSources": {
    "bound": {
      "fields": {
        "scope": {
          "type": "string",
          "role": "dimension",
          "queryField": "ioc_header_scope"
        },
        "count": {
          "type": "number",
          "role": "measure",
          "queryField": "ioc_header_count"
        },
        "department_code": {
          "type": "string",
          "role": "dimension",
          "queryField": "department_code",
          "nullable": true
        },
        "office_code": {
          "type": "string",
          "role": "dimension",
          "queryField": "office_code",
          "nullable": true
        },
        "model_code": {
          "type": "string",
          "role": "dimension",
          "queryField": "model_code",
          "nullable": true
        },
        "legacy_path": {
          "type": "string",
          "role": "dimension",
          "queryField": "legacy_path",
          "nullable": true
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "ioc_header_scope",
                  "department_code",
                  "office_code",
                  "model_code",
                  "legacy_path"
                ],
                "output_metrics": [
                  "ioc_header_count"
                ],
                "filter": {
                  "dims": [],
                  "time": {
                    "period": "month",
                    "is_aggregate": false
                  }
                },
                "order": {
                  "limit": 10,
                  "offset": 0
                }
              }
            ]
          },
          "filterBindings": {
            "period": {
              "target": "time"
            },
            "region": {
              "target": "dimension",
              "levelQueryFields": {
                "department": "department_code",
                "office": "office_code"
              }
            },
            "model": {
              "target": "dimension",
              "queryField": "model_code"
            },
            "legacy": {
              "target": "dimension",
              "queryField": "legacy_path"
            }
          }
        }
      }
    },
    "unbound": {
      "fields": {
        "scope": {
          "type": "string",
          "role": "dimension",
          "queryField": "ioc_header_scope"
        },
        "count": {
          "type": "number",
          "role": "measure",
          "queryField": "ioc_header_count"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "ioc_header_scope"
                ],
                "output_metrics": [
                  "ioc_header_count"
                ],
                "filter": {
                  "dims": []
                },
                "order": {
                  "limit": 10,
                  "offset": 0
                }
              }
            ]
          }
        }
      }
    }
  },
  "sections": [
    {
      "id": "body",
      "container": "card",
      "components": [
        {
          "id": "bound-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "bound"
          },
          "props": {
            "title": "已绑定条件",
            "columns": [
              {
                "field": "scope",
                "title": "服务收到的条件（本地合成）"
              },
              {
                "field": "count",
                "title": "合成响应标识"
              }
            ],
            "pagination": {
              "mode": "query"
            },
            "toolbar": {
              "export": {
                "format": "xlsx",
                "filename": "本地页头验收"
              }
            }
          }
        },
        {
          "id": "unbound-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "unbound"
          },
          "props": {
            "title": "无关查询（不随筛选刷新）",
            "columns": [
              {
                "field": "scope",
                "title": "服务收到的条件（本地合成）"
              },
              {
                "field": "count",
                "title": "合成响应标识"
              }
            ],
            "pagination": {
              "mode": "query"
            },
            "toolbar": {
              "export": {
                "format": "xlsx",
                "filename": "本地页头验收"
              }
            }
          }
        }
      ]
    }
  ]
}
