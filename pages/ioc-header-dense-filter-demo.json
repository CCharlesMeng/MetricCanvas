{
  "schemaVersion": "6.36",
  "id": "ioc-header-dense-filter-demo",
  "layout": "dashboard",
  "dashboardToolbar": "hidden",
  "meta": {
    "title": "IOC 公共页头：密集与依赖验收",
    "description": "本地DQE仿真合成验收，条件回显不是业务指标。"
  },
  "iocHeader": {
    "identity": {
      "title": "机会点清单 · 密集筛选与递归依赖",
      "description": {
        "text": "本地合成验收 · 控件改变真实声明的查询条件"
      },
      "tags": [
        {
          "id": "demo",
          "text": "合成数据",
          "tone": "info"
        }
      ],
      "facts": [
        {
          "id": "period",
          "kind": "queryPeriod",
          "label": "统计期间",
          "value": {
            "filter": "period",
            "format": "period"
          }
        }
      ]
    },
    "filterIds": [
      "period",
      "region",
      "department",
      "office",
      "month",
      "flag",
      "amount",
      "extra"
    ],
    "presentation": {
      "density": "compact",
      "collapse": "firstRow"
    }
  },
  "filters": [
    {
      "id": "period",
      "type": "timeRange",
      "display": "period",
      "precision": "month",
      "required": true,
      "label": "统计期间",
      "default": {
        "mode": "month",
        "value": "2026-09"
      }
    },
    {
      "id": "region",
      "type": "dimension",
      "dimension": "geo-pc-code",
      "label": "区域"
    },
    {
      "id": "department",
      "type": "dimension",
      "dimension": "region-dept-code",
      "label": "地区部",
      "dependsOn": "region"
    },
    {
      "id": "office",
      "type": "dimension",
      "dimension": "rep-office-code",
      "label": "代表处",
      "dependsOn": "department"
    },
    {
      "id": "month",
      "type": "timePoint",
      "granularity": "month",
      "default": "2026-09",
      "label": "对照单月"
    },
    {
      "id": "flag",
      "type": "boolean",
      "label": "仅看重点"
    },
    {
      "id": "amount",
      "type": "numberRange",
      "label": "规模范围"
    },
    {
      "id": "extra",
      "type": "timeRange",
      "precision": "date",
      "label": "对照日期",
      "default": {
        "from": "2026-09-01",
        "to": "2026-09-30"
      }
    }
  ],
  "dataSources": {
    "bound": {
      "fields": {
        "scope": {
          "type": "string",
          "role": "dimension",
          "queryField": "ioc_header_scope"
        },
        "count": {
          "type": "number",
          "role": "measure",
          "queryField": "ioc_header_count"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "ioc_header_scope"
                ],
                "output_metrics": [
                  "ioc_header_count"
                ],
                "filter": {
                  "dims": [],
                  "time": {
                    "period": "month",
                    "is_aggregate": false
                  }
                },
                "order": {
                  "limit": 10,
                  "offset": 0
                }
              }
            ]
          },
          "filterBindings": {
            "period": {
              "target": "time"
            },
            "region": {
              "target": "dimension",
              "queryField": "geo_pc_code"
            },
            "department": {
              "target": "dimension",
              "queryField": "region_dept_code"
            },
            "office": {
              "target": "dimension",
              "queryField": "rep_office_code"
            },
            "month": {
              "target": "timePoint",
              "queryField": "mtime",
              "valueFormat": "compact"
            },
            "flag": {
              "target": "boolean",
              "queryField": "key_flag",
              "whenTrue": [
                "1"
              ],
              "whenFalse": [
                "0"
              ]
            },
            "amount": {
              "target": "numberRange",
              "metric": "ioc_header_count"
            }
          }
        }
      }
    },
    "unbound": {
      "fields": {
        "scope": {
          "type": "string",
          "role": "dimension",
          "queryField": "ioc_header_scope"
        },
        "count": {
          "type": "number",
          "role": "measure",
          "queryField": "ioc_header_count"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "ioc_header_scope"
                ],
                "output_metrics": [
                  "ioc_header_count"
                ],
                "filter": {
                  "dims": []
                },
                "order": {
                  "limit": 10,
                  "offset": 0
                }
              }
            ]
          }
        }
      }
    }
  },
  "sections": [
    {
      "id": "body",
      "container": "card",
      "components": [
        {
          "id": "bound-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "bound"
          },
          "props": {
            "title": "已绑定条件",
            "columns": [
              {
                "field": "scope",
                "title": "服务收到的条件（本地合成）"
              },
              {
                "field": "count",
                "title": "合成响应标识"
              }
            ],
            "pagination": {
              "mode": "query"
            },
            "toolbar": {
              "export": {
                "format": "xlsx",
                "filename": "本地页头验收"
              }
            }
          }
        },
        {
          "id": "unbound-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "unbound"
          },
          "props": {
            "title": "无关查询（不随筛选刷新）",
            "columns": [
              {
                "field": "scope",
                "title": "服务收到的条件（本地合成）"
              },
              {
                "field": "count",
                "title": "合成响应标识"
              }
            ],
            "pagination": {
              "mode": "query"
            },
            "toolbar": {
              "export": {
                "format": "xlsx",
                "filename": "本地页头验收"
              }
            }
          }
        }
      ]
    }
  ]
}
