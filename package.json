{
  "name": "metriccanvas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter platform --filter @metriccanvas/dqe-sim dev",
    "dev:dqe": "tsx tools/dqe-sim/src/dev.ts",
    "dev:playground": "pnpm --filter playground dev",
    "dev:platform": "pnpm --filter platform dev",
    "dev:assets": "tsx apps/platform/scripts/dev-page-assets.ts",
    "build": "pnpm build:packages && pnpm --filter @metriccanvas/embed build && pnpm --filter platform build",
    "test": "pnpm --filter playground exec svelte-kit sync && vitest run",
    "test:embed": "pnpm --filter @metriccanvas/embed test:browser",
    "validate": "tsx packages/page/src/validate-cli.ts",
    "design:facts": "tsx tools/design-facts/src/cli.ts",
    "design:facts:check": "tsx tools/design-facts/src/cli.ts --check",
    "adr:index": "python3 tools/scripts/adr-index.py",
    "adr:index:check": "python3 tools/scripts/adr-index.py --check",
    "authoring:contracts": "tsx tools/scripts/export-authoring-contracts.ts",
    "authoring:contracts:check": "tsx tools/scripts/export-authoring-contracts.ts --check",
    "authoring:test": "PYTHONDONTWRITEBYTECODE=1 python3 metriccanvas-authoring/test-harness/run_tests.py",
    "authoring:check": "pnpm test tests/local-authoring-tools.test.ts tests/local-authoring-skill.test.ts tests/local-authoring-upgrade.test.ts tests/page-reference.test.ts tests/authoring-export-isolation.test.ts",
    "sim:dqe": "tsx tools/dqe-sim/src/server.ts",
    "check": "tsc --noEmit -p tools/package-build && tsc --noEmit -p tests/tsconfig.json && pnpm -r check",
    "build:playground": "pnpm --filter playground build",
    "build:packages": "pnpm --filter @metriccanvas/ui --filter @metriccanvas/data-execution --filter @metriccanvas/page --filter @metriccanvas/engine --filter @metriccanvas/metric-canvas -r build",
    "packages:check": "tsx tools/package-build/check.ts",
    "compatibility:check": "node tools/package-build/compatibility.mjs",
    "ci:wait": "node tools/scripts/wait-ci.mjs",
    "test:ui": "pnpm --filter @metriccanvas/ui test:browser",
    "report-pdf:build": "node tools/scripts/build-report-pdf.mjs",
    "report-pdf:check": "node tools/scripts/build-report-pdf.mjs --check",
    "mc:content:test": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s metriccanvas-authoring/test-harness/tests -p test_mc_content.py",
    "mc:content:fixtures": "PYTHONDONTWRITEBYTECODE=1 python3 tools/scripts/mc-content-fixtures.py",
    "mc:content:coverage": "tsx tools/scripts/export-authoring-contracts.ts --mc-coverage",
    "mc:content:check": "pnpm authoring:contracts:check && pnpm mc:content:coverage && pnpm mc:content:test && python3 tools/scripts/mc-content-fixtures.py --check",
    "mc:content:pack": "python3 tools/scripts/mc-content-pack.py",
    "mc:content:benchmark": "python3 tools/scripts/mc-content-benchmark.py"
  },
  "devDependencies": {
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "^24.13.4",
    "esbuild": "0.28.1",
    "svelte": "5.56.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "8.1.5",
    "vitest": "^4.1.11",
    "yaml": "2.9.0"
  }
}
