{
  "name": "metriccanvas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx tools/dev-cli/src/dev.ts local",
    "dev:offline": "tsx tools/dev-cli/src/dev.ts offline",
    "dev:dqe": "tsx tools/dqe-sim/src/dev.ts",
    "dev:runtime": "pnpm --filter canvas dev",
    "dev:platform": "pnpm --filter platform dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build": "pnpm --filter @metriccanvas/embed build && pnpm --filter canvas build && pnpm --filter platform build",
    "test": "pnpm --filter platform --filter canvas exec svelte-kit sync && vitest run",
    "test:embed": "pnpm --filter @metriccanvas/embed test:browser",
    "validate": "tsx packages/page/src/validate-cli.ts",
    "design:facts": "tsx tools/design-facts/src/cli.ts",
    "design:facts:check": "tsx tools/design-facts/src/cli.ts --check",
    "authoring:contracts": "tsx tools/scripts/export-authoring-contracts.ts",
    "authoring:contracts:check": "tsx tools/scripts/export-authoring-contracts.ts --check",
    "authoring:test": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s metriccanvas-authoring/test-harness/tests -p 'test_*.py'",
    "authoring:check": "python3 metriccanvas-authoring/scripts/check_bundle.py && pnpm authoring:test",
    "sim:dqe": "tsx tools/dqe-sim/src/server.ts",
    "check": "pnpm -r check"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
