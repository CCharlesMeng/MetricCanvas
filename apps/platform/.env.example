# 仅浏览器工作台开发构建可启用；脱敏后的生效 DQE 项写入浏览器 debug 控制台。
# 当前修订预览与生产构建不消费这些开关。采样率限制在 [0, 1]，非数值不记录。
VITE_DQE_DEV_DETAIL=0
VITE_DQE_DEV_DETAIL_SAMPLE_RATE=1

# 构建期路由前缀，须通过构建命令环境传入（默认空；非空值形如 /metriccanvas）。
# 例：METRICCANVAS_BASE_PATH=/metriccanvas pnpm --filter platform build
# 微前端构建忽略此项，使用门户运行时 routeBase；独立构建用此前缀。
# 生产端点与用户身份不是构建环境变量，由集成门户运行时注入。
METRICCANVAS_BASE_PATH=

# 本地运行配置 mock：复制为 .env.local 后填写，仅 DEV 入口消费，已有门户注入时不覆盖。
# 留空使用本地默认值；cftk 留空则不发送。假 cftk 只用于模拟，真实联调需有效值。
# VITE_* 在开发浏览器可见；真实凭据仅放已被 git 忽略的 .env.local，勿提交。
VITE_LOCAL_PAGE_METADATA_BASE_URL=
VITE_LOCAL_CFTK=
VITE_LOCAL_AUTH_TOKEN=
VITE_LOCAL_OPERATOR_ID=
VITE_LOCAL_WORKSPACE_ID=
VITE_LOCAL_DQE_ENDPOINT=

# 与 Playground 相同的 Windows gray 调测：仅 vite dev 生效，构建和 preview 忽略。
# 启用后仍访问 https://localhost:5174；可通过 pnpm --filter platform dev --port 5188 指定端口。
PLATFORM_CLOUDIOC=false
# 必填：gray 站点 localStorage.cftk 的原始值，由 Vite 代理发送。
PLATFORM_CLOUDIOC_CFTK=""
# 可选：gray 成功请求的完整 Cookie 值（不含 Cookie:），留空沿用浏览器 Cookie。
# Cookie 与 CFTK 仅转发至 gray 服务前缀，不注入浏览器代码；修改后重启。
PLATFORM_CLOUDIOC_COOKIE=""
