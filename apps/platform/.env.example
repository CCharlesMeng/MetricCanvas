DATABASE_URL=postgres://metriccanvas:metriccanvas@localhost:5432/metriccanvas
# 部署角色:authoring 保持当前工作台行为;reader 只构造发布页读取与取数能力。
METRICCANVAS_ROLE=authoring
# reader 必须使用单独的数据库只读账号；reader 角色缺失此项时启动失败。
# 只读权限由部署方在数据库中授予，平台不代替 DBA 创建账号。
METRICCANVAS_READER_DATABASE_URL=
PLATFORM_ORIGIN=http://localhost:5174
RUNTIME_ORIGIN=http://localhost:5173

# 设为 1 时使用进程内页面生命周期和仓库元数据快照；通常直接运行 pnpm dev:offline。
METRICCANVAS_OFFLINE=0

# 旧页面资产适配器：postgres(缺省)或 java，待 #105 新接口消费验证后退出。java 仍调用旧的四个
# Interface(保存 / 最新 / 精确修订 / 目录),发布、回滚、历史、差异如实返回 NOT_SUPPORTED(HTTP 501),
# java 不需要 DATABASE_URL。base URL 含 {service} 前缀。
METRICCANVAS_PAGE_ASSETS=postgres
METRICCANVAS_PAGE_ASSETS_BASE_URL=http://127.0.0.1:8080/rest/cdi/pageassets/v1
# 读接口没有请求级身份时使用的服务态 X-Operator-Id(只出现在请求头,不写入修订)。
METRICCANVAS_PAGE_ASSETS_READ_OPERATOR=platform

# 构建期路由前缀，须通过构建命令环境传入（默认空；非空值形如 /metriccanvas）。
# 例：METRICCANVAS_BASE_PATH=/metriccanvas pnpm --filter platform build
# 不能据此宣称支持 qiankun 在运行时分配的路由前缀。
