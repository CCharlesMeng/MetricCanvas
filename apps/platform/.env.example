# 仅浏览器工作台开发构建可启用；脱敏后的生效 DQE 项写入浏览器 debug 控制台。
# 当前修订预览与生产构建不消费这些开关。采样率限制在 [0, 1]，非数值不记录。
VITE_DQE_DEV_DETAIL=0
VITE_DQE_DEV_DETAIL_SAMPLE_RATE=1

# 构建期路由前缀，须通过构建命令环境传入（默认空；非空值形如 /metriccanvas）。
# 例：METRICCANVAS_BASE_PATH=/metriccanvas pnpm --filter platform build
# 不能据此宣称支持 qiankun 在运行时分配的路由前缀。
# 生产端点与用户身份不是构建环境变量，由集成门户运行时注入。
METRICCANVAS_BASE_PATH=
