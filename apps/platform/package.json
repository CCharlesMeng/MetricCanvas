{
  "name": "platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview --port 4174",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "build:microfrontend": "vite build --mode microfrontend",
    "build:microfrontend:debug": "vite build --mode microfrontend-debug",
    "pack:microfrontend": "pnpm build:microfrontend && node scripts/pack-microfrontend.mjs",
    "pack:microfrontend:debug": "pnpm build:microfrontend:debug && node scripts/pack-microfrontend.mjs --debug",
    "pack:microfrontend:all": "pnpm pack:microfrontend && pnpm pack:microfrontend:debug",
    "pack:deployment": "node scripts/pack-deployment.mjs",
    "test:microfrontend": "cd ../.. && node apps/platform/tests/microfrontend/production-browser.mjs",
    "test:pangu-deployment": "cd ../.. && node apps/platform/tests/microfrontend/pangu-deployment-browser.mjs",
    "test:microfrontend:debug": "cd ../.. && MICROFRONTEND_PROFILE=debug DEPLOYMENT_ADAPTER_TEST=1 node apps/platform/tests/microfrontend/production-browser.mjs && node apps/platform/tests/microfrontend/debug-browser.mjs",
    "dev:agent-flow": "vite --config tests/agent-flow/vite.config.ts",
    "dev:local": "vite --mode local-preview"
  },
  "dependencies": {
    "@metriccanvas/application-runtime": "workspace:*",
    "@metriccanvas/engine": "workspace:*",
    "@metriccanvas/metric-canvas": "workspace:*",
    "@metriccanvas/page": "workspace:*",
    "@metriccanvas/ui": "workspace:0.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "qiankun": "2.10.16",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "vite": "^8.1.5"
  }
}
