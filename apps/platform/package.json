{
  "name": "platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5174",
    "build": "vite build",
    "preview": "vite preview --port 4174",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "build:microfrontend": "vite build --mode microfrontend",
    "pack:microfrontend": "pnpm build:microfrontend && node scripts/pack-microfrontend.mjs",
    "pack:deployment": "node scripts/pack-deployment.mjs",
    "test:microfrontend": "cd ../.. && node apps/platform/tests/microfrontend/production-browser.mjs"
  },
  "dependencies": {
    "@metriccanvas/application-runtime": "workspace:*",
    "@metriccanvas/engine": "workspace:*",
    "@metriccanvas/metric-canvas": "workspace:*",
    "@metriccanvas/page": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "qiankun": "2.10.16",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "vite": "^8.1.5"
  }
}
