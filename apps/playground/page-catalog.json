        "data": "合成演示",
        "runtime": "sim",
        "scope": "首屏可预览；动态查询需仿真"
      },
      "guide": {
        "steps": [
          "检查八行数值依次为 10.0、—、—、12.5、0.0、-4.0、—、—。",
          "排序后检查八行仍保留，比较缺失指标卡与真实 0% 的区别。"
        ],
        "configPaths": [
          "dataSources.*.fields",
          "dataSources.*.source.initial"
