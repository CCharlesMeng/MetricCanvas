{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mustBe": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "mustBe"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scene": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "templateVersion": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "object"
        },
        "section": {
          "type": "object"
        },
        "block": {
          "type": "object"
        }
      },
      "required": [
        "page",
        "section",
        "block"
      ]
    },
    "hardPins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productMandatory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pin"
          }
        }
      },
      "required": [
        "productMandatory"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "container": {
            "type": "string"
          },
          "suggested": {
            "type": "boolean"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "width": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "dataRole": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ]
            }
          }
        },
        "required": [
          "id",
          "pattern",
          "blocks"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "scene",
    "variant",
    "templateVersion",
    "defaults",
    "hardPins",
    "sections"
  ]
}
