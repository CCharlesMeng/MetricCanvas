<?xml version="1.0" encoding="UTF-8"?>
<!--
  独立部署时的启动 module：只有 StartUp、Dockerfile 与启动脚本（ADR-0062）。
  并入 CDINL2DataBuilderService 时整个 module 丢弃。交付形态跟随公司：tar.gz（lib/ + script/）
  + 以 classpath 方式启动，不用 Spring Boot fat jar；日志用 Log4j2。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.huawei.cdi</groupId>
    <artifactId>metriccanvas-page-assets</artifactId>
    <version>0.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>page-assets-bootstrap</artifactId>
  <name>Page Assets :: Bootstrap</name>

  <dependencies>
    <dependency>
      <groupId>com.huawei.cdi</groupId>
      <artifactId>page-assets-model</artifactId>
    </dependency>
    <dependency>
      <groupId>com.huawei.cdi</groupId>
      <artifactId>page-assets-service</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-log4j2</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <descriptors>
            <descriptor>assembly.xml</descriptor>
          </descriptors>
          <appendAssemblyId>false</appendAssemblyId>
        </configuration>
        <executions>
          <execution>
            <id>package-tar</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
