            "role": "dimension",
            "nullable": false
          },
          "city": {
            "queryField": "city",
            "type": "string",
            "role": "dimension"
          },
          "stat-date": {
            "queryField": "stat_date",
            "type": "date",
            "role": "dimension",
            "nullable": false
          },
          "amount": {
            "queryField": "amount",
            "type": "money",
            "role": "measure",
            "currency": "CNY",
            "nullable": false
          },
          "orders": {
            "queryField": "order_cnt",
            "type": "number",
            "role": "measure"
          }
        },
        "source": {
          "type": "query",
          "initial": {
            "capturedAt": "2026-08-01T00:00:00Z",
            "rows": [
              {
                "region": "华东",
                "city": "上海",
                "stat_date": "2026-07-31",
                "amount": 120.5,
                "order_cnt": 3
              },
              {
                "region": "华北",
                "city": "北京",
                "stat_date": "2026-07-30",
                "amount": 80,
                "order_cnt": null
              }
            ]
          },
          "query": {
            "language": "dqe",
            "body": {
              "dsl_list": [
                {
                  "output_dims": [
                    "region",
                    "city",
                    "stat_date"
                  ],
                  "output_metrics": [
                    "amount",
