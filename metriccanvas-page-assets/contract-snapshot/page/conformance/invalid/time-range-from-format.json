{
  "case": "time-range-from-format",
  "invariant": "time-range-default-calendar",
  "input": {
    "schemaVersion": "5.3",
    "id": "filters-page",
    "meta": {
      "description": "六类筛选器、层级与级联、筛选绑定、查询分页与表格选择写回的契约样例"
