      ],
      "collect": {
        "kind": "count"
      }
    },
    "R1-1-type": {
      "locators": [
        {
          "strategy": "css",
          "selector": "aside[aria-label=\"检查器\"] .selection-type"
        }
      ],
      "collect": {
        "kind": "count"
      }
    },
    "R1-1-summary": {
      "locators": [
        {
          "strategy": "css",
          "selector": "aside[aria-label=\"检查器\"] .selbar"
        }
      ],
      "collect": {
        "kind": "count"
      }
    },
    "R1-1-duplicate-title": {
      "locators": [
        {
          "strategy": "css",
          "selector": "aside[aria-label=\"检查器\"] .selbar b"
        }
      ],
      "collect": {
        "kind": "count"
      }
    },
    "R1-1-technical-id": {
      "locators": [
        {
          "strategy": "css",
