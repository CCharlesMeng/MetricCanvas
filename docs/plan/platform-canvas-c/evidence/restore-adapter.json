      "locators": [
        {
          "strategy": "css",
          "selector": ".selection-actions"
        }
      ],
      "collect": {
        "kind": "count"
      }
    },
    "R2-1-back": {
      "locators": [
        {
          "strategy": "css",
          "selector": "aside[aria-label=\"检查器\"] .selection-header .back-link"
        }
      ],
      "collect": {
        "kind": "text",
        "single": true
      }
    },
    "R2-1-type": {
      "locators": [
        {
          "strategy": "css",
          "selector": "aside[aria-label=\"检查器\"] .selection-type"
        }
      ],
      "collect": {
        "kind": "text",
        "single": true
      }
    },
    "R2-1-tabs": {
      "locators": [
        {
          "strategy": "css",
          "selector": "aside[aria-label=\"检查器\"] .panel-tabs button"
