    "R1-3-preview-selection": {
      "locators": [
        {
          "strategy": "css",
          "selector": ".authoring-selected"
        }
      ],
      "collect": {
        "kind": "count"
      }
    },
    "R1-3-preview-toolbar": {
      "locators": [
        {
          "strategy": "css",
          "selector": ".selection-actions"
        }
