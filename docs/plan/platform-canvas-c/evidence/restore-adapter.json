      "locators": [
        {
          "strategy": "css",
          "selector": ".selection-actions:popover-open button"
        }
      ],
      "collect": {
        "kind": "text",
        "single": false
      }
    },
    "R4-1-radius": {
      "locators": [
        {
          "strategy": "css",
          "selector": ".authoring-selected"
        }
      ],
      "collect": {
        "kind": "style",
        "single": true,
        "properties": [
          "border-top-left-radius"
        ]
      }
    },
    "R4-1-padding": {
      "locators": [
        {
          "strategy": "css",
          "selector": ".authoring-selected"
        }
      ],
      "collect": {
        "kind": "style",
        "single": true,
        "properties": [
          "padding-top"
        ],
        "pseudo": "::after"
      }
    },
    "R4-1-gradient": {
      "locators": [
        {
          "strategy": "css",
          "selector": ".authoring-selected"
        }
      ],
      "collect": {
        "kind": "style",
        "single": true,
        "properties": [
          "background-image"
        ],
        "pseudo": "::after"
      }
    },
    "R4-1-pointer-events": {
      "locators": [
        {
          "strategy": "css",
          "selector": ".authoring-selected"
        }
      ],
      "collect": {
        "kind": "style",
        "single": true,
        "properties": [
          "pointer-events"
        ],
        "pseudo": "::after"
      }
    },
    "R4-1-fill": {
      "locators": [
        {
          "strategy": "css",
          "selector": ".authoring-selected"
        }
      ],
      "collect": {
        "kind": "style",
        "single": true,
        "properties": [
          "background-image"
        ]
      }
    },
    "R4-1-shadow": {
      "locators": [
        {
          "strategy": "css",
          "selector": ".authoring-selected"
        }
      ],
      "collect": {
        "kind": "style",
        "single": true,
        "properties": [
          "box-shadow"
        ]
      }
    }
