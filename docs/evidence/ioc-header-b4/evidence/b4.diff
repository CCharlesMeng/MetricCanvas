+/** Test host owned trusted input, deliberately outside Page/URL. Local synthetic only. */
+export function createTimeInputs(){
+ let snapshot={contextRevision:'synthetic-user-1',timeZone:'Asia/Shanghai',periods:{sales:{status:'ready',granularity:'month',latest:'2026-10',latestComplete:'2026-09',missingRanges:[{from:'2026-07',to:'2026-07'}],refreshedAt:'2026-10-19T02:00:00Z',generatedAt:'2026-10-19T03:00:00Z'}}};
+ const listeners=new Set();
+ return {getSnapshot:()=>structuredClone(snapshot),subscribe(listener){listeners.add(listener);return()=>listeners.delete(listener);},setSnapshot(next){snapshot=structuredClone(next);for(const listener of listeners)listener();},setStatus(status){this.setSnapshot({...snapshot,periods:{...snapshot.periods,sales:{status}}});},reset(){this.setSnapshot({...snapshot,periods:{sales:{status:'ready',granularity:'month',latest:'2026-10',latestComplete:'2026-09',missingRanges:[{from:'2026-07',to:'2026-07'}],refreshedAt:'2026-10-19T02:00:00Z',generatedAt:'2026-10-19T03:00:00Z'}}});}};
+}
