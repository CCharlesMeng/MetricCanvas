+            ]
+          }
+        },
+        {
+          "id": "amount-chart",
+          "type": "barChart",
+          "layout": {
+            "span": 8
+          },
+          "data": {
+            "main": "main"
+          },
+          "props": {
+            "title": "各项目含费用金额",
+            "categoryField": "project",
+            "series": [
+              {
+                "field": {
+                  "byFilter": {
+                    "filterId": "currency",
+                    "cases": {
+                      "RMB": {
+                        "data": "main",
+                        "field": "total-cny",
+                        "format": "number-grouped"
+                      },
+                      "USD": {
+                        "data": "main",
+                        "field": "total-usd",
+                        "format": "number-grouped"
+                      }
+                    }
+                  }
+                }
+              }
+            ]
+          }
+        },
+        {
+          "id": "amount-table",
+          "type": "table",
+          "layout": {
+            "span": 12
+          },
+          "data": {
+            "main": "main"
+          },
+          "props": {
+            "title": "金额明细（查询后分别计算两种静态货币）",
