+            "pagination": {
+              "mode": "local",
+              "pageSize": 20
+            },
+            "toolbar": {
+              "export": {
+                "format": "xlsx",
+                "filename": "金额验收"
+              }
+            }
+          }
+        },
+        {
+          "id": "unbound-table",
+          "type": "table",
+          "layout": {
+            "span": 12
+          },
+          "data": {
+            "main": "unbound"
+          },
