+              },
+              {
+                "field": {
+                  "byFilter": {
+                    "filterId": "currency",
+                    "cases": {
+                      "RMB": {
+                        "data": "main",
+                        "field": "base-cny",
+                        "format": "number-grouped"
+                      },
+                      "USD": {
+                        "data": "main",
+                        "field": "base-usd",
+                        "format": "number-grouped"
+                      }
+                    }
+                  }
+                },
+                "title": "预签金额",
+                "sortable": true,
+                "filterable": {
+                  "mode": "numberRange"
+                }
+              },
+              {
+                "field": {
+                  "byFilter": {
+                    "filterId": "currency",
