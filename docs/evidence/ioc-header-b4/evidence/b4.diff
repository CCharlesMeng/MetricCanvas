+          "defaultFormat": "number-grouped",
+          "nullable": true
+        },
+        "base-usd": {
+          "type": "money",
+          "role": "measure",
+          "currency": "USD",
+          "unit": "美元",
+          "label": "预签金额",
+          "defaultFormat": "number-grouped",
+          "nullable": true,
+          "queryField": "ioc_amount_base_usd"
