+        "type": "query",
+        "resultScope": "complete",
+        "query": {
+          "language": "dqe",
+          "timeModes": {
+            "filterId": "period",
+            "cases": {
+              "month": {
+                "body": {
+                  "dsl_list": [
+                    {
+                      "output_dims": [
+                        "ioc_amount_project",
+                        "ioc_amount_scope"
