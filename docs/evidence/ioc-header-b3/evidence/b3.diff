+            "title": "各项目含费用金额",
+            "categoryField": "project",
+            "series": [
+              {
+                "field": {
+                  "byFilter": {
+                    "filterId": "currency",
+                    "cases": {
+                      "RMB": {
+                        "data": "main",
+                        "field": "total-cny",
+                        "format": "number-grouped"
+                      },
+                      "USD": {
+                        "data": "main",
