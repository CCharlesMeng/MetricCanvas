+          "id": "large",
+          "label": "100万及以上",
+          "range": {
+            "from": 100
+          }
+        },
+        {
+          "id": "small",
+          "label": "0至50万",
+          "range": {
+            "from": 0,
+            "to": 50
+          }
+        }
+      ],
+      "clearOnChangeOf": [
