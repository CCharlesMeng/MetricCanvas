+                    }
+                  }
+                }
+              }
+            ]
+          }
+        },
+        {
+          "id": "amount-table",
+          "type": "table",
+          "layout": {
+            "span": 12
+          },
+          "data": {
+            "main": "main"
+          },
+          "props": {
+            "title": "金额明细（查询后分别计算两种静态货币）",
+            "rowKey": "project",
+            "columns": [
+              {
+                "field": "project",
