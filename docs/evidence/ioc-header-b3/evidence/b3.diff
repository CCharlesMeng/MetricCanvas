+{
+  "schemaVersion": "6.34",
+  "id": "currency-selection-page",
+  "layout": "dashboard",
+  "dashboardToolbar": "hidden",
+  "meta": {
+    "title": "IOC B3：金额与币种",
+    "description": "本地合成双货币字段，不代表真实USD业务数据；没有前端汇率换算。"
+  },
+  "iocHeader": {
+    "identity": {
+      "title": "金额与币种",
+      "description": {
+        "text": "独立静态人民币/美元字段 · 输入以万元/万美元，查询保留基本单位"
+      },
+      "tags": [
+        {
+          "id": "demo",
+          "text": "合成数据",
+          "tone": "info"
+        }
+      ],
+      "facts": [
+        {
+          "id": "period",
+          "kind": "queryPeriod",
+          "label": "统计期间",
+          "value": {
+            "filter": "period",
+            "format": "period"
+          }
+        }
+      ]
+    },
+    "filterIds": [
+      "period",
+      "currency",
+      "amount"
+    ]
+  },
+  "filters": [
+    {
+      "id": "period",
+      "type": "timeRange",
+      "display": "period",
+      "precision": "month",
+      "required": true,
+      "label": "统计期间",
+      "default": {
+        "mode": "month",
+        "value": "2026-09"
+      }
+    },
+    {
+      "id": "currency",
+      "type": "dimension",
+      "dimension": "currency_code",
+      "label": "币种",
+      "selection": {
+        "mode": "single",
+        "required": true
+      },
+      "options": [
+        {
+          "value": "RMB",
+          "label": "人民币"
+        },
+        {
+          "value": "USD",
+          "label": "美元"
+        }
+      ],
+      "default": [
+        "RMB"
+      ]
+    },
+    {
+      "id": "amount",
+      "type": "numberRange",
+      "label": "预签金额",
+      "constraints": {
+        "min": 0,
+        "bounds": "strict"
+      },
+      "units": {
+        "filterId": "currency",
+        "cases": {
+          "RMB": {
+            "currency": "CNY",
+            "label": "万元",
+            "scale": 10000
+          },
+          "USD": {
+            "currency": "USD",
+            "label": "万美元",
+            "scale": 10000
+          }
+        }
+      },
+      "presets": [
+        {
+          "id": "all",
+          "label": "全部",
+          "range": {}
+        },
+        {
+          "id": "large",
+          "label": "100万及以上",
+          "range": {
+            "from": 100
+          }
+        },
+        {
+          "id": "small",
+          "label": "0至50万",
+          "range": {
+            "from": 0,
+            "to": 50
+          }
+        }
+      ],
+      "clearOnChangeOf": [
+        "currency"
+      ],
+      "hint": "金额以基本单位保存；切币种清金额后需明确确认范围。"
+    }
+  ],
+  "dataSources": {
+    "main": {
+      "fields": {
+        "project": {
+          "type": "string",
+          "role": "dimension",
+          "queryField": "ioc_amount_project"
+        },
+        "scope": {
+          "type": "string",
+          "role": "dimension",
+          "queryField": "ioc_amount_scope"
+        },
+        "base-cny": {
+          "type": "money",
+          "role": "measure",
+          "currency": "CNY",
+          "unit": "元",
+          "label": "预签金额",
+          "defaultFormat": "number-grouped",
+          "nullable": true,
+          "queryField": "ioc_amount_base_cny"
+        },
+        "fee-cny": {
+          "type": "money",
+          "role": "measure",
+          "currency": "CNY",
+          "unit": "元",
+          "label": "费用",
+          "defaultFormat": "number-grouped",
+          "nullable": true,
+          "queryField": "ioc_amount_fee_cny"
+        },
+        "total-cny": {
+          "type": "money",
+          "role": "measure",
+          "currency": "CNY",
+          "unit": "元",
+          "label": "含费用金额",
+          "defaultFormat": "number-grouped",
+          "nullable": true
+        },
+        "base-usd": {
+          "type": "money",
+          "role": "measure",
+          "currency": "USD",
+          "unit": "美元",
+          "label": "预签金额",
+          "defaultFormat": "number-grouped",
+          "nullable": true,
+          "queryField": "ioc_amount_base_usd"
+        },
+        "fee-usd": {
+          "type": "money",
+          "role": "measure",
+          "currency": "USD",
+          "unit": "美元",
+          "label": "费用",
+          "defaultFormat": "number-grouped",
+          "nullable": true,
+          "queryField": "ioc_amount_fee_usd"
+        },
+        "total-usd": {
+          "type": "money",
+          "role": "measure",
+          "currency": "USD",
+          "unit": "美元",
+          "label": "含费用金额",
+          "defaultFormat": "number-grouped",
+          "nullable": true
+        }
+      },
+      "source": {
+        "type": "query",
+        "resultScope": "complete",
+        "query": {
+          "language": "dqe",
+          "body": {
+            "dsl_list": [
+              {
+                "output_dims": [
+                  "ioc_amount_project",
+                  "ioc_amount_scope"
+                ],
+                "output_metrics": [
+                  "ioc_amount_base_cny",
+                  "ioc_amount_fee_cny",
+                  "ioc_amount_base_usd",
+                  "ioc_amount_fee_usd"
+                ],
+                "filter": {
+                  "dims": [],
+                  "metrics": [],
+                  "time": {
+                    "period": "month"
+                  }
+                },
+                "order": {}
+              }
+            ]
+          },
+          "filterBindings": {
+            "period": {
+              "target": "time"
+            },
+            "amount": {
+              "target": "numberRange",
+              "metricByFilter": {
+                "filterId": "currency",
+                "cases": {
+                  "RMB": "ioc_amount_base_cny",
+                  "USD": "ioc_amount_base_usd"
+                }
+              }
+            }
+          }
+        }
+      },
+      "compute": [
+        {
+          "op": "sumFields",
+          "fields": [
+            "base-cny",
+            "fee-cny"
+          ],
+          "output": "total-cny",
+          "onMissing": "null"
+        },
+        {
+          "op": "sumFields",
+          "fields": [
+            "base-usd",
+            "fee-usd"
+          ],
+          "output": "total-usd",
+          "onMissing": "null"
+        }
+      ]
+    },
+    "unbound": {
+      "fields": {
+        "scope": {
+          "type": "string",
+          "role": "dimension",
+          "queryField": "ioc_header_scope"
+        },
+        "count": {
+          "type": "number",
+          "role": "measure",
+          "queryField": "ioc_header_count"
+        }
+      },
+      "source": {
+        "type": "query",
+        "query": {
