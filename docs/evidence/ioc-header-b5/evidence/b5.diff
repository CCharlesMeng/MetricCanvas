+    },
+    "iocHeader": {
+      "identity": {
+        "title": "IOC B5：项目清单",
+        "tags": [
+          {
+            "id": "synthetic",
+            "text": "合成验收",
+            "tone": "info"
+          }
+        ],
+        "description": {
+          "text": {
+            "parts": [
+              "来源：",
+              {
+                "param": "origin"
+              }
+            ]
