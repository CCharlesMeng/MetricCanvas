+            "project-id": {
+              "target": "dimension",
+              "queryField": "project_code"
+            }
+          },
+          "filterBindings": {
+            "month": {
+              "target": "timePoint",
+              "queryField": "sales_month"
+            },
+            "currency": {
+              "target": "dimension",
+              "queryField": "currency_code"
+            },
+            "regions": {
+              "target": "dimension",
+              "queryField": "region_code"
+            }
+          }
+        }
