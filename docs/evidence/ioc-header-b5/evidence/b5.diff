+          "type": "string",
+          "role": "dimension",
+          "queryField": "sales_month"
+        },
+        "currency_code": {
+          "type": "string",
+          "role": "dimension",
+          "queryField": "currency_code"
+        },
+        "region_code": {
+          "type": "string",
+          "role": "dimension",
+          "queryField": "region_code"
+        }
