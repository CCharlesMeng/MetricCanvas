+      "default": "2026-09",
+      "disableFuture": false
+    },
+    {
+      "id": "currency",
+      "type": "dimension",
+      "label": "币种",
+      "dimension": "currency_code",
+      "display": "select",
+      "selection": {
+        "mode": "single",
+        "required": true
+      },
+      "options": [
+        {
+          "value": "RMB",
