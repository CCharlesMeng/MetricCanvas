+        "label": "项目编码",
+        "value": {
+          "param": "project-id"
+        }
+      },
+      "description": {
+        "text": {
+          "parts": [
+            "来源：",
+            {
+              "param": "origin"
+            }
+          ]
+        },
+        "presentation": "inline"
+      }
+    },
+    "filterIds": [
+      "month",
+      "currency",
+      "regions"
+    ]
+  },
