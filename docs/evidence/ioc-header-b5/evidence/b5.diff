+        },
+        {
+          "value": "USD",
+          "label": "美元"
+        }
+      ],
+      "default": [
+        "RMB"
+      ]
+    },
+    {
+      "id": "regions",
+      "type": "dimension",
+      "label": "区域",
+      "dimension": "region_code",
+      "display": "select",
+      "selection": {
+        "mode": "multiple"
+      },
+      "options": [
+        {
+          "value": "north",
