+          "type": "string",
+          "role": "dimension",
+          "queryField": "project_code"
+        },
+        "sales_month": {
+          "type": "string",
+          "role": "dimension",
+          "queryField": "sales_month"
+        },
+        "currency_code": {
+          "type": "string",
+          "role": "dimension",
+          "queryField": "currency_code"
+        },
+        "region_code": {
+          "type": "string",
+          "role": "dimension",
+          "queryField": "region_code"
+        }
+      },
+      "source": {
+        "type": "query",
+        "query": {
+          "language": "dqe",
+          "body": {
+            "dsl_list": [
+              {
+                "output_dims": [
+                  "ioc_header_scope",
