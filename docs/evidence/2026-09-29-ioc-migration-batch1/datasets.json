    {
      "id": "customer-detail.business-progress",
      "page": "customer-detail",
      "consumer": "经营进展4指标+2仪表+趋势图",
      "sources": [
        "REST CLOUDBI_AP_DM_CCCRG_IOC_PL_R2BD2BG_CUST_SORT（年度预测/GAP/销毛率/目标完成率，PERIOD_ID=mtime）",
        "REST IOC_CDI_Customer360_DM_CCCRG_IOC_PL_CUST（年累计收入+近12月趋势，CUST_CODE=partyNumbers，START=当年01，END=mtime）",
        "graphql PROJECT_MAP_CUSTOMER_REVENUE_FORECAST_M（annual_target_amt_sum / stock_forecast_revenue_amt_sum）"
      ],
      "fields": [
        {
          "name": "rev_ytd_amt",
          "type": "number",
          "nullable": true,
          "meaning": "年累计收入（元）"
        },
        {
          "name": "rev_yoy_y",
          "type": "number",
          "nullable": true,
          "meaning": "收入年同比（比例）"
        },
        {
          "name": "sgp_ytd_amt",
          "type": "number",
          "nullable": true,
          "meaning": "销毛额年累计（元）"
        },
        {
          "name": "rmb_ptd_amt",
          "type": "number",
          "nullable": true,
          "meaning": "月累计收入-人民币（元）"
        },
        {
          "name": "rmb_py_ptd_amt",
          "type": "number",
          "nullable": true,
          "meaning": "去年同期月累计-人民币（元）"
        },
        {
          "name": "rmb_ytd_amt",
          "type": "number",
          "nullable": true,
          "meaning": "月累计收入-人民币（趋势，元）"
        },
        {
          "name": "rmb_py_ytd_amt",
          "type": "number",
          "nullable": true,
          "meaning": "去年同期月累计-人民币（趋势，元）"
        },
        {
          "name": "period_id",
          "type": "string yyyyMM",
          "nullable": true,
          "meaning": "会计月"
        },
        {
          "name": "annual_target_amt_sum",
          "type": "number",
          "nullable": true,
          "meaning": "年度目标（元）"
        },
        {
          "name": "stock_forecast_revenue_amt_sum",
          "type": "number",
          "nullable": true,
          "meaning": "本年剩余月份存量预测_当月（元）"
        }
      ],
      "computedFrontend": "annual_forecast_revenue=rev_ytd+stock；gap=预测-目标；完成率=DIVIDE(rev_ytd,target)×100；销毛率=DIVIDE(sgp,rev)×100；年累计Σ（全null→null）；趋势按period_id分组聚合",
      "uniqueKey": "period_id（趋势）/单行（卡）"
    },
