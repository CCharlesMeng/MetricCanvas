{
  "name": "@metriccanvas/metric-canvas",
  "version": "1.0.0-rc.1",
  "type": "module",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": "./src/types.ts"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test:browser": "playwright test",
    "build": "node ../../tools/package-build/build.mjs metric-canvas",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@metriccanvas/engine": "workspace:*",
    "@metriccanvas/page": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=5.29.0 <6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      }
    }
  }
}
