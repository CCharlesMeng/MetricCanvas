{
  "schemaVersion": "6.45",
  "id": "chart-local-filter-page",
  "layout": "dashboard",
  "filters": [
    {
      "id": "share-region",
      "type": "dimension",
      "dimension": "chart_demo_region",
      "label": "渠道占比区域",
      "default": [
        "APAC"
      ]
    }
  ],
  "dataSources": {
    "share-data": {
      "fields": {
        "category": {
          "type": "string",
          "role": "dimension",
          "queryField": "chart_demo_category"
        },
        "value": {
          "type": "number",
          "role": "measure",
          "queryField": "chart_demo_share"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "filterBindings": {
            "share-region": {
              "target": "dimension",
              "queryField": "chart_demo_region"
            }
          },
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "chart_demo_category"
                ],
                "output_metrics": [
                  "chart_demo_share"
                ],
                "filter": {
                  "dims": [],
                  "metrics": []
                },
                "order": {}
              }
            ]
          }
        }
      }
    }
  },
  "sections": [
    {
      "id": "main",
      "components": [
        {
          "id": "share-group",
          "type": "compositeCard",
          "layout": {
            "span": 6
          },
          "props": {
            "variant": "compact",
            "components": [
              {
                "id": "share-filter",
                "type": "filterGroup",
                "layout": {
                  "span": 12
                },
                "props": {
                  "filterId": "share-region",
                  "options": [
                    {
                      "label": "国内",
                      "value": "CN"
                    },
                    {
                      "label": "亚太",
                      "value": "APAC"
                    },
                    {
                      "label": "欧洲（空结果）",
                      "value": "EU"
                    }
                  ]
                }
              },
              {
                "id": "share",
                "type": "pieChart",
                "layout": {
                  "span": 12
                },
                "data": {
                  "main": "share-data"
                },
                "props": {
                  "title": "渠道占比",
                  "categoryField": "category",
                  "valueField": "value"
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
