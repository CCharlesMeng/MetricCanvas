{
  "case": "table-select-all-range-mode",
  "invariant": "table-show-select-all",
  "input": {
    "schemaVersion": "6.98",
    "id": "table-header-select-all",
    "layout": "dashboard",
    "meta": {
      "title": "列头全选开关（内联合成数据）",
      "description": "showSelectAll 显式控制入口；静态和动态候选全选后该列不限，保留业务范围、其他列条件与空值。"
    },
    "dataSources": {
      "records": {
        "fields": {
          "id": {
            "type": "string",
            "role": "dimension"
          },
          "status": {
            "type": "string",
            "role": "dimension"
          },
          "area": {
            "type": "string",
            "role": "dimension"
          }
        },
        "source": {
          "type": "inline",
          "rows": [
            {
              "id": "A",
              "status": "是",
              "area": "东区"
            },
            {
              "id": "B",
              "status": "否",
              "area": "东区"
            },
            {
              "id": "C",
              "status": "待定",
              "area": "西区"
            },
            {
              "id": "D",
              "status": null,
              "area": "东区"
            }
          ]
        }
      },
      "null-records": {
        "fields": {
          "id": {
            "type": "string",
            "role": "dimension"
          },
          "status": {
            "type": "string",
            "role": "dimension"
          },
          "area": {
            "type": "string",
            "role": "dimension"
          }
        },
        "source": {
          "type": "inline",
          "rows": [
            {
              "id": "E",
              "status": null,
              "area": "东区"
            }
          ]
        }
      }
    },
    "sections": [
      {
        "id": "examples",
        "components": [
          {
            "id": "static-all",
            "type": "table",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "records"
            },
            "props": {
              "title": "静态候选：显示全选",
              "rowKey": "id",
              "columns": [
                {
                  "field": "id",
                  "title": "编号"
                },
                {
                  "field": "status",
                  "title": "是否有效",
                  "filterable": {
                    "mode": "numberRange",
                    "showSelectAll": true
                  },
                  "enumValues": [
                    {
                      "value": "是",
                      "label": "是"
                    },
                    {
                      "value": "否",
                      "label": "否"
                    }
                  ]
                },
                {
                  "field": "area",
                  "title": "区域",
                  "filterable": {
                    "mode": "select"
                  }
                }
              ],
              "pagination": {
                "mode": "local",
                "pageSize": 2
              },
              "toolbar": {
                "export": {
                  "format": "xlsx",
                  "filename": "static-all"
                }
              }
            }
          },
          {
            "id": "dynamic-all",
            "type": "table",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "records"
            },
            "props": {
              "title": "动态候选：显示全选",
              "rowKey": "id",
              "columns": [
                {
                  "field": "id",
                  "title": "编号"
                },
                {
                  "field": "status",
                  "title": "是否有效",
                  "filterable": {
                    "mode": "select",
                    "defaultValues": [
                      "是"
                    ],
                    "showSelectAll": true
                  }
                },
                {
                  "field": "area",
                  "title": "区域",
                  "filterable": {
                    "mode": "select"
                  }
                }
              ],
              "pagination": {
                "mode": "local",
                "pageSize": 2
              },
              "toolbar": {
                "export": {
                  "format": "xlsx",
                  "filename": "dynamic-all"
                }
              }
            }
          },
