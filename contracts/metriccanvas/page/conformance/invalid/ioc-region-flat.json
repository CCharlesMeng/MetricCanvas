{
  "case": "ioc-region-flat",
  "invariant": "ioc-region-single-tree",
  "input": {
    "schemaVersion": "6.75",
    "id": "key-office-filter-demo",
    "layout": "dashboard",
    "meta": {
      "title": "重点国代联动 合成数据"
    },
    "filters": [
      {
        "id": "region",
        "type": "dimension",
        "dimension": "demo_region",
        "label": "Region",
        "selection": {
          "mode": "single"
        },
        "display": "tree",
        "treeSelection": "level",
        "defaultLevel": "region-dept",
        "candidateContext": {
          "filterIds": [
            "key-office"
          ],
          "reconcile": "intersection"
        }
      },
      {
        "id": "key-office",
        "type": "boolean",
        "label": "仅看重点国代",
        "enabledWhen": {
          "filter": "region",
          "part": "values",
          "op": "isNotEmpty"
        }
      },
      {
        "id": "mtime",
        "type": "timePoint",
        "granularity": "month",
        "label": "数据月份"
      }
    ],
    "iocHeader": {
      "identity": {
        "title": "重点国代联动"
      },
      "filterIds": [
        "key-office",
        "mtime",
        "region"
      ]
    },
    "dataSources": {
      "offices": {
        "fields": {
          "office": {
            "type": "string",
            "role": "dimension",
            "queryField": "demo_office"
          },
          "amount": {
            "type": "number",
            "role": "measure",
            "queryField": "demo_amount"
          }
        },
        "source": {
          "type": "query",
          "query": {
            "language": "dqe",
            "body": {
              "dsl_list": [
                {
                  "output_dims": [
                    "demo_office"
                  ],
                  "output_metrics": [
                    "demo_amount"
                  ],
                  "filter": {
                    "dims": [],
                    "metrics": []
                  },
                  "order": {}
                }
              ]
            },
            "filterBindings": {
              "region": {
                "target": "dimension",
                "levelQueryFields": {
                  "region-dept": "demo_region",
                  "office": "demo_office"
                }
              },
              "key-office": {
                "target": "boolean",
                "queryField": "demo_key_office",
                "whenTrue": [
                  "true"
                ]
              }
            }
          }
        }
      }
    },
    "sections": [
      {
        "id": "results",
        "components": [
          {
            "id": "office-table",
            "type": "table",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "offices"
            },
            "props": {
              "rowKey": "office",
              "columns": [
                {
                  "title": "代表处",
                  "field": {
                    "data": "main",
                    "field": "office"
                  }
                },
                {
                  "title": "金额",
                  "field": {
                    "data": "main",
                    "field": "amount"
                  }
                }
              ],
              "toolbar": {
                "export": {
                  "format": "xlsx"
                }
              }
            }
          },
          {
            "id": "next-page",
            "type": "button",
            "layout": {
              "span": 12
            },
            "props": {
              "label": "切换页面",
              "action": {
                "navigate": {
                  "href": "/pages/key-office-filter-target"
                },
                "on": "click"
              }
            }
          }
        ]
      }
    ]
  },
  "expected": [
    {
      "type": "SCHEMA_ERROR",
      "path": "/filters/0/defaultLevel",
      "message": "defaultLevel 只能用于声明了 hierarchy 的维度筛选器"
    },
    {
      "type": "SCHEMA_ERROR",
      "path": "/filters/0/treeSelection",
      "message": "结构树必须声明tree与hierarchy"
    },
    {
      "type": "SCHEMA_ERROR",
      "path": "/filters/0/hierarchy",
      "message": "IOC Region 必须声明地区部与代表处等真实层级"
    },
    {
      "type": "FILTER_BINDING_ERROR",
      "path": "/dataSources/offices/source/query/filterBindings/region/levelQueryFields",
      "message": "levelQueryFields 只能绑定层级维度筛选器:region"
    }
  ]
}
