{
  "case": "backdrop-without-container",
  "invariant": "backdrop-container-plain",
  "input": {
    "schemaVersion": "5.4",
    "id": "composite-page",
    "layoutForm": "dashboard",
    "dashboardToolbar": {
      "variant": "compact",
      "readOnly": true,
      "note": "只读"
    },
    "meta": {
      "description": "组合卡、Tab 容器、叠放层、列轨与 5.4 呈现档的契约样例"
    },
    "dataSources": {
      "summary": {
        "fields": {
          "channel": {
            "type": "string",
            "role": "dimension"
          },
          "amount": {
            "type": "number",
            "role": "measure"
          },
          "share": {
            "type": "number",
            "role": "measure"
          },
          "score": {
            "type": "number",
            "role": "measure"
          },
          "owner": {
            "type": "string",
            "role": "dimension"
          }
        },
        "source": {
          "type": "inline",
          "rows": [
            {
              "channel": "线上",
              "amount": 60,
              "share": 60,
              "score": 88,
              "owner": "张三"
            },
            {
              "channel": "线下",
              "amount": 40,
              "share": 40,
              "score": 70,
              "owner": "李四"
            }
          ]
        }
      },
      "top": {
        "fields": {
          "name": {
            "queryField": "name",
            "type": "string",
            "role": "dimension"
          },
          "value": {
            "queryField": "value",
            "type": "number",
            "role": "measure"
          }
        },
        "source": {
          "type": "query",
          "query": {
            "language": "dqe",
            "body": {
              "dsl_list": [
                {
                  "output_dims": [
                    "name"
                  ],
                  "output_metrics": [
                    "value"
                  ],
                  "filter": {
                    "dims": [],
                    "metrics": []
                  },
                  "order": {
                    "offset": 0,
                    "limit": 10
                  }
                }
              ]
            }
          }
        }
      }
    },
    "sections": [
      {
        "id": "overview",
        "columnTracks": [
          2,
          1
        ],
        "components": [
          {
            "id": "backdrop",
            "type": "text",
            "layout": {
              "span": 12,
              "layer": "backdrop"
            },
            "props": {
              "variant": "plain",
              "body": "背景"
            }
          },
          {
            "id": "card",
            "type": "compositeCard",
            "layout": {
              "span": 2
            },
            "props": {
              "title": "渠道概览",
              "titleIcon": "opportunity",
              "variant": "metricGrid",
              "components": [
                {
                  "id": "amount-card",
                  "type": "metricCard",
                  "layout": {
                    "span": 6
                  },
                  "data": {
                    "main": "summary"
                  },
                  "props": {
                    "rows": [
                      {
                        "label": "线上金额",
                        "context": "近60天",
                        "valueField": {
                          "data": "main",
                          "field": "amount",
                          "match": {
                            "field": "channel",
                            "equals": "线上"
                          }
                        },
                        "link": true
                      }
                    ],
                    "secondaryRows": [
                      {
                        "label": "评分",
                        "valueField": "score"
                      }
                    ],
                    "actions": [
                      {
                        "on": "click",
                        "navigate": {
                          "page": "inline-report"
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "share-pie",
                  "type": "pieChart",
                  "layout": {
                    "span": 6
                  },
                  "data": {
                    "main": "summary"
                  },
                  "props": {
                    "categoryField": "channel",
                    "valueField": "share"
                  }
                },
                {
                  "id": "score-gauge",
                  "type": "gauge",
                  "layout": {
                    "span": 6
                  },
                  "data": {
                    "main": "summary"
                  },
                  "props": {
                    "valueField": "score",
                    "max": 100
                  }
                },
                {
                  "id": "owner-panel",
                  "type": "keyValuePanel",
                  "layout": {
                    "span": 6
                  },
                  "data": {
                    "main": "summary"
                  },
                  "props": {
                    "titleIcon": "reward",
                    "columns": 6,
                    "items": [
                      {
                        "label": "负责人",
                        "field": "owner",
                        "icon": "goldMedal"
                      },
                      {
                        "label": "金额",
                        "field": "amount",
                        "unit": "万元"
                      }
                    ]
                  }
                },
                {
                  "id": "channel-breakdown",
                  "type": "categoryBreakdown",
                  "layout": {
                    "span": 12
                  },
                  "data": {
                    "main": "summary"
                  },
                  "props": {
                    "categoryField": "channel",
                    "columns": [
                      {
                        "label": "金额",
                        "field": "amount"
                      }
                    ],
                    "swatches": true
                  }
                }
              ]
            }
          },
          {
            "id": "single-panel",
            "type": "keyValuePanel",
            "layout": {
              "span": 1
            },
            "data": {
              "main": "summary"
            },
            "props": {
              "columns": 1,
              "items": [
                {
                  "label": "负责人",
                  "field": "owner"
                }
              ]
            }
          }
        ]
      },
      {
        "id": "tabs",
        "components": [
          {
            "id": "tab-container",
            "type": "tabContainer",
            "layout": {
              "span": 12
            },
            "props": {
              "variant": "analysisStack",
              "defaultTab": "top",
              "tabs": [
                {
                  "id": "top",
                  "label": "TOP",
                  "component": {
                    "id": "top-table",
                    "type": "table",
                    "layout": {
                      "span": 12
                    },
                    "data": {
                      "main": "top"
                    },
                    "props": {
                      "variant": "embedded",
                      "bottomFade": true,
                      "columns": [
                        {
                          "field": "name"
                        },
                        {
                          "field": "value"
                        }
                      ]
                    }
                  }
                },
                {
                  "id": "all",
                  "label": "全部",
                  "components": [
                    {
                      "id": "all-table",
                      "type": "table",
                      "layout": {
                        "span": 12
                      },
                      "data": {
                        "main": "summary"
                      },
                      "props": {
                        "columns": [
                          {
                            "field": "channel"
                          },
                          {
                            "field": "amount"
                          }
                        ],
                        "pagination": {
                          "mode": "local",
                          "pageSize": 10
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "expected": [
    {
      "type": "SCHEMA_ERROR",
      "path": "/sections/0/container",
      "message": "声明 backdrop 的内容分区必须使用 container: plain，当前为 缺省"
    }
  ]
}
