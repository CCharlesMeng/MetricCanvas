                  "changes": [
                    {
                      "label": "变化",
                      "field": "delta",
                      "colorRule": {
                        "mode": "sign",
                        "positive": "red",
                        "negative": "green"
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "sample-bar",
            "type": "barChart",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "sample"
            },
            "props": {
              "categoryField": "name",
              "series": [
                {
                  "field": "delta"
                }
              ],
              "categoryLabels": {
                "mode": "all",
                "rotate": 45
              },
              "showValueLabels": true
            }
          },
          {
            "id": "sample-line",
            "type": "lineChart",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "sample"
            },
            "props": {
              "xField": "name",
              "series": [
                {
                  "field": "delta"
                }
              ],
              "categoryLabels": {
                "mode": "all",
                "rotate": 45
              },
              "showValueLabels": true
            }
          },
          {
            "id": "sample-mixed",
            "type": "barChart",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "sample"
            },
            "props": {
              "categoryField": "name",
              "dualAxis": true,
              "series": [
                {
                  "field": "delta",
                  "kind": "bar",
                  "axis": "primary"
                },
                {
                  "field": "count",
                  "kind": "line",
                  "axis": "secondary"
                }
              ],
              "categoryLabels": {
                "mode": "all",
                "rotate": 45
              },
              "showValueLabels": true
            }
          }
        ]
      }
