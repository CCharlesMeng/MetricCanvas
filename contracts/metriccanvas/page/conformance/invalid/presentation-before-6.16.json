            },
            "props": {
              "columns": [
                {
                  "field": "name"
                },
                {
                  "field": "delta",
                  "colorRule": {
                    "mode": "sign",
                    "positive": "red",
                    "negative": "green"
                  }
                },
                {
                  "field": "count",
                  "colorRule": {
                    "mode": "fixed",
                    "color": "green"
                  }
                }
              ]
            }
          },
          {
            "id": "sample-card",
            "type": "metricCard",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "sample"
            },
            "props": {
              "showTrendArrows": true,
              "rows": [
                {
