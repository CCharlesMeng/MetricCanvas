{
  "case": "report-export-other-format",
  "invariant": "report-header-export-buttons",
  "input": {
    "schemaVersion": "6.31",
    "id": "report-export-buttons",
    "layout": "report",
    "meta": {
      "title": "Report 导出图片",
      "description": "本地合成数据：单张高清PNG、独立文档水印隔离、日期与文件名冻结、既有PDF回归。"
    },
    "filters": [
      {
        "id": "report-month",
        "type": "timePoint",
        "granularity": "month",
        "label": "报告月份",
        "default": "2026-09"
      }
    ],
    "dataSources": {
      "sales": {
        "fields": {
          "region": {
            "type": "string",
            "role": "dimension",
            "label": "区域"
          },
          "amount": {
            "type": "number",
            "role": "measure",
            "label": "金额",
            "unit": "元"
          }
        },
        "source": {
          "type": "inline",
          "rows": [
            {
              "region": "演示区域 01",
              "amount": 12345
            },
            {
              "region": "演示区域 02",
              "amount": 24690
            },
            {
