              "amount": 111105
            },
            {
              "region": "演示区域 10",
              "amount": 123450
            },
            {
              "region": "演示区域 11",
              "amount": 135795
            },
            {
              "region": "演示区域 12",
              "amount": 148140
            }
          ]
        }
      }
    },
    "sections": [
      {
        "id": "header",
        "container": "plain",
        "components": [
          {
            "id": "report-header",
            "type": "reportHeader",
            "layout": {
              "span": 12
            },
            "props": {
              "title": {
                "parts": [
                  {
                    "filter": "report-month",
                    "format": "period"
                  },
                  " 经营分析报告"
                ]
              },
              "subtitle": "本地合成数据。导出图片只保存一张完整高清PNG，日期与文件名按点击时捕获。",
              "filterIds": [
                "report-month"
              ],
              "asOf": {
                "label": "统计期间",
                "value": {
                  "filter": "report-month",
                  "format": "period"
                }
              },
              "decoration": "shortBar",
              "exportButtons": [
                {
                  "format": "pdf",
                  "label": "导出 PDF",
                  "filename": {
                    "parts": [
                      "经营分析报告-",
                      {
                        "filter": "report-month",
                        "format": "period"
                      }
                    ]
                  },
                  "scale": 2
                },
                {
                  "format": "jpeg",
                  "filename": {
                    "parts": [
                      "经营分析报告-",
                      {
                        "filter": "report-month",
                        "format": "period"
                      }
                    ]
                  },
                  "scale": 3
                }
              ]
            }
          }
        ]
      },
      {
        "id": "sales-chart",
        "title": "经营图表（合成数据）",
        "container": "plain",
        "components": [
          {
            "id": "sales-chart-bars",
            "type": "barChart",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "sales"
            },
            "props": {
              "title": "全部区域",
              "categoryField": "region",
              "series": [
                {
                  "field": "amount",
                  "label": "金额"
                }
              ]
            }
          }
        ]
      },
      {
        "id": "sales-detail",
        "title": "经营明细（合成数据）",
        "container": "plain",
        "components": [
          {
            "id": "sales-table",
            "type": "table",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "sales"
            },
            "props": {
              "columns": [
                {
                  "field": "region",
                  "title": "区域"
                },
                {
                  "field": {
                    "field": "amount",
                    "format": "number-grouped",
                    "data": "main"
                  },
                  "title": "金额（元）"
                }
              ],
              "pagination": {
                "mode": "local",
                "pageSize": 10
              }
            }
          }
        ]
      },
      {
        "id": "no-date",
        "container": "plain",
        "components": [
          {
            "id": "default-download-header",
            "type": "reportHeader",
            "layout": {
              "span": 12
            },
            "props": {
              "title": "元数据配置为4倍的导出按钮",
              "subtitle": "两个按钮复用同一种配置，清晰度均由元数据固定为4倍。",
              "exportButtons": [
                {
                  "format": "pdf",
                  "label": "导出 PDF（4倍）",
                  "scale": 4
                },
                {
                  "format": "png",
                  "scale": 4
                }
              ]
            }
          }
        ]
      },
      {
        "id": "without-export",
        "container": "plain",
        "components": [
          {
            "id": "ordinary-header",
            "type": "reportHeader",
            "layout": {
              "span": 12
            },
            "props": {
              "title": "未启用下载的对照页头",
              "subtitle": "未启用任何导出配置。",
              "exportButtons": [
                {
                  "format": "pdf",
                  "scale": 3
                }
              ]
            }
          }
        ]
      }
    ]
  },
