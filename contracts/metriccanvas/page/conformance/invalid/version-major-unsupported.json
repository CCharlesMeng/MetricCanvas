            "type": "string",
            "role": "dimension",
            "nullable": false
          },
          "gmv": {
            "queryField": "gmv",
            "type": "number",
            "role": "measure",
            "nullable": false
          }
        },
        "source": {
          "type": "query",
          "query": {
            "language": "dqe",
            "body": {
              "dsl_list": [
                {
                  "output_dims": [
                    "region"
                  ],
                  "output_metrics": [
                    "gmv"
                  ],
                  "filter": {
                    "dims": [],
                    "metrics": []
                  },
                  "order": {
                    "offset": 0,
                    "limit": 20
                  }
                }
              ]
            },
            "filterBindings": {
              "region-filter": {
                "target": "dimension",
                "queryField": "region"
              }
            }
          }
        }
      }
    },
    "filters": [
      {
        "id": "region-filter",
        "type": "dimension",
        "dimension": "region"
      }
    ],
    "sections": [
      {
        "id": "details",
        "components": [
          {
            "id": "sales-table",
            "type": "table",
