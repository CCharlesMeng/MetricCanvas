            },
            "props": {
              "columns": [
                {
                  "field": "region"
                },
                {
                  "field": "gmv"
                }
              ],
              "pagination": {
                "mode": "query"
              },
              "actions": [
                {
                  "on": "click",
                  "writeFilter": "region-filter",
                  "field": "region"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "expected": [
