{
  "schemaVersion": "6.5",
  "layout": "report",
  "id": "reference-variants-page",
  "meta": { "description": "参考手册最小排行卡与mini仪表；仅静态契约示例" },
  "dataSources": {
    "ranking": {
      "fields": {
        "name": { "type": "string", "role": "dimension" },
        "score": { "type": "number", "role": "measure" }
      },
      "source": { "type": "inline", "rows": [{ "name": "示例对象", "score": 80 }] }
    }
  },
  "sections": [{ "id": "main", "components": [
    { "id": "ranking", "type": "rankingCard", "layout": { "span": 8 }, "data": { "main": "ranking" }, "props": { "title": "排行", "nameField": "name", "valueField": "score" } },
    { "id": "completion", "type": "gauge", "layout": { "span": 4 }, "data": { "main": "ranking" }, "props": { "title": "完成度", "variant": "mini", "valueField": "score", "min": 0, "max": 100, "unit": "%" } }
  ] }]
}
