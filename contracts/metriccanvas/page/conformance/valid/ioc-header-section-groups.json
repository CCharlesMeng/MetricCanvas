{
  "schemaVersion": "6.81",
  "id": "ioc-header-section-groups",
  "layout": "dashboard",
  "meta": {
    "title": "IOC 页头随分组切换"
  },
  "dataSources": {},
  "filters": [
    {
      "id": "team",
      "type": "dimension",
      "dimension": "team",
      "label": "团队",
      "selection": {
        "mode": "single"
      },
      "options": [
        {
          "value": "A",
          "label": "团队甲"
        },
        {
          "value": "B",
          "label": "团队乙"
        }
      ],
      "default": [
        "A"
      ]
    }
  ],
  "sections": [
    {
      "id": "main",
      "container": "plain",
      "components": [
        {
          "id": "page-header",
          "type": "iocHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "identity": {
              "title": {
                "parts": [
                  "当前团队：",
                  {
                    "filter": "team"
                  }
                ]
              }
            },
            "filterIds": [
              "team"
            ],
            "back": true,
            "presentation": {
              "layout": "inline",
              "density": "normal",
              "collapse": "none"
            }
          }
        },
        {
          "id": "same-section-body",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "页头与这一段正文属于同一个 section。"
          }
        }
      ]
    },
    {
      "id": "persistent",
      "container": "plain",
      "components": [
        {
          "id": "persistent-body",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "切换显示首分区后，页头和正文一起隐藏；团队筛选值仍保留。"
          }
        }
      ]
    }
  ],
  "sectionGroups": [
    {
      "id": "overview",
      "label": "概览",
      "sectionIds": [
        "main"
      ]
    },
    {
      "id": "details",
      "label": "明细",
      "sectionIds": [
        "persistent"
      ]
    }
  ],
  "defaultSectionGroup": "overview"
}
