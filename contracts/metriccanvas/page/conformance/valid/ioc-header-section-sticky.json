{
  "schemaVersion": "6.81",
  "id": "ioc-header-section-sticky",
  "layout": "dashboard",
  "meta": {
    "title": "IOC 页头 section 内吸顶"
  },
  "dataSources": {},
  "filters": [
    {
      "id": "team",
      "type": "dimension",
      "dimension": "team",
      "label": "团队",
      "selection": {
        "mode": "single"
      },
      "options": [
        {
          "value": "A",
          "label": "团队甲"
        },
        {
          "value": "B",
          "label": "团队乙"
        }
      ],
      "default": [
        "A"
      ]
    },
    {
      "id": "show-header",
      "type": "boolean",
      "label": "显示首分区",
      "default": true
    }
  ],
  "sections": [
    {
      "id": "main",
      "container": "plain",
      "visibleWhen": {
        "filter": "show-header",
        "part": "value",
        "op": "eq",
        "value": true
      },
      "components": [
        {
          "id": "page-header",
          "type": "iocHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "identity": {
              "title": {
                "parts": [
                  "当前团队：",
                  {
                    "filter": "team"
                  }
                ]
              }
            },
            "filterIds": [
              "team"
            ],
            "back": true,
            "presentation": {
              "layout": "inline",
              "density": "compact",
              "collapse": "overflow"
            }
          }
        },
        {
          "id": "same-section-body",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "页头与这一段正文属于同一个 section。"
          }
        }
      ]
    },
    {
      "id": "persistent",
      "container": "plain",
