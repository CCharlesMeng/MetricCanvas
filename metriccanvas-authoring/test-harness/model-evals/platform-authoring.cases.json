    },
    {
      "id": "edit-dashboard",
      "workflow": "edit",
      "injectionSources": ["SKILL.md", "references/tools.md", "references/execution.md", "workflows/edit.md"],
      "dependsOn": "create-dashboard",
      "prompt": "把当前 dashboard 的区域对比图标题改为“区域请求量对比”，其他内容保持不变。",
      "expected": {
        "componentTitle": "区域请求量对比",
        "noDataQuery": true
      }
    },
    {
      "id": "edit-add-data",
      "workflow": "edit",
      "injectionSources": ["SKILL.md", "references/tools.md", "references/execution.md", "workflows/edit.md", "workflows/data-analysis.md"],
      "dependsOn": "edit-report",
      "prompt": "在当前 report 增加一个标题严格为“华东区域请求量补充明细”的表格，只展示 2026 年 8 月华东区域 Tokens 请求量；保留已有内容。当前页现有数据源覆盖全部区域，不能替代这个筛选后的新口径。分析计划已经确认。",
      "expected": {
        "addedComponentTitle": "华东区域请求量补充明细",
