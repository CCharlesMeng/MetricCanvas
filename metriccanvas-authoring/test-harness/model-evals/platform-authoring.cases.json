        "metric": "Tokens请求量",
        "unit": "次",
        "period": "2026-08",
        "rows": [{"区域": "华东", "Tokens请求量": 18}, {"区域": "华南", "Tokens请求量": 12}]
      }
    },
    {
      "id": "create-dashboard",
      "workflow": "create",
      "injectionSources": ["SKILL.md", "references/tools.md", "references/execution.md", "references/scenarios.md", "references/scenarios/usage-report.md", "references/layouts/dashboard.md", "workflows/create.md", "workflows/data-analysis.md"],
      "prompt": "新建一份 2026 年 8 月区域运营概览，明确采用 dashboard，展示各区域 Tokens 请求量对比与明细。分析计划已经确认，请先取得证据再创建草稿并交付预览。",
      "layout": "dashboard",
      "pageId": "main-flow-dashboard",
      "expected": {
        "title": "2026年8月区域运营概览",
        "metric": "Tokens请求量",
        "unit": "次",
        "period": "2026-08",
        "rows": [{"区域": "华东", "Tokens请求量": 18}, {"区域": "华南", "Tokens请求量": 12}]
      }
    },
    {
      "id": "edit-report",
      "workflow": "edit",
      "injectionSources": ["SKILL.md", "references/tools.md", "references/execution.md", "workflows/edit.md"],
      "dependsOn": "create-report",
      "prompt": "把当前 report 页头改为“2026年8月区域运营复盘”，其他内容保持不变。",
      "expected": {
        "title": "2026年8月区域运营复盘",
        "noDataQuery": true,
        "preserveExcept": ["/sections/0/components/0/props/title"]
