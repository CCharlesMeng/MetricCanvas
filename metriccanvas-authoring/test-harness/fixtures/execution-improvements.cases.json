{
  "version": 1,
  "scope": "MC local; production Relay/Java excluded",
  "fullRowCounts": [
    20,
    21,
    41
  ],
  "incompleteTotals": [
    null,
    50
  ],
  "cases": [
    {
      "id": "full-proportion",
      "test": "CompositionEvidenceTest.test_complete_rows_compose_without_publishing_partial_pie_initial",
      "expected": "complete program evidence accepted, incomplete initial omitted"
    },
    {
      "id": "unknown-truncated",
      "test": "CompositionEvidenceTest.test_unknown_or_truncated_totals_do_not_prove_proportion",
      "expected": "proportion rejected"
    },
    {
      "id": "total-and-match",
      "test": "ReferencedEditTest.test_match_beyond_sample_and_total_card",
      "expected": "total requires no dimension; match uses verified full rows"
    },
    {
      "id": "canonical-alias",
      "test": "SemanticExecutionTest.test_ambiguous_alias_fails_only_affected_request_before_dqe",
      "expected": "canonical query executes; ambiguous query does not"
    },
    {
      "id": "scope-maintenance",
      "test": "ScopeOwnershipTest",
      "expected": "owned notes follow changes; manual text preserved"
    },
    {
      "id": "multi-process",
      "test": "MetadataProcessesTest",
      "expected": "shared SQLite, concurrent read, restart, killed owner, isolated bindings"
    },
    {
      "id": "publication",
      "test": "MetadataPublicationTest",
      "expected": "late owner cannot publish, cancellation releases claim"
    },
    {
      "id": "retry-budget",
      "test": "MetadataRetryTest",
      "expected": "at most three HTTP calls; identity checked each attempt"
    }
  ],
  "modelProbes": {
    "runner": "run_platform_v2.py --cases create-report --evidence-probe <mode>",
    "modes": [
      "complete",
      "truncated",
      "unknown"
    ]
  },
  "forbidden": [
    "cross-turn result reuse",
    "invented completeness",
    "implicit currency",
    "Relay internal edits"
  ]
}
