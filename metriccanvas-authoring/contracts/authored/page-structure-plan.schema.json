{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metriccanvas.local/contracts/page-structure-plan/3.0.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "3"
        },
        "scene": {
          "enum": [
            "business-report",
            "usage-report",
            "custom"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "dataContextVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dataRequests": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "businessDomain",
              "dataSourceId",
              "metrics",
              "groupBy",
              "filters",
              "time"
            ],
            "properties": {
              "dataSourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "businessDomain": {
                "type": "string",
                "minLength": 1
              },
              "metrics": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name"
                  ],
                  "properties": {
                    "kind": {
                      "const": "metric"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "groupBy": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "filters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dimension",
                    "values"
                  ],
                  "properties": {
                    "dimension": {
                      "type": "string",
                      "minLength": 1
                    },
                    "values": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "time": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "granularity",
                      "start",
                      "end",
                      "providedBy"
                    ],
                    "properties": {
                      "granularity": {
                        "type": "string",
                        "minLength": 1
                      },
                      "start": {
                        "type": "string",
                        "minLength": 1
                      },
                      "end": {
                        "type": "string",
                        "minLength": 1
                      },
                      "providedBy": {
                        "enum": [
                          "user",
                          "model"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "pattern": {
                "enum": [
                  "overview-with-trend",
                  "comparison",
                  "distribution",
                  "focus-objects",
                  "detail",
                  "explanation",
                  "custom"
                ]
              },
              "container": {
                "enum": [
                  "plain",
                  "panel",
                  "card"
                ]
              },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[a-z0-9][a-z0-9-]*$"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8000
                        },
                        "type": {
                          "const": "text"
                        },
                        "body": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8000
                        },
                        "purpose": {
                          "enum": [
                            "primary-value",
                            "change",
                            "trend",
                            "distribution",
                            "reconciliation",
                            "explanation"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "body",
                        "purpose"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[a-z0-9][a-z0-9-]*$"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8000
                        },
                        "width": {
                          "enum": [
                            "full",
                            "half",
                            "third",
                            "two-thirds"
                          ]
                        },
                        "type": {
                          "const": "data"
                        },
                        "source": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[a-z0-9][a-z0-9-]*$"
                        },
                        "component": {
                          "enum": [
                            "barChart",
                            "categoryBreakdown",
                            "gauge",
                            "keyValuePanel",
                            "lineChart",
                            "metricCard",
                            "pieChart",
                            "rankingCard",
                            "rankingDetailCard",
                            "table"
                          ]
                        },
                        "fields": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 30,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          }
                        },
                        "match": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "field": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "equals": {
                              "type": [
                                "string",
                                "number",
                                "boolean"
                              ]
                            }
                          },
                          "required": [
                            "field",
                            "equals"
                          ]
                        },
                        "purpose": {
                          "enum": [
                            "primary-value",
                            "change",
                            "trend",
                            "comparison",
                            "distribution",
                            "ranking",
                            "reconciliation"
                          ]
                        },
                        "presentation": {
                          "oneOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "kind": {
                                  "const": "metric-summary"
                                },
                                "metrics": {
                                  "type": "array",
                                  "minItems": 1,
                                  "maxItems": 3,
                                  "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                      "field": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 128
                                      },
                                      "label": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 500
                                      },
                                      "changes": {
                                        "type": "array",
                                        "maxItems": 3,
                                        "items": {
                                          "type": "object",
                                          "additionalProperties": false,
                                          "properties": {
                                            "field": {
                                              "type": "string",
                                              "minLength": 1,
                                              "maxLength": 128
                                            },
                                            "label": {
                                              "type": "string",
                                              "minLength": 1,
                                              "maxLength": 500
                                            },
                                            "evidenceRef": {
                                              "type": "string",
                                              "minLength": 1,
                                              "maxLength": 128
                                            }
                                          },
                                          "required": [
                                            "field",
                                            "label",
                                            "evidenceRef"
                                          ]
                                        }
                                      }
                                    },
                                    "required": [
                                      "field"
                                    ]
                                  }
                                },
                                "variant": {
                                  "enum": [
                                    "compactSummary",
                                    "compactStrip"
                                  ]
                                }
                              },
                              "required": [
                                "kind",
                                "metrics"
                              ]
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "kind": {
                                  "const": "bar-comparison"
                                },
                                "horizontal": {
                                  "type": "boolean"
                                },
                                "stacked": {
                                  "type": "boolean"
                                }
                              },
                              "required": [
                                "kind"
                              ]
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "kind": {
                                  "const": "record-list"
                                },
                                "density": {
                                  "enum": [
                                    "standard",
                                    "compact"
                                  ]
                                },
                                "subtitle": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 500
                                },
                                "columns": {
                                  "type": "array",
                                  "maxItems": 30,
                                  "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                      "field": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 500
                                      },
                                      "align": {
                                        "enum": [
                                          "left",
                                          "right"
                                        ]
                                      },
                                      "visual": {
                                        "enum": [
                                          "plain",
                                          "signed"
                                        ]
                                      }
                                    },
                                    "required": [
                                      "field"
                                    ]
                                  }
                                }
                              },
                              "required": [
                                "kind"
                              ]
                            }
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "source",
                        "component",
                        "fields",
                        "title",
                        "purpose"
                      ]
                    }
                  ]
                }
              },
              "businessQuestion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "businessObject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "distinctFrom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "id",
              "pattern",
              "blocks",
              "businessQuestion",
              "businessObject",
              "distinctFrom"
            ]
          }
        }
      },
      "required": [
        "version",
        "scene",
        "question",
        "dataContextVersion",
        "dataRequests",
        "sections"
      ]
    }
  ]
}
