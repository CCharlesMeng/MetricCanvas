{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metriccanvas.local/contracts/agent-conformance/0.1.0",
  "title": "MetricCanvas Agent Conformance Vector",
  "description": "Cross-runtime scripted cases exported from the TypeScript baseline. The first slice freezes deterministic business-term retrieval and disambiguation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "source", "dataContext", "cases"],
  "properties": {
    "formatVersion": { "const": "1.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "module", "dataContext"],
      "properties": {
        "implementation": { "const": "typescript" },
        "module": { "const": "ask/retrieval+ask/model-port+ask/orchestrator" },
        "dataContext": { "type": "string", "minLength": 1 }
      }
    },
    "dataContext": {
      "type": "object",
      "description": "Self-contained neutral Data Context snapshot used to replay every case."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/businessTermCase" },
          { "$ref": "#/$defs/deterministicBusinessTermCase" },
          { "$ref": "#/$defs/modelDecisionCase" },
          { "$ref": "#/$defs/stepEventSequenceCase" }
        ]
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricName",
        "businessDomain",
        "definition",
        "matchedTerm",
        "score"
      ],
      "properties": {
        "metricName": { "$ref": "#/$defs/nonEmptyString" },
        "businessDomain": { "$ref": "#/$defs/nonEmptyString" },
        "definition": { "type": "string" },
        "unit": { "type": "string" },
        "matchedTerm": { "$ref": "#/$defs/nonEmptyString" },
        "score": { "type": "number" }
      }
    },
    "businessTermCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "kind", "input", "expected"],
      "properties": {
        "case": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "business_term_resolution" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["question", "businessDomains"],
          "properties": {
            "question": { "$ref": "#/$defs/nonEmptyString" },
            "businessDomains": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            "limit": { "type": "integer", "minimum": 1 }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidates", "selected", "ambiguousTerms"],
          "properties": {
            "candidates": {
              "type": "array",
              "items": { "$ref": "#/$defs/candidate" }
            },
            "selected": {
              "type": "array",
              "items": { "$ref": "#/$defs/candidate" }
            },
            "ambiguousTerms": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "deterministicBusinessTermCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "kind", "input", "expected"],
      "properties": {
        "case": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "deterministic_business_terms" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["question", "businessDomains", "now"],
          "properties": {
            "question": { "$ref": "#/$defs/nonEmptyString" },
            "businessDomains": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            "now": { "type": "string", "format": "date-time" }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolution", "time", "intent", "structureOperation"],
          "properties": {
            "resolution": { "type": "object" },
            "time": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["granularity", "start", "end", "providedBy"],
                  "properties": {
                    "granularity": { "$ref": "#/$defs/nonEmptyString" },
                    "start": { "$ref": "#/$defs/nonEmptyString" },
                    "end": { "$ref": "#/$defs/nonEmptyString" },
                    "providedBy": { "const": "user" }
                  }
                }
              ]
            },
            "intent": {
              "oneOf": [
                {
                  "enum": ["comparison", "trend", "composition", "ranking", "detail", "single_value"]
                },
                { "type": "null" }
              ]
            },
            "structureOperation": {
              "oneOf": [
                { "enum": ["add", "remove", "replace", "split", "merge"] },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "modelDecisionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "kind", "input", "expected"],
      "properties": {
        "case": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "model_decision" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "rawOutput"],
          "properties": {
            "stage": {
              "enum": ["route_business_domains", "submit_data_request_units", "submit_analysis_intent"]
            },
            "rawOutput": { "type": "object" },
            "hasPreviousUnits": { "type": "boolean" }
          }
        },
        "expected": { "type": "object" }
      }
    },
    "stepEventSequenceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "kind", "input", "expected"],
      "properties": {
        "case": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "step_event_sequence" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runId", "question", "scriptedDecisions"],
          "properties": {
            "runId": { "$ref": "#/$defs/nonEmptyString" },
            "question": { "$ref": "#/$defs/nonEmptyString" },
            "scriptedDecisions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["route", "unit", "intent"],
              "properties": {
                "route": { "type": "array", "items": { "type": "object" } },
                "unit": { "type": "array", "items": { "type": "object" } },
                "intent": { "type": "array", "items": { "type": "object" } }
              }
            },
            "executionFailure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "$ref": "#/$defs/nonEmptyString" },
                "message": { "$ref": "#/$defs/nonEmptyString" }
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "events",
            "portCalls",
            "terminal",
            "documentPresent",
            "executionAttempts"
          ],
          "properties": {
            "events": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["type"]
              }
            },
            "portCalls": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            "terminal": { "enum": ["completed", "interaction_required"] },
            "documentPresent": { "type": "boolean" },
            "executionAttempts": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
