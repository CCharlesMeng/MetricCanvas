{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metriccanvas.local/contracts/agent-conformance/0.1.0",
  "title": "MetricCanvas Agent Conformance Vector",
  "description": "Cross-runtime scripted cases exported from the TypeScript baseline. The first slice freezes deterministic business-term retrieval and disambiguation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "source", "dataContext", "cases"],
  "properties": {
    "formatVersion": { "const": "1.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "module", "dataContext"],
      "properties": {
        "implementation": { "const": "typescript" },
        "module": { "const": "ask/retrieval+ask/model-port" },
        "dataContext": { "type": "string", "minLength": 1 }
      }
    },
    "dataContext": {
      "type": "object",
      "description": "Self-contained neutral Data Context snapshot used to replay every case."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/businessTermCase" },
          { "$ref": "#/$defs/modelDecisionCase" }
        ]
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricName",
        "businessDomain",
        "definition",
        "matchedTerm",
        "score"
      ],
      "properties": {
        "metricName": { "$ref": "#/$defs/nonEmptyString" },
        "businessDomain": { "$ref": "#/$defs/nonEmptyString" },
        "definition": { "type": "string" },
        "unit": { "type": "string" },
        "matchedTerm": { "$ref": "#/$defs/nonEmptyString" },
        "score": { "type": "number" }
      }
    },
    "businessTermCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "kind", "input", "expected"],
      "properties": {
        "case": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "business_term_resolution" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["question", "businessDomains"],
          "properties": {
            "question": { "$ref": "#/$defs/nonEmptyString" },
            "businessDomains": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            "limit": { "type": "integer", "minimum": 1 }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidates", "selected", "ambiguousTerms"],
          "properties": {
            "candidates": {
              "type": "array",
              "items": { "$ref": "#/$defs/candidate" }
            },
            "selected": {
              "type": "array",
              "items": { "$ref": "#/$defs/candidate" }
            },
            "ambiguousTerms": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "modelDecisionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "kind", "input", "expected"],
      "properties": {
        "case": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "model_decision" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "rawOutput"],
          "properties": {
            "stage": {
              "enum": ["route_business_domains", "submit_data_request_units", "submit_analysis_intent"]
            },
            "rawOutput": { "type": "object" },
            "hasPreviousUnits": { "type": "boolean" }
          }
        },
        "expected": { "type": "object" }
      }
    }
  }
}
