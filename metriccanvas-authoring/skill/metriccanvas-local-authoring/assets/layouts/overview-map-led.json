{
  "schemaVersion": "6.40",
  "id": "overview-map-led",
  "layout": "dashboard",
  "meta": {
    "title": "市场概览（布局演示）"
  },
  "dashboardToolbar": "visible",
  "dataSources": {
    "totals": {
      "fields": {
        "visits": {
          "type": "number",
          "role": "measure",
          "label": "访问",
          "defaultFormat": "number"
        },
        "orders": {
          "type": "number",
          "role": "measure",
          "label": "订单",
          "defaultFormat": "number"
        },
        "completed": {
          "type": "number",
          "role": "measure",
          "label": "完成",
          "defaultFormat": "number"
        }
      },
      "source": {
        "type": "inline",
        "rows": [
          {
            "visits": 240,
            "orders": 60,
            "completed": 18
          }
        ]
      }
    },
    "visit-groups": {
      "fields": {
        "category": {
          "type": "string",
          "role": "dimension",
          "label": "分类"
        },
        "count": {
          "type": "number",
          "role": "measure",
          "label": "数量",
          "defaultFormat": "number"
        }
      },
      "source": {
        "type": "inline",
        "rows": [
          {
            "category": "搜索",
            "count": 80
          },
          {
            "category": "直达",
            "count": 80
          },
          {
            "category": "伙伴",
            "count": 80
          }
        ]
      }
    },
    "order-groups": {
      "fields": {
        "category": {
          "type": "string",
          "role": "dimension",
          "label": "分类"
        },
        "count": {
          "type": "number",
          "role": "measure",
          "label": "数量",
          "defaultFormat": "number"
        }
      },
      "source": {
        "type": "inline",
        "rows": [
          {
            "category": "新购",
            "count": 20
          },
          {
            "category": "续购",
            "count": 25
          },
          {
            "category": "扩容",
            "count": 15
          }
        ]
      }
    },
    "service-groups": {
      "fields": {
        "category": {
          "type": "string",
          "role": "dimension",
          "label": "分类"
        },
        "count": {
          "type": "number",
          "role": "measure",
          "label": "数量",
          "defaultFormat": "number"
        }
      },
      "source": {
        "type": "inline",
        "rows": [
          {
            "category": "咨询",
            "count": 6
          },
          {
            "category": "交付",
            "count": 7
          },
          {
            "category": "支持",
            "count": 5
          }
        ]
      }
    },
    "markets": {
      "fields": {
        "country": {
          "type": "string",
          "role": "dimension",
          "label": "国家底图名称"
        },
        "count": {
          "type": "number",
          "role": "measure",
          "label": "数量",
          "defaultFormat": "number"
        }
      },
      "source": {
        "type": "inline",
        "rows": [
          {
            "country": "Canada",
            "count": 12
          },
          {
            "country": "Germany",
            "count": 21
          },
          {
            "country": "Japan",
            "count": 27
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "summary-cards",
      "container": "plain",
      "components": [
        {
          "id": "traffic",
          "type": "compositeCard",
          "layout": {
            "span": 4
          },
          "props": {
            "title": "流量概况",
            "variant": "metricGrid",
            "components": [
              {
                "id": "traffic-headline",
                "type": "metricCard",
                "layout": {
                  "span": 12
                },
                "data": {
                  "main": "totals"
                },
                "props": {
                  "variant": "compactStrip",
                  "rows": [
                    {
                      "label": "本期数量",
                      "valueField": "visits"
                    }
                  ]
                }
              },
              {
                "id": "traffic-distribution",
                "type": "pieChart",
                "layout": {
                  "span": 5
                },
                "data": {
                  "main": "visit-groups"
                },
                "props": {
                  "variant": "compactRing",
                  "categoryField": "category",
                  "valueField": "count"
                }
              },
              {
                "id": "traffic-breakdown",
                "type": "categoryBreakdown",
                "layout": {
                  "span": 7
                },
                "data": {
                  "main": "visit-groups"
                },
                "props": {
                  "variant": "compactList",
                  "categoryField": "category",
                  "columns": [
                    {
                      "label": "数量",
                      "field": "count"
                    }
                  ],
                  "swatches": true
                }
              }
            ]
          }
        },
        {
          "id": "orders",
          "type": "compositeCard",
          "layout": {
            "span": 4
          },
          "props": {
            "title": "订单进度",
            "variant": "metricGrid",
            "components": [
              {
                "id": "orders-headline",
                "type": "metricCard",
                "layout": {
                  "span": 12
                },
                "data": {
                  "main": "totals"
                },
                "props": {
                  "variant": "compactStrip",
                  "rows": [
                    {
                      "label": "本期数量",
                      "valueField": "orders"
                    }
                  ]
                }
              },
              {
                "id": "orders-distribution",
                "type": "pieChart",
                "layout": {
                  "span": 5
                },
                "data": {
                  "main": "order-groups"
                },
                "props": {
                  "variant": "compactRing",
                  "categoryField": "category",
                  "valueField": "count"
                }
              },
              {
                "id": "orders-breakdown",
                "type": "categoryBreakdown",
                "layout": {
                  "span": 7
                },
                "data": {
                  "main": "order-groups"
                },
                "props": {
                  "variant": "compactList",
                  "categoryField": "category",
                  "columns": [
                    {
                      "label": "数量",
                      "field": "count"
                    }
                  ],
                  "swatches": true
                }
              }
            ]
          }
        },
        {
          "id": "service",
          "type": "compositeCard",
          "layout": {
            "span": 4
          },
          "props": {
            "title": "服务复盘",
            "variant": "metricGrid",
            "components": [
              {
                "id": "service-headline",
                "type": "metricCard",
                "layout": {
                  "span": 12
                },
                "data": {
                  "main": "totals"
                },
                "props": {
                  "variant": "compactStrip",
                  "rows": [
                    {
                      "label": "本期数量",
                      "valueField": "completed"
                    }
                  ]
                }
              },
              {
                "id": "service-distribution",
                "type": "pieChart",
                "layout": {
                  "span": 5
                },
                "data": {
                  "main": "service-groups"
                },
                "props": {
                  "variant": "compactRing",
                  "categoryField": "category",
                  "valueField": "count"
                }
              },
              {
                "id": "service-breakdown",
                "type": "categoryBreakdown",
                "layout": {
                  "span": 7
                },
                "data": {
                  "main": "service-groups"
                },
                "props": {
                  "variant": "compactList",
                  "categoryField": "category",
                  "columns": [
                    {
                      "label": "数量",
                      "field": "count"
                    }
                  ],
                  "swatches": true
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "detail-and-map",
      "container": "plain",
      "components": [
        {
          "id": "details",
          "type": "tabContainer",
          "layout": {
            "span": 4
          },
          "props": {
            "defaultTab": "overview",
            "tabs": [
              {
                "id": "overview",
                "label": "概览",
                "component": {
                  "id": "overview-table",
                  "type": "table",
                  "layout": {
                    "span": 12
                  },
                  "data": {
                    "main": "markets"
                  },
                  "props": {
                    "columns": [
                      {
                        "field": "country",
                        "title": "国家"
                      },
                      {
                        "field": "count",
                        "title": "数量",
                        "sortable": true
                      }
                    ],
                    "fit": "container"
                  }
                }
              },
              {
                "id": "detail",
                "label": "明细",
                "component": {
                  "id": "detail-table",
                  "type": "table",
                  "layout": {
                    "span": 12
                  },
                  "data": {
                    "main": "markets"
                  },
                  "props": {
                    "columns": [
                      {
                        "field": "country",
                        "title": "国家"
                      },
                      {
                        "field": "count",
                        "title": "数量",
                        "sortable": true
                      }
                    ],
                    "fit": "container"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "market-map",
          "type": "mapChart",
          "layout": {
            "span": 8
          },
          "data": {
            "main": "markets"
          },
          "props": {
            "title": "国家样例分布",
            "map": "world",
            "nameField": "country",
            "valueField": "count"
          }
        }
      ]
    }
  ]
}
