{
  "schemaVersion": "6.56",
  "id": "tab-content-mapchart",
  "layout": "dashboard",
  "filters": [
    {
      "id": "map-region",
      "type": "dimension",
      "dimension": "chart_demo_region",
      "label": "区域分布区域",
      "default": [
        "CN"
      ]
    }
  ],
  "dataSources": {
    "map-data": {
      "fields": {
        "category": {
          "type": "string",
          "role": "dimension",
          "queryField": "chart_demo_country"
        },
        "value": {
          "type": "number",
          "role": "measure",
          "queryField": "chart_demo_map"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "filterBindings": {
            "map-region": {
              "target": "dimension",
              "queryField": "chart_demo_region"
            }
          },
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "chart_demo_country"
                ],
                "output_metrics": [
                  "chart_demo_map"
                ],
                "filter": {
                  "dims": [],
                  "metrics": []
                },
                "order": {}
              }
            ]
          }
        }
      }
    }
  },
  "sections": [
    {
      "id": "main",
      "components": [
        {
          "id": "map-filter",
          "type": "filterGroup",
          "layout": {
            "span": 12
          },
          "props": {
            "filterId": "map-region",
            "options": [
              {
                "label": "中国区",
                "value": "CN"
              },
              {
                "label": "海外",
                "value": "OVERSEAS"
              }
            ]
          }
        }
      ]
    }
  ]
}
