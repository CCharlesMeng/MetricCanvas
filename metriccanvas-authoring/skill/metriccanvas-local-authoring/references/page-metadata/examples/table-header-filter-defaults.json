{
  "schemaVersion": "6.100",
  "id": "table-header-filter-defaults",
  "layout": "dashboard",
  "meta": {
    "title": "表头筛选：URL 参数初值",
    "description": "内联合成数据。URL 初始化是、否或不限，手动修改后保持当前表头会话；下方保留固定默认值对照。"
  },
  "filters": [
    {
      "id": "show-status",
      "type": "dimension",
      "dimension": "column-visibility",
      "label": "审批状态列",
      "default": [
        "show"
      ],
      "options": [
        {
          "value": "show",
          "label": "显示审批状态"
        },
        {
          "value": "hide",
          "label": "隐藏审批状态"
        }
      ],
      "selection": {
        "mode": "single",
        "required": true
      }
    }
  ],
  "dataSources": {
    "records": {
      "fields": {
        "id": {
          "type": "string",
          "role": "dimension"
        },
        "status": {
          "type": "string",
          "role": "dimension"
        },
        "code": {
          "type": "number",
          "role": "dimension"
        },
        "region": {
          "type": "string",
          "role": "dimension"
        }
      },
      "source": {
        "type": "inline",
        "rows": [
          {
            "id": "A001",
            "status": "pending",
            "code": 1,
            "region": "华东"
          },
          {
            "id": "A002",
            "status": "approved",
            "code": 1,
            "region": "华南"
          },
          {
            "id": "A003",
            "status": "pending",
            "code": 1,
            "region": "华北"
          },
          {
            "id": "A004",
            "status": "pending",
            "code": 2,
            "region": "华东"
          },
          {
            "id": "A005",
            "status": "approved",
            "code": 2,
            "region": "华北"
          },
          {
            "id": "A006",
            "status": "rejected",
            "code": 1,
            "region": "华南"
          }
        ]
      }
    },
    "decisions": {
      "fields": {
        "record-id": {
          "type": "string",
          "role": "dimension"
        },
        "is-valid": {
          "type": "string",
          "role": "dimension",
          "nullable": true
        }
      },
      "source": {
        "type": "inline",
        "rows": [
          {
            "record-id": "有效记录",
            "is-valid": "是"
          },
          {
            "record-id": "无效记录",
            "is-valid": "否"
          },
          {
            "record-id": "空值记录",
            "is-valid": null
          },
          {
            "record-id": "未知记录",
            "is-valid": "待定"
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "description",
      "components": [
        {
          "id": "page-header",
          "type": "iocHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "identity": {
              "title": "表头筛选：URL 参数初值"
            },
            "filterIds": [
              "show-status"
            ]
          }
        },
        {
          "id": "description",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "内联合成数据。点击入口切换 URL，打开表头查看勾选；手动选择或清空后，翻页与导出保持当前条件。下方保留固定默认值对照。"
          }
        },
        {
          "id": "url-0",
          "type": "button",
          "layout": {
            "span": 4
          },
          "props": {
            "label": "URL：是",
            "action": {
              "on": "click",
              "navigate": {
                "href": "/pages/table-header-filter-defaults?is-valid=是"
              }
            }
          }
        },
        {
          "id": "url-1",
          "type": "button",
          "layout": {
            "span": 4
          },
          "props": {
            "label": "URL：否",
            "action": {
              "on": "click",
              "navigate": {
                "href": "/pages/table-header-filter-defaults?is-valid=否"
              }
            }
          }
        },
        {
          "id": "url-2",
          "type": "button",
          "layout": {
            "span": 4
          },
          "props": {
            "label": "URL：不限",
            "action": {
              "on": "click",
              "navigate": {
                "href": "/pages/table-header-filter-defaults"
              }
            }
          }
        }
      ]
    },
    {
      "id": "parameter-initialization",
      "components": [
        {
          "id": "param-unrestricted",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "decisions"
          },
          "props": {
            "title": "参数初值（全选不限）",
            "columns": [
              {
                "field": "record-id",
                "title": "记录"
              },
              {
                "field": "is-valid",
                "title": "是否有效意见",
                "enumValues": [
                  {
                    "value": "是",
                    "label": "是"
                  },
                  {
                    "value": "否",
                    "label": "否"
                  }
                ],
                "filterable": {
                  "mode": "select",
                  "initialParam": "is-valid",
                  "allBehavior": "unrestricted"
                }
              }
            ],
            "pagination": {
              "mode": "local",
              "pageSize": 2
            },
            "toolbar": {
              "export": {
                "format": "xlsx",
                "filename": "param-unrestricted"
              }
            }
          }
        },
        {
          "id": "param-values",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "decisions"
          },
          "props": {
            "title": "参数初值（显式值集合）",
            "columns": [
              {
                "field": "record-id",
                "title": "记录"
              },
              {
                "field": "is-valid",
                "title": "是否有效意见",
                "enumValues": [
                  {
                    "value": "是",
                    "label": "是"
                  },
                  {
                    "value": "否",
                    "label": "否"
                  }
                ],
                "filterable": {
                  "mode": "select",
                  "initialParam": "is-valid",
                  "allBehavior": "values"
                }
              }
            ],
            "pagination": {
              "mode": "local",
              "pageSize": 2
            },
            "toolbar": {
              "export": {
                "format": "xlsx",
                "filename": "param-values"
              }
            }
          }
        },
        {
          "id": "param-tabs",
          "type": "tabContainer",
          "layout": {
            "span": 12
          },
          "props": {
            "tabs": [
              {
                "id": "details",
                "label": "参数明细",
                "component": {
                  "id": "param-tab-records",
                  "type": "table",
                  "layout": {
                    "span": 12
                  },
                  "data": {
                    "main": "decisions"
                  },
                  "props": {
                    "title": "参数 Tab 会话",
                    "columns": [
                      {
                        "field": "record-id",
                        "title": "记录"
                      },
                      {
                        "field": "is-valid",
                        "title": "是否有效意见",
                        "enumValues": [
                          {
                            "value": "是",
                            "label": "是"
                          },
                          {
                            "value": "否",
                            "label": "否"
                          }
                        ],
                        "filterable": {
                          "mode": "select",
                          "initialParam": "is-valid",
                          "allBehavior": "unrestricted"
                        }
                      }
                    ],
                    "pagination": {
                      "mode": "local",
                      "pageSize": 2
                    },
                    "toolbar": {
                      "export": {
                        "format": "xlsx",
                        "filename": "param-unrestricted"
                      }
                    }
                  }
                }
              },
              {
                "id": "other",
                "label": "其他面板",
                "component": {
                  "id": "tab-text",
                  "type": "text",
                  "layout": {
                    "span": 12
                  },
                  "props": {
                    "body": "返回参数明细时保留用户选择。"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "tables",
      "components": [
        {
          "id": "default-records",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "records"
          },
          "props": {
            "title": "待审批且编码为1",
            "rowKey": "id",
            "columns": [
              {
                "field": "id",
                "title": "记录编号",
                "width": 120
              },
              {
                "field": "status",
                "title": "审批状态",
                "enumValues": [
                  {
                    "value": "pending",
                    "label": "待审批"
                  },
                  {
                    "value": "approved",
                    "label": "已通过"
                  },
                  {
                    "value": "rejected",
                    "label": "已拒绝"
                  }
                ],
                "filterable": {
                  "mode": "select",
                  "defaultValues": [
                    "pending"
                  ]
                },
                "visibleWhen": {
                  "filter": "show-status",
                  "part": "values",
                  "op": "containsAny",
                  "values": [
                    "show"
                  ]
                },
                "width": 140
              },
              {
                "field": "code",
                "title": "数值编码",
                "filterable": {
                  "mode": "select",
                  "defaultValues": [
                    1
                  ]
                },
                "width": 120
              },
              {
                "field": "region",
                "title": "区域",
                "width": 120
              }
            ],
            "pagination": {
              "mode": "local",
              "pageSize": 2
            },
            "toolbar": {
              "export": {
                "format": "xlsx",
                "filename": "default-records"
              }
            }
          }
        },
        {
          "id": "other-records",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "records"
          },
          "props": {
            "title": "同源独立默认值",
            "rowKey": "id",
            "columns": [
              {
                "field": "id",
                "title": "记录编号",
                "width": 120
              },
              {
                "field": "status",
                "title": "审批状态",
                "enumValues": [
                  {
                    "value": "pending",
                    "label": "待审批"
                  },
                  {
                    "value": "approved",
                    "label": "已通过"
                  },
                  {
                    "value": "rejected",
                    "label": "已拒绝"
                  }
                ],
                "filterable": {
                  "mode": "select",
                  "defaultValues": [
                    "approved"
                  ]
                },
                "width": 140
              }
            ],
            "pagination": {
              "mode": "local",
              "pageSize": 2
            },
            "toolbar": {
              "export": {
                "format": "xlsx",
                "filename": "other-records"
              }
            }
          }
        },
        {
          "id": "missing-records",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "records"
          },
          "props": {
            "title": "默认值当前无匹配记录",
            "rowKey": "id",
            "columns": [
              {
                "field": "id",
                "title": "记录编号",
                "width": 120
              },
              {
                "field": "status",
                "title": "审批状态",
                "filterable": {
                  "mode": "select",
                  "defaultValues": [
                    "archived"
                  ]
                },
                "width": 140
              }
            ],
            "pagination": {
              "mode": "local",
              "pageSize": 2
            },
            "toolbar": {
              "export": {
                "format": "xlsx",
                "filename": "missing-records"
              }
            }
          }
        }
      ]
    }
  ],
  "params": {
    "query": {
      "dimensions": [
        {
          "id": "is-valid",
          "dim_name": "是否有效意见",
          "required": false
        }
      ]
    }
  }
}
