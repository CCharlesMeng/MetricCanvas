    "detail": {
      "fields": {
        "period": {
          "type": "string",
          "role": "dimension",
          "queryField": "period"
        },
        "value": {
          "type": "number",
          "role": "measure",
          "queryField": "value"
        }
      },
      "source": {
        "type": "query",
        "resultScope": "complete",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "period"
                ],
                "output_metrics": [
                  "value"
                ],
                "filter": {
                  "dims": [],
                  "metrics": []
                },
                "order": {}
              }
            ]
          },
          "filterBindings": {
            "detail-customer": {
              "target": "dimension",
              "queryField": "customer"
            }
          }
        }
      }
