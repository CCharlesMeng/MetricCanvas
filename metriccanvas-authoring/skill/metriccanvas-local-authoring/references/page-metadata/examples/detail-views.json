  "sections": [
    {
      "id": "common",
      "components": [
        {
          "id": "intro",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "匿名功能验收：内容切换保留局部状态。"
          }
        }
      ]
    },
    {
      "id": "main",
      "title": "分区A",
      "components": [
        {
          "id": "main-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "rows"
          },
          "props": {
            "title": "明细A",
            "columns": [
              {
                "field": "name",
                "title": "名称",
                "link": true
              },
              {
                "field": "amount",
                "sortable": true,
                "title": "金额"
              }
            ],
            "pagination": {
              "mode": "local",
              "pageSize": 10
            },
            "actions": [
              {
                "on": "click",
                "openDetail": {
                  "surface": "drawer",
                  "titleField": "name",
                  "view": "trend",
                  "bindings": {
                    "detail-customer": {
                      "source": "row",
                      "field": "name"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "detailViews": [
    {
      "id": "trend",
      "mode": "query",
      "filters": [
        "detail-customer"
      ],
      "components": [
        {
          "id": "detail-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "detail"
          },
          "props": {
            "columns": [
              {
                "field": "period"
              },
              {
                "field": "value",
                "sortable": true
              }
            ],
            "pagination": {
              "mode": "local",
              "pageSize": 10
            }
          }
        }
      ]
    }
  ]
}
