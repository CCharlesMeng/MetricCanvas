    {
      "id": "sales-detail",
      "title": "经营明细（合成数据）",
      "container": "plain",
      "components": [
        {
          "id": "sales-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "sales"
          },
          "props": {
            "columns": [
              {
                "field": "region",
                "title": "区域"
              },
              {
                "field": {
                  "field": "amount",
                  "format": "number-grouped",
                  "data": "main"
                },
                "title": "金额（元）"
              }
            ],
            "pagination": {
              "mode": "local",
              "pageSize": 10
            }
          }
        }
      ]
    },
    {
      "id": "no-date",
      "container": "plain",
      "components": [
        {
          "id": "default-download-header",
          "type": "reportHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "title": "无日期工具带的默认下载按钮",
            "subtitle": "pdfExport={}，默认显示“下载 PDF”，文件名取本页头标题；仍下载整份报告。",
            "pdfExport": {}
          }
        }
      ]
    },
    {
      "id": "without-export",
      "container": "plain",
      "components": [
        {
          "id": "ordinary-header",
          "type": "reportHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "title": "未启用下载的对照页头",
            "subtitle": "没有 pdfExport，不显示日期或下载工具带。"
          }
        }
      ]
    }
