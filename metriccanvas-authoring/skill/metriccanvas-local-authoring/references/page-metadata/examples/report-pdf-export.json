          "layout": {
            "span": 12
          },
          "props": {
            "title": {
              "parts": [
                {
                  "filter": "report-month",
                  "format": "period"
                },
                " 经营分析报告"
              ]
            },
            "subtitle": "本地合成数据。更改月份后，报告标题、期间和 PDF 文件名一起变化；导出包含所有正文。",
            "filterIds": [
              "report-month"
            ],
            "asOf": {
              "label": "统计期间",
              "value": {
                "filter": "report-month",
                "format": "period"
              }
            },
            "pdfExport": {
              "label": "下载经营报告",
              "filename": {
                "parts": [
