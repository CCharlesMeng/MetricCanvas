{
  "schemaVersion": "6.51",
  "id": "page-visibility-region-linkage",
  "layout": "dashboard",
  "meta": {
    "title": "统一条件显隐与地区层级联动"
  },
  "filters": [
    {
      "id": "organization",
      "type": "dimension",
      "dimension": "world",
      "label": "组织层级",
      "hierarchy": [
        {
          "id": "global",
          "dimension": "world",
          "label": "全球"
        },
        {
          "id": "department",
          "dimension": "department",
          "label": "地区部"
        },
        {
          "id": "office",
          "dimension": "office",
          "label": "代表处"
        }
      ],
      "defaultLevel": "global"
    },
    {
      "id": "mode",
      "type": "dimension",
      "dimension": "mode",
      "visible": false,
      "default": [
        "base"
      ]
    }
  ],
  "dataSources": {
    "rows": {
      "fields": {
        "id": {
          "type": "string",
          "role": "dimension"
        },
        "name": {
          "type": "string",
          "role": "dimension"
        },
        "kind": {
          "type": "string",
          "role": "dimension"
        },
        "amount": {
          "type": "number",
          "role": "measure"
        }
      },
      "source": {
        "type": "inline",
        "rows": [
          {
            "id": "d",
            "name": "地区部规范",
            "kind": "department",
            "amount": 100
          },
          {
            "id": "a",
            "name": "代表处 A",
            "kind": "office",
            "amount": 60
          },
          {
            "id": "b",
            "name": "代表处 B",
            "kind": "office",
            "amount": 40
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "controls",
      "container": "card",
      "title": "交互入口",
      "components": [
        {
          "id": "show-more",
          "type": "button",
          "layout": {
            "span": 3
          },
          "props": {
            "label": "显示扩展内容",
            "action": {
              "on": "click",
              "writeFilter": "mode",
              "value": "extended"
            }
          }
        },
        {
          "id": "show-base",
          "type": "button",
          "layout": {
            "span": 3
          },
          "props": {
            "label": "恢复基础内容",
            "action": {
              "on": "click",
              "writeFilter": "mode",
              "value": "base"
            }
          }
        },
        {
          "id": "explanation",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "切到地区部层级时，下面整个行权规范分区隐藏。父容器不因子项隐藏而自动收起。"
          }
        }
      ]
    },
    {
      "id": "department-norms",
      "title": "地区部行权规范情况",
      "container": "card",
      "visibleWhen": {
        "filter": "organization",
        "part": "level",
        "op": "ne",
        "value": "department"
      },
      "components": [
        {
          "id": "department-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "rows"
          },
          "props": {
            "rowKey": "id",
            "columns": [
              {
                "field": "name",
                "title": "名称"
              },
              {
                "field": "amount",
                "title": "金额"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "retained-container",
      "title": "保留的父容器",
      "container": "card",
      "components": [
        {
          "id": "conditional-child",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "此子项只在非地区部层级显示。"
          },
          "visibleWhen": {
            "filter": "organization",
            "part": "level",
            "op": "ne",
            "value": "department"
          }
        }
      ]
    },
    {
      "id": "rows-and-tabs",
      "container": "card",
      "title": "行投影、Tab 与文字",
      "components": [
        {
          "id": "projected-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "rows"
          },
          "props": {
            "rowKey": "id",
            "columns": [
              {
                "field": "name",
                "title": "名称",
                "link": true,
                "navigate": {
                  "href": "/pages/page-visibility-inputs",
                  "visibleWhen": {
                    "row": "kind",
                    "op": "eq",
                    "value": "office"
                  },
                  "enabledWhen": {
                    "filter": "mode",
                    "part": "values",
                    "op": "containsAny",
                    "values": [
                      "extended"
                    ]
                  }
                }
              },
              {
                "field": "amount",
                "title": "金额"
              }
            ],
            "rowVisibleWhen": {
              "any": [
                {
                  "row": "kind",
                  "op": "ne",
                  "value": "department"
                },
                {
                  "filter": "organization",
                  "part": "level",
                  "op": "ne",
                  "value": "department"
                }
              ]
            },
            "pagination": {
              "mode": "local",
              "pageSize": 2
            },
            "toolbar": {
              "export": {
                "format": "xlsx"
              }
            }
          }
        },
        {
          "id": "conditional-text",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "parts": [
              {
                "id": "base",
                "text": "当前展示："
              },
              {
                "id": "dept",
                "text": "地区部，",
                "visibleWhen": {
                  "filter": "organization",
                  "part": "level",
                  "op": "eq",
                  "value": "department"
                }
              },
              {
                "id": "other",
                "text": "其他层级，",
                "visibleWhen": {
                  "filter": "organization",
                  "part": "level",
                  "op": "ne",
                  "value": "department"
                }
              },
              {
                "id": "end",
                "text": "文字使用同一条件求值。"
              }
            ]
          }
        },
        {
          "id": "tabs",
          "type": "tabContainer",
          "layout": {
            "span": 12
          },
          "props": {
            "defaultTab": "department",
            "initialTabUrlParam": "view",
            "tabs": [
              {
                "id": "department",
                "label": "地区部",
                "visibleWhen": {
                  "filter": "organization",
                  "part": "level",
                  "op": "ne",
                  "value": "department"
                },
                "component": {
                  "id": "tab-department",
                  "type": "table",
                  "layout": {
                    "span": 12
                  },
                  "data": {
                    "main": "rows"
                  },
                  "props": {
                    "rowKey": "id",
                    "columns": [
                      {
                        "field": "name",
                        "title": "名称"
                      },
                      {
                        "field": "amount",
                        "title": "金额"
                      }
                    ]
                  }
                }
              },
              {
                "id": "office",
                "label": "代表处",
                "component": {
                  "id": "tab-office",
                  "type": "table",
                  "layout": {
                    "span": 12
                  },
                  "data": {
                    "main": "rows"
                  },
                  "props": {
                    "rowKey": "id",
                    "columns": [
                      {
                        "field": "name",
                        "title": "名称"
                      },
                      {
                        "field": "amount",
                        "title": "金额"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "extra",
      "title": "扩展内容",
      "visibleWhen": {
        "filter": "mode",
        "part": "values",
        "op": "containsAny",
        "values": [
          "extended"
        ]
      },
      "components": [
        {
          "id": "extra-text",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "按钮通过共享筛选状态改变分区资格。"
          }
        }
      ]
    },
    {
      "id": "group-a",
      "title": "组A内容",
      "components": [
        {
          "id": "group-a-text",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "组A恢复资格时保留当前有效选择。"
          }
        }
      ]
    },
    {
      "id": "group-b",
      "title": "组B空内容时仍保留",
      "components": [
        {
          "id": "group-b-text",
          "type": "text",
          "layout": {
            "span": 12
          },
          "visibleWhen": {
            "filter": "organization",
            "part": "level",
            "op": "ne",
            "value": "department"
          },
          "props": {
            "body": "切到地区部仅隐藏此子项，保留组B入口。"
          }
        }
      ]
    }
  ],
  "sectionGroups": [
    {
      "id": "overview-group",
      "label": "条件组A",
      "sectionIds": [
        "group-a"
      ],
      "visibleWhen": {
        "all": [
          {
            "filter": "organization",
            "part": "level",
            "op": "ne",
            "value": "department"
          },
          {
            "filter": "mode",
            "part": "values",
            "op": "containsAny",
            "values": [
              "base"
            ]
          }
        ]
      }
    },
    {
      "id": "detail-group",
      "label": "条件组B",
      "sectionIds": [
        "group-b"
      ],
      "visibleWhen": {
        "filter": "mode",
        "part": "values",
        "op": "containsAny",
        "values": [
          "base"
        ]
      }
    }
  ],
  "defaultSectionGroup": "overview-group"
}
