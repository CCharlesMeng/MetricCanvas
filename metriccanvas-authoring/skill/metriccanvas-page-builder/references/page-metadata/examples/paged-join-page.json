                  "format": "cny-adaptive"
                },
                "title": "预签金额",
                "align": "right",
                "sortable": true,
                "filterable": {
                  "mode": "numberRange"
                }
              },
              {
                "field": {
                  "data": "main",
                  "field": "support-rate",
                  "format": "percent-1"
                },
