{
  "schemaVersion": "6.53",
  "id": "ioc-header-groups",
  "layout": "dashboard",
  "meta": {
    "title": "IOC页头 · 协同小组权限输入"
  },
  "iocHeader": {
    "identity": {
      "title": "协同小组权限输入",
      "tags": [
        {
          "text": "合成候选与查询",
          "id": "tag-0"
        }
      ]
    },
    "back": true,
    "filterIds": [
      "group"
    ],
    "presentation": {
      "layout": "inline",
      "collapse": "none"
    }
  },
  "filters": [
    {
      "id": "group",
      "type": "dimension",
      "dimension": "group",
      "label": "协同小组",
      "urlParams": {
        "value": "group"
      },
      "default": [
        "GROUP-A"
      ],
      "selection": {
        "mode": "multiple",
        "required": true
      },
      "candidateContext": {
        "filterIds": [],
