{
  "schemaVersion": "6.5",
  "id": "composite-page",
  "layout": "dashboard",
  "dashboardToolbar": {
    "variant": "compact",
    "readOnly": true,
    "note": "只读"
  },
  "dataSources": {
    "top": {
      "fields": {
        "name": {
          "queryField": "name",
          "type": "string",
          "role": "dimension"
        },
        "value": {
          "queryField": "value",
          "type": "number",
          "role": "measure"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "name"
                ],
                "output_metrics": [
                  "value"
                ],
                "filter": {
                  "dims": [],
                  "metrics": []
                },
                "order": {
                  "offset": 0,
                  "limit": 10
                }
              }
            ]
          }
        }
      }
    }
  },
  "sections": [
    {
      "id": "main",
      "components": [
        {
          "id": "top-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "top"
          },
          "props": {
            "variant": "embedded",
            "bottomFade": true,
            "columns": [
              {
                "field": "name"
              },
              {
                "field": "value"
              }
            ]
          }
        }
      ]
    }
  ]
}
