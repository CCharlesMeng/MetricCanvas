{
  "schemaVersion": "6.121",
  "id": "ioc-office-drill-detail",
  "layout": "dashboard",
  "meta": {
    "title": "代表处详情 · 合成演示"
  },
  "filters": [
    {
      "id": "stat-period",
      "type": "timeRange",
      "display": "period",
      "periodModes": [
        "year",
        "quarter",
        "month",
        "last12Months"
      ],
      "precision": "month",
      "default": {
        "mode": "quarter",
        "value": "2026-Q3"
      },
      "label": "统计期间",
      "urlParams": {
        "value": "period",
        "from": "period-from",
        "to": "period-to"
      }
    }
  ],
  "dataSources": {},
  "sections": [
    {
      "id": "main",
      "components": [
        {
          "id": "header",
          "type": "iocHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "identity": {
              "title": "代表处详情"
            },
            "presentation": {
              "layout": "inline",
              "density": "normal",
              "collapse": "none"
            },
            "components": [
              {
                "id": "year-control",
                "type": "filterControl",
                "props": {
                  "filterId": "stat-period"
                }
              },
              {
                "id": "region-control",
                "type": "regionFilter"
              }
            ],
            "back": true
          }
        },
        {
          "id": "detail-note",
          "type": "text",
          "layout": {
            "span": 12
          },
          "props": {
            "body": "下钻页从 URL 初始化代表处与统计期间。"
          }
        }
      ]
    }
  ]
}
