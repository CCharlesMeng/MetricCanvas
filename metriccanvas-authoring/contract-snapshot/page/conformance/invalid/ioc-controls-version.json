          },
          "department-value": {
            "type": "string",
            "role": "dimension"
          },
          "office-name": {
            "type": "string",
            "role": "dimension"
          },
          "office-value": {
            "type": "string",
            "role": "dimension"
          }
        },
        "source": {
          "type": "inline",
