            "type": "string",
            "role": "dimension",
            "label": "生效组织",
            "queryField": "地区部"
          },
          "amount": {
            "type": "number",
            "role": "measure",
            "label": "合成金额",
            "queryField": "金额"
          }
        },
        "source": {
          "type": "query",
          "query": {
            "language": "dqe",
            "body": {
              "dsl_list": [
                {
                  "output_dims": [
                    "地区部"
                  ],
                  "output_metrics": [
                    "金额"
                  ],
                  "filter": {
                    "time": {
                      "period": "month",
                      "is_aggregate": true
                    },
                    "dims": [],
                    "metrics": []
                  }
                }
              ]
            },
            "filterBindings": {
              "stat-year": {
                "target": "time"
              },
              "region": {
                "target": "dimension",
                "levelQueryFields": {
                  "geo": "地理区",
                  "region-dept": "地区部",
                  "office": "代表处"
                }
              }
            }
          }
        }
      }
    },
    "sections": [
      {
        "id": "main",
        "components": [
          {
            "id": "header",
            "type": "iocHeader",
            "layout": {
              "span": 12
            },
            "props": {
              "identity": {
                "title": "IOC Header 子控件"
              },
              "presentation": {
                "layout": "inline",
                "density": "normal",
                "collapse": "none"
              },
              "components": [
                {
                  "id": "year-control",
