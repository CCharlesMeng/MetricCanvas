                  "selection": {
                    "writes": {
                      "region": {
                        "field": "department-value",
                        "level": "region-dept"
                      }
                    }
                  }
                },
                {
                  "field": "office-name",
                  "title": "点击选择代表处",
                  "selection": {
                    "writes": {
                      "region": {
                        "field": "office-value",
                        "level": "office"
                      }
                    }
                  }
                }
              ]
            }
          },
          {
            "id": "results",
            "type": "table",
            "layout": {
              "span": 12
            },
            "data": {
