{
  "case": "pagination-shared-source",
  "invariant": "pagination-exclusive-source",
  "input": {
    "schemaVersion": "5.0",
    "id": "query-dashboard",
    "dataSources": {
      "sales": {
        "fields": {
          "region": {
            "queryField": "region",
            "type": "string",
            "role": "dimension",
            "nullable": false
          },
          "gmv": {
            "queryField": "gmv",
            "type": "number",
            "role": "measure",
            "nullable": false
          }
        },
        "source": {
          "type": "query",
          "query": {
            "language": "dqe",
            "body": {
              "dsl_list": [
                {
                  "output_dims": [
                    "region"
                  ],
                  "output_metrics": [
                    "gmv"
                  ],
                  "filter": {
                    "dims": [],
                    "metrics": []
                  },
                  "order": {
                    "offset": 0,
                    "limit": 20
                  }
                }
              ]
            },
            "filterBindings": {
              "region-filter": {
                "target": "dimension",
                "queryField": "region"
              }
            }
          }
        }
      }
    },
    "filters": [
      {
        "id": "region-filter",
        "type": "dimension",
        "dimension": "region"
      }
    ],
    "sections": [
      {
        "id": "details",
        "components": [
          {
            "id": "sales-table",
            "type": "table",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "sales"
            },
            "props": {
              "columns": [
                {
                  "field": "region"
                },
                {
                  "field": "gmv"
                }
              ],
              "pagination": {
                "mode": "query"
              },
              "actions": [
                {
                  "on": "click",
                  "writeFilter": "region-filter",
                  "field": "region"
                }
              ]
            }
          },
          {
            "id": "sales-pie",
            "type": "pieChart",
            "layout": {
              "span": 6
            },
            "data": {
              "main": "sales"
            },
            "props": {
              "categoryField": "region",
              "valueField": "gmv"
            }
          }
        ]
      }
    ]
  },
  "expected": [
    {
      "type": "SCHEMA_ERROR",
      "path": "/sections/0/components/0/data/main",
      "message": "查询分页表格必须独占页面数据源 sales，当前引用 2 次"
    }
  ]
}
