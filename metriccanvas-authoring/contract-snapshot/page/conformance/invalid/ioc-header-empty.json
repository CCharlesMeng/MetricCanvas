{
  "case": "ioc-header-empty",
  "invariant": "ioc-header",
  "input": {
    "schemaVersion": "6.37",
    "id": "ioc-header-page",
    "layout": "dashboard",
    "dashboardToolbar": "hidden",
    "meta": {
      "title": "IOC 公共页头：普通验收",
      "description": "本地DQE仿真合成验收，条件回显不是业务指标。"
    },
    "iocHeader": {},
    "filters": [
      {
        "id": "period",
        "type": "timeRange",
        "display": "period",
        "precision": "month",
        "required": true,
        "label": "统计期间",
        "default": {
          "mode": "month",
          "value": "2026-09"
        }
      },
      {
        "id": "region",
        "type": "dimension",
        "dimension": "geo-pc-code",
        "label": "区域",
        "hierarchy": [
          {
            "id": "geo",
            "dimension": "geo-pc-code",
            "label": "全球"
          },
          {
            "id": "region-dept",
            "dimension": "region-dept-code",
            "label": "地区部"
          },
          {
            "id": "office",
            "dimension": "rep-office-code",
            "label": "代表处"
          }
        ],
        "defaultLevel": "geo",
        "display": "tree",
        "treeSelection": "level",
        "selection": {
          "mode": "single"
        }
      }
    ],
    "dataSources": {
      "bound": {
        "fields": {
          "scope": {
            "type": "string",
            "role": "dimension",
            "queryField": "ioc_header_scope"
          },
          "count": {
            "type": "number",
            "role": "measure",
            "queryField": "ioc_header_count"
          }
        },
        "source": {
          "type": "query",
          "query": {
            "language": "dqe",
            "body": {
              "dsl_list": [
                {
                  "output_dims": [
                    "ioc_header_scope"
                  ],
                  "output_metrics": [
                    "ioc_header_count"
                  ],
                  "filter": {
                    "dims": [],
                    "time": {
                      "period": "month",
                      "is_aggregate": false
                    }
                  },
                  "order": {
                    "limit": 10,
                    "offset": 0
                  }
                }
              ]
            },
            "filterBindings": {
              "period": {
                "target": "time"
              },
              "region": {
                "target": "dimension",
                "levelQueryFields": {
                  "geo": "geo_pc_code",
                  "region-dept": "region_dept_code",
                  "office": "rep_office_code"
                }
              }
            }
          }
        }
      },
      "unbound": {
        "fields": {
          "scope": {
            "type": "string",
            "role": "dimension",
            "queryField": "ioc_header_scope"
          },
          "count": {
            "type": "number",
            "role": "measure",
            "queryField": "ioc_header_count"
          }
        },
        "source": {
          "type": "query",
          "query": {
            "language": "dqe",
            "body": {
              "dsl_list": [
                {
                  "output_dims": [
                    "ioc_header_scope"
                  ],
                  "output_metrics": [
                    "ioc_header_count"
                  ],
                  "filter": {
                    "dims": []
                  },
                  "order": {
                    "limit": 10,
                    "offset": 0
                  }
                }
              ]
            }
          }
        }
      }
    },
    "sections": [
      {
        "id": "body",
        "container": "card",
        "components": [
          {
            "id": "bound-table",
            "type": "table",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "bound"
            },
            "props": {
              "title": "已绑定条件",
              "columns": [
                {
                  "field": "scope",
                  "title": "服务收到的条件（本地合成）"
                },
                {
                  "field": "count",
                  "title": "合成响应标识"
                }
              ],
              "pagination": {
                "mode": "query"
              },
              "toolbar": {
                "export": {
                  "format": "xlsx",
                  "filename": "本地页头验收"
                }
              }
            }
          },
          {
            "id": "unbound-table",
            "type": "table",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "unbound"
            },
            "props": {
              "title": "无关查询（不随筛选刷新）",
              "columns": [
                {
                  "field": "scope",
                  "title": "服务收到的条件（本地合成）"
                },
                {
                  "field": "count",
                  "title": "合成响应标识"
                }
              ],
              "pagination": {
                "mode": "query"
              },
              "toolbar": {
                "export": {
                  "format": "xlsx",
                  "filename": "本地页头验收"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "expected": [
    {
      "type": "SCHEMA_ERROR",
      "path": "/iocHeader",
      "message": "IOC 页头需要身份、筛选或返回意图"
    }
  ]
}
