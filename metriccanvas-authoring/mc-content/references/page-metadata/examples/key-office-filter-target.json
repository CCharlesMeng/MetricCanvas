{
  "schemaVersion": "6.99",
  "id": "key-office-filter-target",
  "layout": "dashboard",
  "meta": {
    "title": "重点国代下钻 合成数据"
  },
  "filters": [
    {
      "id": "region",
      "type": "dimension",
      "dimension": "demo_region",
      "label": "Region",
      "selection": {
        "mode": "single"
      },
      "display": "tree",
      "treeSelection": "level",
      "hierarchy": [
        {
          "id": "region-dept",
          "dimension": "demo_region",
          "label": "地区部"
        },
        {
          "id": "office",
          "dimension": "demo_office",
          "label": "代表处"
        }
      ],
      "defaultLevel": "region-dept"
    },
    {
      "id": "key-office",
      "type": "boolean",
      "label": "仅看重点国代"
    },
    {
      "id": "mtime",
      "type": "timePoint",
      "granularity": "month",
      "label": "数据月份"
    }
  ],
  "dataSources": {
    "offices": {
      "fields": {
        "office": {
          "type": "string",
          "role": "dimension",
          "queryField": "demo_office"
        },
        "amount": {
          "type": "number",
          "role": "measure",
          "queryField": "demo_amount"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "demo_office"
                ],
                "output_metrics": [
                  "demo_amount"
                ],
                "filter": {
                  "dims": [],
                  "metrics": []
                },
                "order": {}
              }
            ]
          },
          "filterBindings": {
            "region": {
              "target": "dimension",
              "levelQueryFields": {
                "region-dept": "demo_region",
                "office": "demo_office"
              }
            },
            "key-office": {
              "target": "boolean",
              "queryField": "demo_key_office",
              "whenTrue": [
                "true"
              ]
            }
          }
        }
      }
    }
  },
  "sections": [
    {
      "id": "page-header-section",
      "container": "plain",
      "components": [
        {
          "id": "page-header",
          "type": "iocHeader",
          "layout": {
            "span": 12
          },
          "props": {
            "identity": {
              "title": "重点国代下钻"
            },
            "filterIds": [
              "key-office",
              "mtime",
              "region"
            ]
          }
        }
      ]
    },
    {
      "id": "results",
      "components": [
        {
          "id": "office-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "offices"
          },
          "props": {
            "rowKey": "office",
            "columns": [
              {
                "title": "代表处",
                "field": {
                  "data": "main",
                  "field": "office"
                }
              },
              {
                "title": "金额",
                "field": {
                  "data": "main",
                  "field": "amount"
                }
              }
            ],
            "toolbar": {
              "export": {
                "format": "xlsx"
              }
            }
          }
        },
        {
          "id": "next-page",
          "type": "button",
          "layout": {
            "span": 12
          },
          "props": {
            "label": "切换页面",
            "action": {
              "navigate": {
                "href": "/pages/key-office-filter-demo"
              },
              "on": "click"
            }
          }
        }
      ]
    }
  ]
}
