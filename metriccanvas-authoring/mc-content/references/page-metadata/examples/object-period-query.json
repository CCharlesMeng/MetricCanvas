              }
            ],
            "pagination": {
              "mode": "none"
            }
          }
        },
        {
          "id": "custom-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "custom"
          },
          "props": {
            "title": "自定义审批日期",
            "columns": [
              {
                "field": "request",
                "title": "实际 DQE filter.fields"
              }
            ],
            "pagination": {
              "mode": "none"
            }
          }
        },
        {
          "id": "manual-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "manual"
          },
          "props": {
            "title": "手写对象条件",
            "columns": [
              {
                "field": "request",
                "title": "实际 DQE filter.fields"
              }
            ],
            "pagination": {
              "mode": "none"
            }
          }
        }
      ]
    }
  ]
}
