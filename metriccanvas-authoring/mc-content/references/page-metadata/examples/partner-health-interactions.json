  "sections": [
    {
      "id": "main",
      "components": [
        {
          "id": "regional-chart",
          "type": "barChart",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "scores"
          },
          "props": {
            "categoryField": {
              "data": "main",
              "field": "region"
            },
            "series": [
              {
                "field": {
                  "data": "main",
                  "field": "perception-score"
                },
                "role": "actual",
                "label": "伙伴对华为的感知"
              },
              {
                "field": {
                  "data": "main",
                  "field": "satisfaction-score"
                },
                "role": "actual",
                "label": "客户对伙伴的满意度"
              },
              {
                "field": {
                  "data": "main",
                  "field": "contribution-score"
                },
                "role": "actual",
                "label": "伙伴能力与贡献"
              },
              {
                "field": {
                  "data": "main",
                  "field": "risk-score"
                },
                "role": "actual",
                "label": "风险管控"
              }
            ],
            "stacked": true,
            "showStackTotalLabels": true,
            "actions": [
              {
                "on": "click",
                "openDetail": {
                  "surface": "drawer",
                  "title": "计算总分明细",
                  "fields": [
                    {
                      "label": "区域",
                      "field": "region"
                    },
                    {
                      "label": "总分",
                      "field": "total-score"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "region-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "scores"
          },
          "props": {
            "rowKey": "region",
            "columns": [
              {
                "field": "region",
                "title": "区域",
                "width": 120
              },
              {
                "field": {
                  "data": "main",
                  "field": "total-score",
                  "format": "number-1",
                  "missingText": "--"
                },
                "title": "伙伴健康度得分",
                "width": 150,
                "sortable": true
              },
              {
                "field": {
                  "data": "main",
                  "field": "perception-feedback",
                  "format": "number-1",
                  "missingText": "--"
                },
                "title": "伙伴声音闭环率(5%)",
                "width": 180,
                "sortable": true,
                "link": true,
                "openDetail": {
                  "surface": "modal",
                  "title": {
                    "parts": [
                      {
                        "field": "region"
                      },
                      " · 伙伴声音闭环率(5%) · 当前值 ",
                      {
                        "field": "perception-feedback",
                        "format": "number-1"
                      },
                      " · 明细"
                    ]
                  },
                  "view": "details"
                }
              }
            ],
            "pagination": {
              "mode": "local",
              "pageSize": 10
            }
          }
        }
      ]
    }
  ],
  "detailViews": [
    {
      "id": "details",
      "mode": "snapshot",
      "components": [
        {
          "id": "detail-table",
          "type": "table",
          "layout": {
            "span": 12
          },
          "data": {
            "main": "scores"
          },
          "props": {
            "columns": [
              {
                "field": "region",
                "title": "区域"
              },
              {
                "field": "total-score",
                "title": "计算总分"
              }
            ]
          }
        }
      ]
    }
