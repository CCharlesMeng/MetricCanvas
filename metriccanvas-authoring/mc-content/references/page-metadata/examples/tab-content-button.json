  "sections": [
    {
      "id": "body",
      "components": [
        {
          "id": "analysis",
          "type": "tabContainer",
          "layout": {
            "span": 12
          },
          "props": {
            "title": "经营分析",
            "contentLayout": "grid",
            "defaultTab": "overview",
            "tabs": [
              {
                "id": "overview",
                "label": "概览",
                "components": [
                  {
                    "id": "extra-button",
                    "type": "button",
                    "layout": {
                      "span": 12
                    },
                    "props": {
                      "label": "打开演示",
                      "action": {
                        "on": "click",
                        "navigate": {
                          "href": "/pages/demo"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "id": "details",
                "label": "明细",
                "components": [
                  {
                    "id": "revenue-filter",
                    "type": "filterGroup",
                    "layout": {
                      "span": 12
                    },
                    "props": {
                      "filterId": "revenue-region",
                      "options": [
                        {
                          "label": "中国区",
                          "value": "CN"
                        },
                        {
                          "label": "海外",
                          "value": "OVERSEAS"
                        }
                      ]
                    }
                  },
                  {
                    "id": "revenue",
                    "type": "lineChart",
                    "layout": {
                      "span": 12
                    },
                    "data": {
                      "main": "revenue-data"
                    },
                    "props": {
                      "title": "收入趋势",
                      "xField": "category",
                      "series": [
                        {
                          "field": "value",
                          "label": "收入趋势"
                        }
                      ]
                    }
                  },
                  {
                    "id": "detail-table",
                    "type": "table",
                    "layout": {
                      "span": 12
                    },
                    "data": {
                      "main": "entries"
                    },
                    "props": {
                      "title": "客户明细",
                      "columns": [
                        {
                          "field": "name"
                        },
                        {
                          "field": "amount"
                        }
                      ],
                      "pagination": {
                        "mode": "local",
                        "pageSize": 5
                      },
                      "toolbar": {
                        "search": {
                          "placeholder": "搜索客户",
                          "fields": [
                            "name"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "id": "summary",
                    "type": "text",
                    "layout": {
                      "span": 12
                    },
                    "props": {
                      "body": "普通区域说明；AI 总结仅用于 Report。"
                    }
                  }
                ]
              }
            ]
          }
        }
