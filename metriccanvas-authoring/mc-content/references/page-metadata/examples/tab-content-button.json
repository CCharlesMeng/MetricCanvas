{
  "schemaVersion": "6.73",
  "id": "tab-content-button",
  "meta": {
    "title": "Tab 混合内容（合成演示）"
  },
  "layout": "dashboard",
  "filters": [
    {
      "id": "domestic",
      "type": "boolean",
      "label": "仅国内",
      "default": false
    },
    {
      "id": "orders-region",
      "type": "dimension",
      "dimension": "chart_demo_region",
      "label": "订单对比区域",
      "default": [
        "CN"
      ]
    },
    {
      "id": "revenue-region",
      "type": "dimension",
      "dimension": "chart_demo_region",
      "label": "收入趋势区域",
      "default": [
        "OVERSEAS"
      ]
    }
  ],
  "dataSources": {
    "orders-data": {
      "fields": {
        "category": {
          "type": "string",
          "role": "dimension",
          "queryField": "chart_demo_category"
        },
        "value": {
          "type": "number",
          "role": "measure",
          "queryField": "chart_demo_orders"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "filterBindings": {
            "orders-region": {
              "target": "dimension",
              "queryField": "chart_demo_region"
            },
            "domestic": {
              "target": "boolean",
              "queryField": "chart_demo_region",
              "whenTrue": [
                "CN"
              ]
            }
          },
          "body": {
            "dsl_list": [
              {
                "output_dims": [
                  "chart_demo_category"
                ],
                "output_metrics": [
                  "chart_demo_orders"
                ],
                "filter": {
                  "dims": [],
                  "metrics": []
                },
                "order": {}
              }
            ]
          }
        }
      }
    },
    "revenue-data": {
      "fields": {
        "category": {
          "type": "string",
          "role": "dimension",
          "queryField": "chart_demo_category"
        },
        "value": {
          "type": "number",
          "role": "measure",
          "queryField": "chart_demo_revenue"
        }
      },
      "source": {
        "type": "query",
        "query": {
          "language": "dqe",
          "filterBindings": {
            "revenue-region": {
              "target": "dimension",
              "queryField": "chart_demo_region"
            },
            "domestic": {
              "target": "boolean",
