{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metriccanvas.local/contracts/source-description/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "providerNamespace",
    "descriptorRef",
    "descriptorVersion",
    "querySha256",
    "dataContextVersion",
    "fields",
    "rules",
    "unresolved"
  ],
  "properties": {
    "formatVersion": {
      "const": "1.0"
    },
    "providerNamespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "descriptorRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "descriptorVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dataContextVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "querySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semanticName",
          "logicalId",
          "projectionId",
          "queryField",
          "type",
          "role",
          "nullable",
          "scale"
        ],
        "properties": {
          "semanticName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "logicalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "projectionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "queryField": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "type": {
            "enum": [
              "string",
              "number",
              "money",
              "boolean",
              "date",
              "datetime"
            ]
          },
          "role": {
            "enum": [
              "dimension",
              "measure"
            ]
          },
          "nullable": {
            "type": "boolean"
          },
          "currency": {
            "const": "CNY"
          },
          "defaultFormat": {
            "type": "string"
          },
          "scale": {
            "enum": [
              "none",
              "fraction",
              "percent",
              "currency-base",
              "currency-wan",
              "unknown"
            ]
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
