{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metriccanvas.dev/authoring/lifecycle-request.schema.json",
  "title": "Trusted lifecycle program request; never model-authored",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "context",
        "base",
        "pageId",
        "document",
        "description",
        "retainDimensionValues"
      ],
      "properties": {
        "kind": {
          "const": "save"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actorId",
            "workspaceId",
            "operationId",
            "origin"
          ],
          "properties": {
            "actorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "workspaceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "origin": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "manual"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "skillVersion"
                  ],
                  "properties": {
                    "kind": {
                      "const": "relay"
                    },
                    "skillVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "sessionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "runId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                }
              ]
            }
          }
        },
        "base": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pageId",
                "revisionId",
                "resourceId"
              ],
              "properties": {
                "pageId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "revisionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "resourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "pageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "document": {
          "type": "object"
        },
        "description": {
          "type": "string"
        },
        "retainDimensionValues": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "const": "read"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pageId",
            "revisionId",
            "resourceId"
          ],
          "properties": {
            "pageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "revisionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "resourceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pageId",
        "cursor",
        "snapshot",
        "limit"
      ],
      "properties": {
        "kind": {
          "const": "history"
        },
        "pageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pageId",
                "revisionId",
                "resourceId"
              ],
              "properties": {
                "pageId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "revisionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "resourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  ]
}
