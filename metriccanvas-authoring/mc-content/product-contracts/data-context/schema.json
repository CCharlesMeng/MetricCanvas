{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metriccanvas.local/schema/schema-metadata-1.1.json",
  "title": "MetricCanvas 数据上下文 Schema 元数据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "version",
    "generatedAt",
    "source",
    "executionEnvironments"
  ],
  "properties": {
    "formatVersion": { "const": "1.1" },
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "version": { "$ref": "#/$defs/nonEmptyString" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/nonEmptyString" },
    "executionEnvironments": {
      "type": "array",
      "items": { "$ref": "#/$defs/executionEnvironment" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "fieldType": {
      "enum": ["string", "number", "boolean", "date", "datetime"]
    },
    "role": { "enum": ["dimension", "measure"] },
    "executionEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "language",
        "endpointRef",
        "schemas",
        "constraints",
        "security"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "language": { "const": "dqe" },
        "endpointRef": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "schemas": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataSchema" }
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "security": { "$ref": "#/$defs/security" }
      }
    },
    "dataSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "metrics",
        "objects",
        "relationships",
        "verifiedQueries"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/metricEntry" }
        },
        "objects": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataObject" }
        },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship" }
        },
        "verifiedQueries": {
          "type": "array",
          "items": { "$ref": "#/$defs/verifiedQuery" }
        }
      }
    },
    "metricEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "description",
        "additivity",
        "timeAggregation",
        "isRatio",
        "dimensions",
        "nullable",
        "sensitive"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "$ref": "#/$defs/fieldType" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "additivity": { "enum": ["可加", "半可加", "不可加"] },
        "timeAggregation": { "enum": ["求和", "均值", "期末值"] },
        "isRatio": { "type": "boolean" },
        "dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "nullable": { "type": "boolean" },
        "sensitive": { "type": "boolean" }
      }
    },
    "dataObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "description", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "dataset" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataField" }
        }
      }
    },
    "dataField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "description",
        "roleHints",
        "nullable",
        "sensitive"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "$ref": "#/$defs/fieldType" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "roleHints": {
          "type": "array",
          "items": { "enum": ["dimension", "time"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "granularity": { "$ref": "#/$defs/nonEmptyString" },
        "nullable": { "type": "boolean" },
        "sensitive": { "type": "boolean" }
      }
    },
    "relationshipEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object", "field"],
      "properties": {
        "object": { "$ref": "#/$defs/nonEmptyString" },
        "field": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "cardinality", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "from": { "$ref": "#/$defs/relationshipEnd" },
        "to": { "$ref": "#/$defs/relationshipEnd" },
        "cardinality": {
          "enum": ["one-to-one", "one-to-many", "many-to-one"]
        },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "verifiedQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "description",
        "language",
        "body",
        "resultFields"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "question": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "language": { "const": "dqe" },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dsl_list"],
          "properties": {
            "dsl_list": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "type": "object" }
            }
          }
        },
        "resultFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/resultField" }
        }
      }
    },
    "resultField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "role", "nullable"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "$ref": "#/$defs/fieldType" },
        "role": { "$ref": "#/$defs/role" },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "nullable": { "type": "boolean" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnly",
        "maxRows",
        "maxColumns",
        "maxQueriesPerBatch",
        "timeoutMs"
      ],
      "properties": {
        "readOnly": { "const": true },
        "maxRows": { "type": "integer", "minimum": 1 },
        "maxColumns": { "type": "integer", "minimum": 1 },
        "maxQueriesPerBatch": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": { "$ref": "#/$defs/nonEmptyString" },
        "notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
