                },
                {
                  "id": "region-control",
                  "type": "regionFilter",
                  "props": {
                    "officeNavigate": {
                      "href": "/pages/ioc-office-drill-detail",
                      "query": {
                        "period": {
                          "source": "filter",
                          "id": "stat-period",
                          "part": "value"
                        },
                        "period-from": {
                          "source": "filter",
                          "id": "stat-period",
                          "part": "from"
                        },
                        "period-to": {
                          "source": "filter",
                          "id": "stat-period",
                          "part": "to"
                        },
                        "rep-office": {
                          "source": "filter",
                          "id": "region"
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          {
            "id": "results",
            "type": "table",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "scope"
            },
            "props": {
              "columns": [
                {
                  "field": "region",
                  "title": "生效组织"
                },
                {
                  "field": "amount",
                  "title": "合成金额"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "expected": [
    {
      "type": "SCHEMA_ERROR",
      "path": "/sections/0/components/0/props/components/1/props/officeNavigate/query/rep-office",
