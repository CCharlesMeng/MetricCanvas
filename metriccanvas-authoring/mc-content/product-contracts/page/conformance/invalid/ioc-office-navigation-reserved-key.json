          },
          "amount": {
            "type": "number",
            "role": "measure",
            "label": "合成金额",
            "queryField": "金额"
          }
        },
        "source": {
          "type": "query",
          "query": {
            "language": "dqe",
            "body": {
              "dsl_list": [
                {
                  "output_dims": [
                    "地区部"
                  ],
                  "output_metrics": [
                    "金额"
                  ],
                  "filter": {
                    "time": {
                      "period": "month",
                      "is_aggregate": true
                    },
                    "dims": [],
                    "metrics": []
                  }
                }
              ]
            },
            "filterBindings": {
              "region": {
                "target": "dimension",
                "levelQueryFields": {
                  "geo": "地理区",
                  "region-dept": "地区部",
                  "office": "代表处"
                }
              },
              "stat-period": {
                "target": "time"
              }
            }
          }
        }
      }
    },
    "sections": [
      {
        "id": "main",
        "components": [
          {
            "id": "header",
            "type": "iocHeader",
            "layout": {
              "span": 12
            },
            "props": {
              "identity": {
                "title": "代表处下钻概览"
              },
              "presentation": {
                "layout": "inline",
                "density": "normal",
                "collapse": "none"
              },
              "components": [
                {
                  "id": "year-control",
                  "type": "filterControl",
                  "props": {
                    "filterId": "stat-period"
