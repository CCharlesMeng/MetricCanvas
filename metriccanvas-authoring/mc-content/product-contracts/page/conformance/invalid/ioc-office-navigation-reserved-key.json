{
  "case": "ioc-office-navigation-reserved-key",
  "invariant": "ioc-region-office-navigation",
  "input": {
    "schemaVersion": "6.121",
    "id": "ioc-office-drill-overview",
    "layout": "dashboard",
    "meta": {
      "title": "代表处下钻概览 · 合成演示"
    },
    "filters": [
      {
        "id": "stat-period",
        "type": "timeRange",
        "display": "period",
        "periodModes": [
          "year",
          "quarter",
          "month",
          "last12Months"
        ],
        "precision": "month",
        "default": {
          "mode": "quarter",
          "value": "2026-Q3"
        },
        "label": "统计期间",
        "urlParams": {
          "value": "period",
          "from": "period-from",
          "to": "period-to"
        }
      }
    ],
    "dataSources": {
      "scope": {
        "fields": {
          "region": {
            "type": "string",
            "role": "dimension",
            "label": "生效组织",
