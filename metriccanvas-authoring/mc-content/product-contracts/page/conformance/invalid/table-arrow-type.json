          },
          "off": {
            "type": "number",
            "role": "measure",
            "nullable": true
          },
          "legacy": {
            "type": "number",
            "role": "measure",
            "nullable": true
          },
          "enum": {
            "type": "number",
            "role": "measure",
            "nullable": true
          }
        },
        "source": {
          "type": "inline",
          "rows": [
            {
              "label": "正值",
              "growth": 2.5,
              "cost": 2.5,
              "rate": 2.5,
              "tiny": 2.5,
              "off": 2.5,
              "legacy": 2.5,
              "enum": 2.5
            },
            {
