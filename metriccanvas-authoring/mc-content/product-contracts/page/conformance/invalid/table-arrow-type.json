    "sections": [
      {
        "id": "main",
        "title": "正负、零、缺失与精度",
        "components": [
          {
            "id": "trend-table",
            "type": "table",
            "layout": {
              "span": 12
            },
            "data": {
              "main": "sample"
            },
            "props": {
              "columns": [
                {
                  "field": "label",
                  "title": "情况"
                },
                {
                  "kind": "group",
                  "id": "changes",
                  "title": "颜色与方向独立",
                  "children": [
                    {
                      "field": {
                        "data": "main",
                        "field": "growth",
                        "format": "number-1-signed"
                      },
                      "title": "收入变化 · 默认前置",
                      "unit": "万元",
                      "colorRule": {
                        "mode": "sign",
                        "positive": "green",
                        "negative": "red"
                      },
                      "arrowRule": "yes"
                    },
                    {
                      "field": {
                        "data": "main",
                        "field": "cost",
                        "format": "number-1-signed"
                      },
                      "title": "耗时变化 · 反向后置",
                      "unit": "天",
                      "colorRule": {
                        "mode": "sign",
                        "positive": "red",
                        "negative": "green"
                      },
                      "arrowRule": {
                        "mode": "sign",
                        "positive": "down",
                        "negative": "up",
                        "position": "after"
                      }
                    }
                  ]
                },
                {
                  "field": {
                    "data": "main",
                    "field": "rate",
                    "format": "percent-2-signed"
                  },
                  "title": "固定下箭头 · 后置",
                  "colorRule": {
                    "mode": "fixed",
                    "color": "green"
                  },
                  "arrowRule": {
                    "mode": "fixed",
                    "arrow": "down",
                    "position": "after"
                  }
                },
                {
                  "field": "tiny",
                  "title": "仅负值箭头 · 显式前置",
                  "unit": "天",
                  "arrowRule": {
                    "mode": "sign",
                    "positive": "none",
                    "negative": "down",
                    "position": "before"
                  }
                },
                {
                  "field": {
                    "data": "main",
                    "field": "off",
                    "format": "number-1-signed"
                  },
                  "title": "规则显式隐藏",
                  "unit": "天",
                  "arrowRule": {
                    "mode": "fixed",
                    "arrow": "none"
                  }
                },
                {
                  "field": {
                    "data": "main",
                    "field": "legacy",
                    "format": "number-1-signed"
                  },
                  "title": "未声明 · 兼容旧页",
                  "unit": "天"
                },
                {
                  "field": "enum",
                  "title": "枚举标签不加箭头",
                  "enumValues": [
                    {
                      "value": 2.5,
                      "label": "已达标"
                    }
                  ],
                  "arrowRule": {
                    "mode": "sign",
                    "positive": "up",
                    "negative": "down"
                  }
                }
              ],
              "toolbar": {
                "export": {
                  "format": "xlsx",
                  "filename": "表格箭头"
                }
              }
            }
          }
        ]
      },
