            "type": "string",
            "role": "dimension",
            "label": "客户"
          },
          "project": {
            "type": "string",
            "role": "dimension",
            "label": "项目"
          },
          "owner": {
            "type": "string",
            "role": "dimension",
            "label": "负责人"
          },
          "amount": {
            "type": "number",
            "role": "measure",
            "label": "金额"
          }
        },
        "source": {
          "type": "inline",
          "rows": [
            {
              "id": "a",
