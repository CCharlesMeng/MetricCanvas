{
  "bundleVersion": "0.3.1",
  "mcContent": {
    "directory": "mc-content",
    "manifest": "mc-content.version.json",
    "interfaceVersion": "1.0"
  },
  "status": "local-deployment-readiness-verified-internal-not-run",
  "skill": {
    "entrypoint": "skill/metriccanvas-page-builder/SKILL.md"
  },
  "tool": {
    "runtime": "python",
    "python": ">=3.12",
    "transport": "stdio",
    "entrypoint": "tool/server.py",
    "requirements": "tool/requirements.lock",
    "pageValidation": {
      "node": ">=22",
      "entrypoint": "scripts/page-validation-bridge.mjs",
      "timeoutSeconds": 20
    }
  },
  "contracts": {
    "authoring": "contracts/manifest.json",
    "productLock": "contract-lock.json"
  },
  "skills": [
    {
      "id": "metriccanvas-page-builder",
      "entrypoint": "skill/metriccanvas-page-builder/SKILL.md",
      "referenceProjection": "page-metadata"
    },
    {
      "id": "metriccanvas-platform-authoring",
      "entrypoint": "skill/metriccanvas-platform-authoring/SKILL.md",
      "referenceMode": "injected-or-file-read",
      "referenceProjection": "none",
      "mcpServer": "metriccanvas-platform-content"
    },
    {
      "id": "metriccanvas-local-authoring",
      "entrypoint": "skill/metriccanvas-local-authoring/SKILL.md",
      "referenceProjection": "local-page-metadata"
    }
  ],
  "toolServices": {
    "metriccanvas-platform-content": {
      "command": "metriccanvas-platform-content",
      "module": "metriccanvas_authoring.platform_server",
      "contextContract": "authoring-turn/1.0",
      "platformProtocolVersion": "2.0"
    }
  }
}
